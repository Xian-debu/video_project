{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-project.local/schema/catalog.schema.json",
  "title": "catalog.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "singles",
    "series"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "singles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "series": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    }
  }
}
