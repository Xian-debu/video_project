  {
   "scene": "problem",
   "index": 38,
   "start": 297.52,
   "dur": 2.37,
   "speech": "差了一倍半还多。"
  },
  {
   "scene": "problem",
   "index": 39,
   "start": 300.07,
   "dur": 4.62,
   "speech": "同一段漂移，重构误差 F1 零点六一九九。"
  },
  {
   "scene": "definitions",
   "index": 0,
   "start": 308.09,
   "dur": 3.01,
   "speech": "先把三件东西定义清楚。"
  },
  {
   "scene": "definitions",
   "index": 1,
   "start": 311.28,
   "dur": 2.15,
   "speech": "第一件是残差。"
  },
  {
   "scene": "definitions",
   "index": 2,
   "start": 313.61,
   "dur": 4.12,
   "speech": "残差等于实际值减预测值，取绝对值。"
  },
  {
   "scene": "definitions",
   "index": 3,
   "start": 317.91,
   "dur": 3.54,
   "speech": "预测器是三十三个系数的岭回归。"
  },
  {
   "scene": "definitions",
   "index": 4,
   "start": 321.63,
   "dur": 3.33,
   "speech": "三十二个历史点，加一个截距。"
  },
  {
   "scene": "definitions",
   "index": 5,
   "start": 325.14,
   "dur": 2.25,
   "speech": "第二件是阈值。"
  },
  {
   "scene": "definitions",
   "index": 6,
   "start": 327.57,
   "dur": 4.21,
   "speech": "在标定段上取残差的百分之九十九分位。"
  },
  {
   "scene": "definitions",
   "index": 7,
   "start": 331.96,
   "dur": 4.93,
   "speech": "标定段是二零一八到二零一九，四百八十七个窗口。"
  },
  {
   "scene": "definitions",
   "index": 8,
   "start": 337.07,
   "dur": 5.01,
   "speech": "分位数用第一类经验分位：排序后取第 ceil(qn) 个。"
  },
  {
   "scene": "definitions",
   "index": 9,
   "start": 342.26,
   "dur": 3.37,
   "speech": "阈值定在三点四四六七三三。"
  },
  {
   "scene": "definitions",
   "index": 10,
   "start": 345.81,
   "dur": 2.27,
   "speech": "第三件是窗口。"
  },
  {
   "scene": "definitions",
   "index": 11,
   "start": 348.26,
   "dur": 3.78,
   "speech": "三十二个点，只看过去，不看未来。"
  },
  {
   "scene": "definitions",
   "index": 12,
   "start": 352.23,
   "dur": 4.84,
   "speech": "窗口右端对齐当前点，左端往前数三十二天。"
  },
  {
   "scene": "definitions",
   "index": 13,
   "start": 357.24,
   "dur": 3.35,
   "speech": "这样每一帧的判定都能实时做。"
  },
  {
   "scene": "definitions",
   "index": 14,
   "start": 360.77,
   "dur": 4.53,
   "speech": "窗口在拟合段上滑动，得到七百三十二个样本。"
  },
  {
   "scene": "definitions",
   "index": 15,
   "start": 365.48,
   "dur": 3.93,
   "speech": "在标定段上滑动，得到四百八十七个。"
  },
  {
   "scene": "definitions",
   "index": 16,
   "start": 369.59,
   "dur": 4.05,
   "speech": "在测试段上滑动，得到七百二十八个。"
  },
  {
   "scene": "definitions",
   "index": 17,
   "start": 373.81,
   "dur": 4.53,
   "speech": "三个数字加起来，就是全部训练与评估样本。"
  },
  {
   "scene": "definitions",
   "index": 18,
   "start": 378.52,
   "dur": 3.35,
   "speech": "没有重叠采样，没有打乱顺序。"
  },
  {
   "scene": "definitions",
   "index": 19,
   "start": 382.05,
   "dur": 3.01,
   "speech": "这是时序任务的最低要求。"
  },
  {
   "scene": "definitions",
   "index": 20,
   "start": 385.24,
   "dur": 3.52,
   "speech": "重构侧是一个很小的自编码器。"
  },
  {
   "scene": "definitions",
   "index": 21,
   "start": 388.94,
   "dur": 4.38,
   "speech": "输入三十二维，隐层八维，输出三十二维。"
  },
  {
   "scene": "definitions",
   "index": 22,
   "start": 393.5,
   "dur": 3.83,
   "speech": "参数分两层：三十二乘八，加八。"
  },
  {
   "scene": "definitions",
   "index": 23,
   "start": 397.51,
   "dur": 3.21,
   "speech": "再八乘三十二，加三十二。"
  },
  {
   "scene": "definitions",
   "index": 24,
   "start": 400.9,
   "dur": 2.63,
   "speech": "一共五百五十二个参数。"
  },
  {
   "scene": "definitions",
   "index": 25,
