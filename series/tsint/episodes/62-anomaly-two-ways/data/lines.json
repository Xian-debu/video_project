   "scene": "definitions",
   "index": 27,
   "start": 410.89,
   "dur": 3.4,
   "speech": "训练两百轮，学习率零点零二。"
  },
  {
   "scene": "definitions",
   "index": 28,
   "start": 414.47,
   "dur": 5.92,
   "speech": "第一次损失零点九三一八九零，最后一次零点六五零四四三。"
  },
  {
   "scene": "definitions",
   "index": 29,
   "start": 420.56,
   "dur": 3.57,
   "speech": "参数少，是为了让它只学形状。"
  },
  {
   "scene": "definitions",
   "index": 30,
   "start": 424.31,
   "dur": 2.34,
   "speech": "评价用 F1。"
  },
  {
   "scene": "definitions",
   "index": 31,
   "start": 426.83,
   "dur": 3.01,
   "speech": "先把判定摊成四个格子。"
  },
  {
   "scene": "definitions",
   "index": 32,
   "start": 430.03,
   "dur": 2.68,
   "speech": "真阳：该报警也报了。"
  },
  {
   "scene": "definitions",
   "index": 33,
   "start": 432.88,
   "dur": 2.65,
   "speech": "假阳：不该报却报了。"
  },
  {
   "scene": "definitions",
   "index": 34,
   "start": 435.72,
   "dur": 2.41,
   "speech": "假阴：该报没报。"
  },
  {
   "scene": "definitions",
   "index": 35,
   "start": 438.31,
   "dur": 2.58,
   "speech": "真阴：不该报也没报。"
  },
  {
   "scene": "definitions",
   "index": 36,
   "start": 441.07,
   "dur": 4.12,
   "speech": "精确率等于真阳除以真阳加假阳。"
  },
  {
   "scene": "definitions",
   "index": 37,
   "start": 445.37,
   "dur": 4,
   "speech": "召回率等于真阳除以真阳加假阴。"
  },
  {
   "scene": "definitions",
   "index": 38,
   "start": 449.55,
   "dur": 3.28,
   "speech": "F1 是这两个数的调和平均。"
  },
  {
   "scene": "definitions",
   "index": 39,
   "start": 453.01,
   "dur": 3.85,
   "speech": "分母为零时记零，这是检查里的一条。"
  },
  {
   "scene": "metrics",
   "index": 0,
   "start": 460.26,
   "dur": 3.49,
   "speech": "数据是 000001 的日收益。"
  },
  {
   "scene": "metrics",
   "index": 1,
   "start": 463.93,
   "dur": 3.81,
   "speech": "百分比对数收益，六千五百九十九行。"
  },
  {
   "scene": "metrics",
   "index": 2,
   "start": 467.92,
   "dur": 4.05,
   "speech": "从一九九八年十一月到二零二六年十月。"
  },
  {
   "scene": "metrics",
   "index": 3,
   "start": 472.15,
   "dur": 4.5,
   "speech": "训练段二零一五到二零一九，一千二百一十九行。"
  },
  {
   "scene": "metrics",
   "index": 4,
   "start": 476.83,
   "dur": 4.36,
   "speech": "测试段二零二零到二零二二，七百二十八行。"
  },
  {
   "scene": "metrics",
   "index": 5,
   "start": 481.37,
   "dur": 3.85,
   "speech": "标准化只用训练段的均值和标准差。"
  },
  {
   "scene": "metrics",
   "index": 6,
   "start": 485.4,
   "dur": 5.44,
   "speech": "均值零点零三八三三一，标准差二点零三八一六六。"
  },
  {
   "scene": "metrics",
   "index": 7,
   "start": 491.02,
   "dur": 3.83,
   "speech": "测试段的数一律用这组参数换算。"
  },
  {
   "scene": "metrics",
   "index": 8,
   "start": 495.03,
   "dur": 4.38,
   "speech": "这一点很重要：不能用测试段自己的统计量。"
  },
  {
   "scene": "metrics",
   "index": 9,
   "start": 499.59,
   "dur": 3.49,
   "speech": "否则异常会被标准化悄悄抹平。"
  },
  {
   "scene": "metrics",
   "index": 10,
   "start": 503.26,
   "dur": 3.04,
   "speech": "窗口把行数变成样本数。"
  },
  {
   "scene": "metrics",
   "index": 11,
   "start": 506.48,
   "dur": 4.55,
   "speech": "拟合段二零一五到二零一七，七百三十二个窗口。"
  },
  {
   "scene": "metrics",
   "index": 12,
   "start": 511.21,
   "dur": 4.38,
   "speech": "标定段二零一八到二零一九，四百八十七个。"
  },
  {
   "scene": "metrics",
   "index": 13,
   "start": 515.77,
   "dur": 4.48,
   "speech": "测试段二零二零到二零二二，七百二十八个点。"
  },
  {
   "scene": "metrics",
   "index": 14,
   "start": 520.43,
   "dur": 4.43,
   "speech": "拟合、标定、测试，三段互不重叠。"
  },
  {
   "scene": "metrics",
   "index": 15,
   "start": 525.04,
   "dur": 2.77,
   "speech": "阈值只在标定段上定。"
  },
  {
   "scene": "metrics",
   "index": 16,
   "start": 528,
   "dur": 3.93,
   "speech": "测试段一次都不参与训练和定阈值。"
  },
  {
   "scene": "metrics",
   "index": 17,
   "start": 532.1,
   "dur": 3.54,
   "speech": "这是防止信息泄漏的最低要求。"
  },
  {
   "scene": "metrics",
   "index": 18,
   "start": 535.82,
   "dur": 4.26,
   "speech": "七百三十二加四百八十七加七百二十八。"
  },
  {
   "scene": "metrics",
   "index": 19,
   "start": 540.27,
   "dur": 3.37,
   "speech": "后面所有读数都从这三段来。"
  },
  {
   "scene": "metrics",
   "index": 20,
   "start": 543.82,
   "dur": 2.53,
   "speech": "两边各有一个阈值。"
  },
  {
   "scene": "metrics",
   "index": 21,
   "start": 546.53,
   "dur": 4.17,
   "speech": "预测残差的阈值三点四四六七三三。"
  },
  {
   "scene": "metrics",
   "index": 22,
   "start": 550.88,
   "dur": 4.07,
   "speech": "重构误差的阈值一点六二四四六一。"
  },
  {
   "scene": "metrics",
   "index": 23,
   "start": 555.13,
   "dur": 3.81,
   "speech": "都取标定段残差的百分之九十九分位。"
  },
  {
   "scene": "metrics",
   "index": 24,
   "start": 559.12,
   "dur": 2.73,
   "speech": "为什么是百分之九十九。"
  },
  {
   "scene": "metrics",
   "index": 25,
   "start": 562.02,
   "dur": 3.28,
   "speech": "因为要的是大约百分之一的误报。"
  },
  {
   "scene": "metrics",
   "index": 26,
   "start": 565.48,
   "dur": 4.17,
   "speech": "实测标定段报警率百分之零点八二一四。"
  },
  {
   "scene": "metrics",
   "index": 27,
   "start": 569.83,
   "dur": 4.45,
   "speech": "比百分之一还低一点，因为分位数是经验值。"
  },
  {
   "scene": "metrics",
   "index": 28,
   "start": 574.46,
   "dur": 4.29,
   "speech": "阈值不是调参调出来的，是分位数算出来的。"
  },
  {
   "scene": "metrics",
   "index": 29,
   "start": 578.93,
   "dur": 3.69,
   "speech": "换数据就要重新标定，这是纪律。"
  },
  {
   "scene": "metrics",
   "index": 30,
   "start": 582.79,
   "dur": 3.21,
   "speech": "百分之九十九不是唯一选择。"
  },
  {
   "scene": "metrics",
   "index": 31,
   "start": 586.18,
   "dur": 5.2,
   "speech": "换成百分之九十，尖峰预测 F1 掉到零点一八九。"
  },
  {
   "scene": "metrics",
   "index": 32,
   "start": 591.56,
   "dur": 4.48,
   "speech": "换成百分之九十九点九，升到零点八五七一。"
  },
