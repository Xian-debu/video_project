 "lines": [
  {
   "scene": "open",
   "index": 0,
   "start": 1.2,
   "dur": 2.73,
   "speech": "这一集先画一张图。"
  },
  {
   "scene": "open",
   "index": 1,
   "start": 4.11,
   "dur": 3.73,
   "speech": "一百二十八个数字，画成一张方阵。"
  },
  {
   "scene": "open",
   "index": 2,
   "start": 8.02,
   "dur": 3.33,
   "speech": "横着是时间，竖着也是时间。"
  },
  {
   "scene": "open",
   "index": 3,
   "start": 11.53,
   "dur": 3.25,
   "speech": "每个格子，是两个点的乘积。"
  },
  {
   "scene": "open",
   "index": 4,
   "start": 14.96,
   "dur": 2.97,
   "speech": "这种画法叫格拉姆角场。"
  },
  {
   "scene": "open",
   "index": 5,
   "start": 18.11,
   "dur": 3.4,
   "speech": "另一种画法叫马尔可夫转移场。"
  },
  {
   "scene": "open",
   "index": 6,
   "start": 21.68,
   "dur": 3.61,
   "speech": "它不画点与点，画状态与状态。"
  },
  {
   "scene": "open",
   "index": 7,
   "start": 25.48,
   "dur": 3.3,
   "speech": "两种画法，都被叫作图像化。"
  },
  {
   "scene": "open",
   "index": 8,
   "start": 28.96,
   "dur": 3.85,
   "speech": "问题是：画成图，丢了多少信息。"
  },
  {
   "scene": "open",
   "index": 9,
   "start": 32.99,
   "dur": 2.41,
   "speech": "先给答案，再解释。"
  },
  {
   "scene": "open",
   "index": 10,
   "start": 35.59,
   "dur": 2.75,
   "speech": "格拉姆角场几乎没丢。"
  },
  {
   "scene": "open",
   "index": 11,
   "start": 38.52,
   "dur": 4.29,
   "speech": "从对角线加第一行，可以反解回原序列。"
  },
  {
   "scene": "open",
   "index": 12,
   "start": 42.98,
   "dur": 4.07,
   "speech": "反解误差是一点三乘十的负十四次方。"
  },
  {
   "scene": "open",
   "index": 13,
   "start": 47.23,
   "dur": 3.35,
   "speech": "唯一的不确定，是整体翻个面。"
  },
  {
   "scene": "open",
   "index": 14,
   "start": 50.76,
   "dur": 3.54,
   "speech": "马尔可夫转移场保的是另一件事。"
  },
  {
   "scene": "open",
   "index": 15,
   "start": 54.49,
   "dur": 2.53,
   "speech": "它保住了转移结构。"
  },
  {
   "scene": "open",
   "index": 16,
   "start": 57.2,
   "dur": 3.69,
   "speech": "八乘八的转移矩阵，每行和为一。"
  },
  {
   "scene": "open",
   "index": 17,
   "start": 61.07,
   "dur": 4.98,
   "speech": "但一百二十八乘一百二十八的图像，行和是十六。"
  },
  {
   "scene": "open",
   "index": 18,
   "start": 66.23,
   "dur": 2.32,
   "speech": "不是一，是十六。"
  },
  {
   "scene": "open",
   "index": 19,
   "start": 68.73,
   "dur": 2.73,
   "speech": "这是本集最重要的一句。"
  },
  {
   "scene": "open",
   "index": 20,
   "start": 71.63,
   "dur": 3.93,
   "speech": "还有第三件事：这样画图，值不值得。"
  },
  {
   "scene": "open",
   "index": 21,
   "start": 75.74,
   "dur": 3.69,
   "speech": "把图喂给卷积前端，预测下一天。"
  },
  {
   "scene": "open",
   "index": 22,
   "start": 79.6,
   "dur": 3.21,
   "speech": "测试误差是一点三九一三。"
  },
  {
   "scene": "open",
   "index": 23,
   "start": 82.99,
   "dur": 3.95,
   "speech": "只给三个尺度数字，是一点三九零八。"
  },
  {
   "scene": "open",
   "index": 24,
   "start": 87.12,
   "dur": 2.1,
   "speech": "图没有赢下来。"
  },
  {
   "scene": "open",
   "index": 25,
   "start": 89.4,
   "dur": 3.71,
   "speech": "差距在噪声里，偏向数字那一侧。"
  },
  {
   "scene": "open",
   "index": 26,
   "start": 93.29,
   "dur": 3.97,
   "speech": "两条都赢过朴素基线二点一五五二。"
  },
  {
   "scene": "open",
   "index": 27,
   "start": 97.45,
   "dur": 3.73,
   "speech": "但赢的理由是收缩，不是图的形状。"
  },
  {
   "scene": "open",
   "index": 28,
   "start": 101.36,
   "dur": 2.25,
   "speech": "这是一条负结果。"
  },
  {
   "scene": "open",
   "index": 29,
   "start": 103.79,
   "dur": 1.93,
   "speech": "我们照实讲。"
  },
  {
   "scene": "open",
   "index": 30,
   "start": 105.9,
   "dur": 2.25,
   "speech": "接下来分八场。"
  },
  {
   "scene": "open",
   "index": 31,
   "start": 108.33,
   "dur": 3.93,
   "speech": "第一场说问题：画成图到底丢了什么。"
  },
  {
   "scene": "open",
   "index": 32,
   "start": 112.43,
   "dur": 5.01,
   "speech": "第二场定义三件东西：缩放、极角、转移矩阵。"
  },
  {
   "scene": "open",
   "index": 33,
   "start": 117.62,
   "dur": 2.8,
   "speech": "第三场钉数据和口径。"
  },
  {
   "scene": "open",
   "index": 34,
   "start": 120.6,
   "dur": 4.07,
   "speech": "第四场量反解、量行和、量预测。"
  },
  {
   "scene": "open",
   "index": 35,
   "start": 124.85,
   "dur": 3.04,
   "speech": "第五场写实现：三个模块。"
  },
  {
   "scene": "open",
   "index": 36,
   "start": 128.06,
   "dur": 3.61,
   "speech": "第六场验证：十九项检查逐条过。"
  },
  {
   "scene": "open",
   "index": 37,
   "start": 131.86,
   "dur": 3.73,
   "speech": "第七场讲边界：什么条件下不成立。"
  },
  {
   "scene": "open",
   "index": 38,
   "start": 135.77,
   "dur": 3.23,
   "speech": "第八场收束，指向下一集。"
  },
  {
   "scene": "open",
   "index": 39,
   "start": 139.18,
   "dur": 3.69,
   "speech": "屏幕上的每个数都能一条命令跑出来。"
  },
  {
   "scene": "problem",
   "index": 0,
   "start": 146.27,
   "dur": 3.71,
   "speech": "为什么要把一维序列画成二维图。"
  },
  {
   "scene": "problem",
   "index": 1,
   "start": 150.16,
   "dur": 3.13,
   "speech": "一个现实理由：图像模型多。"
  },
  {
   "scene": "problem",
   "index": 2,
   "start": 153.47,
   "dur": 4.89,
   "speech": "卷积、池化、预训练权重，都在二维上成熟。"
  },
  {
   "scene": "problem",
   "index": 3,
   "start": 158.54,
   "dur": 3.69,
   "speech": "把序列变成图，就能借这些工具。"
  },
  {
   "scene": "problem",
   "index": 4,
   "start": 162.41,
   "dur": 2.75,
   "speech": "但借工具是有代价的。"
  },
  {
   "scene": "problem",
   "index": 5,
   "start": 165.34,
   "dur": 3.95,
   "speech": "代价可能是信息，也可能是归纳偏置。"
  },
  {
   "scene": "problem",
   "index": 6,
   "start": 169.47,
   "dur": 3.81,
   "speech": "常见说法是：两种编码都是双射。"
  },
  {
   "scene": "problem",
   "index": 7,
   "start": 173.45,
   "dur": 3.35,
   "speech": "也就是说，画成图不丢信息。"
  },
  {
   "scene": "problem",
   "index": 8,
   "start": 176.98,
   "dur": 2.46,
   "speech": "这句话只对了一半。"
  },
  {
   "scene": "problem",
   "index": 9,
   "start": 179.62,
   "dur": 2.32,
   "speech": "我们把它拆开看。"
  },
  {
   "scene": "problem",
   "index": 10,
   "start": 182.12,
   "dur": 3.01,
   "speech": "第一问：格拉姆角场丢了什么。"
  },
  {
   "scene": "problem",
   "index": 11,
   "start": 185.32,
   "dur": 3.01,
   "speech": "它把每个点压成一个角度。"
  },
  {
   "scene": "problem",
   "index": 12,
   "start": 188.51,
   "dur": 4.07,
   "speech": "角度只由这个点在窗口里的相对位置决定。"
  },
  {
   "scene": "problem",
   "index": 13,
   "start": 192.76,
   "dur": 2.92,
   "speech": "绝对水平被缩放吃掉了。"
  },
  {
   "scene": "problem",
   "index": 14,
   "start": 195.86,
   "dur": 3.52,
   "speech": "所以反解要先知道缩放区间。"
  },
  {
   "scene": "problem",
   "index": 15,
   "start": 199.56,
   "dur": 2.97,
   "speech": "反过来，符号也翻不回来。"
  },
  {
   "scene": "problem",
   "index": 16,
   "start": 202.7,
   "dur": 3.64,
   "speech": "序列整体乘负一，图一模一样。"
  },
  {
   "scene": "problem",
   "index": 17,
   "start": 206.52,
   "dur": 3.45,
   "speech": "这是唯一丢的东西：一个整体符号。"
  },
  {
   "scene": "problem",
   "index": 18,
   "start": 210.15,
   "dur": 3.13,
   "speech": "除它之外，逐位都能还原。"
  },
  {
   "scene": "problem",
   "index": 19,
   "start": 213.46,
   "dur": 3.47,
   "speech": "第二问：马尔可夫转移场丢了什么。"
  },
  {
   "scene": "problem",
   "index": 20,
   "start": 217.11,
   "dur": 2.97,
   "speech": "它先把每个点换成状态。"
  },
  {
   "scene": "problem",
   "index": 21,
   "start": 220.26,
   "dur": 2.8,
   "speech": "状态是分箱，八箱。"
  },
  {
   "scene": "problem",
   "index": 22,
   "start": 223.23,
   "dur": 3.9,
   "speech": "然后数相邻状态对，得到转移矩阵。"
  },
  {
   "scene": "problem",
   "index": 23,
   "start": 227.32,
   "dur": 3.93,
   "speech": "再把矩阵按状态序列铺回时间轴。"
  },
  {
   "scene": "problem",
   "index": 24,
   "start": 231.42,
   "dur": 4.69,
   "speech": "图像里每个格子，是从状态甲到状态乙的概率。"
  },
  {
   "scene": "problem",
   "index": 25,
   "start": 236.3,
   "dur": 2.94,
   "speech": "所以它保住了怎么转移。"
  },
  {
   "scene": "problem",
   "index": 26,
   "start": 239.42,
   "dur": 3.3,
   "speech": "但丢掉了每个点具体是多少。"
  },
  {
   "scene": "problem",
   "index": 27,
   "start": 242.9,
   "dur": 3.64,
   "speech": "同一张图像，可以来自很多条序列。"
  },
  {
   "scene": "problem",
   "index": 28,
   "start": 246.72,
   "dur": 2.56,
   "speech": "这一半，不叫双射。"
  },
  {
   "scene": "problem",
   "index": 29,
   "start": 249.46,
   "dur": 2.1,
   "speech": "叫结构保持。"
  },
  {
   "scene": "problem",
   "index": 30,
   "start": 251.74,
   "dur": 2.97,
   "speech": "两问合起来，本集的立场是："
  },
  {
   "scene": "problem",
   "index": 31,
   "start": 254.88,
   "dur": 3.76,
   "speech": "一维到二维，可以无损，也可以有损。"
  },
  {
   "scene": "problem",
   "index": 32,
   "start": 258.82,
   "dur": 3.97,
   "speech": "无损的是格拉姆角场，差一个整体反射。"
  },
  {
   "scene": "problem",
   "index": 33,
   "start": 262.98,
   "dur": 3.16,
   "speech": "有损的是转移场，只有结构。"
  },
  {
   "scene": "problem",
   "index": 34,
   "start": 266.31,
   "dur": 4.5,
   "speech": "把两者混成一句图像化不丢信息，会讲错。"
  },
  {
   "scene": "problem",
   "index": 35,
   "start": 271,
   "dur": 3.52,
   "speech": "第三件要问的是：无损值不值得。"
  },
  {
   "scene": "problem",
   "index": 36,
   "start": 274.69,
   "dur": 2.27,
   "speech": "无损不等于有用。"
  },
  {
   "scene": "problem",
   "index": 37,
   "start": 277.14,
   "dur": 4.19,
   "speech": "图进来，卷积前端能不能预测得更好。"
  },
  {
   "scene": "problem",
   "index": 38,
   "start": 281.51,
   "dur": 3.45,
   "speech": "这是本集最后一场才回答的问题。"
  },
  {
   "scene": "problem",
   "index": 39,
   "start": 285.14,
   "dur": 2.13,
   "speech": "先看两个定义。"
  },
  {
   "scene": "definitions",
   "index": 0,
   "start": 290.67,
   "dur": 2.53,
   "speech": "第一个坐标系：缩放。"
  },
  {
   "scene": "definitions",
   "index": 1,
   "start": 293.38,
   "dur": 3.54,
   "speech": "每个窗口单独做最小最大缩放。"
  },
  {
   "scene": "definitions",
   "index": 2,
   "start": 297.11,
   "dur": 2.49,
   "speech": "缩到负一到正一。"
  },
  {
   "scene": "definitions",
   "index": 3,
   "start": 299.77,
   "dur": 3.9,
   "speech": "常数窗口给一个宽度为一的假区间。"
  },
  {
   "scene": "definitions",
   "index": 4,
   "start": 303.85,
   "dur": 2.1,
   "speech": "否则会除零。"
  },
  {
   "scene": "definitions",
   "index": 5,
   "start": 306.14,
   "dur": 3.33,
   "speech": "缩放是单调的，所以顺序不变。"
  },
  {
   "scene": "definitions",
   "index": 6,
   "start": 309.64,
   "dur": 2.65,
   "speech": "但它吃掉绝对水平。"
  },
  {
   "scene": "definitions",
   "index": 7,
   "start": 312.48,
   "dur": 3.42,
   "speech": "这是后面反解要带回来的东西。"
  },
  {
   "scene": "definitions",
   "index": 8,
   "start": 316.08,
   "dur": 2.68,
   "speech": "第二个坐标系：极角。"
  },
  {
   "scene": "definitions",
   "index": 9,
   "start": 318.94,
   "dur": 2.39,
   "speech": "角度等于反余弦。"
  },
  {
   "scene": "definitions",
   "index": 10,
   "start": 321.51,
   "dur": 3.88,
   "speech": "反余弦把负一到正一映射到零到派。"
  },
  {
   "scene": "definitions",
   "index": 11,
   "start": 325.56,
   "dur": 2.7,
   "speech": "一个点变成一个角度。"
  },
  {
   "scene": "definitions",
   "index": 12,
   "start": 328.45,
   "dur": 2.97,
   "speech": "两个角度相加，取余弦。"
  },
  {
   "scene": "definitions",
   "index": 13,
   "start": 331.59,
   "dur": 2.46,
   "speech": "得到格拉姆角和场。"
  },
  {
   "scene": "definitions",
   "index": 14,
   "start": 334.23,
   "dur": 3.04,
   "speech": "两个角度相减，取正弦。"
  },
  {
   "scene": "definitions",
   "index": 15,
   "start": 337.45,
   "dur": 2.53,
   "speech": "得到格拉姆角差场。"
  },
  {
   "scene": "definitions",
   "index": 16,
   "start": 340.17,
   "dur": 3.13,
   "speech": "和场对称，差场反对称。"
  },
  {
   "scene": "definitions",
   "index": 17,
   "start": 343.48,
   "dur": 2.87,
   "speech": "差场的对角线恒为零。"
  },
  {
   "scene": "definitions",
   "index": 18,
   "start": 346.53,
   "dur": 3.69,
   "speech": "和场的对角线是两倍角的余弦。"
  },
  {
   "scene": "definitions",
   "index": 19,
   "start": 350.4,
   "dur": 3.13,
   "speech": "反解就从这条对角线开始。"
  },
  {
   "scene": "definitions",
   "index": 20,
   "start": 353.71,
   "dur": 3.09,
   "speech": "对角线给出每个点的绝对值。"
  },
  {
   "scene": "definitions",
   "index": 21,
   "start": 356.98,
   "dur": 2.7,
   "speech": "因为余弦二倍角公式。"
  },
  {
   "scene": "definitions",
   "index": 22,
   "start": 359.86,
   "dur": 4.36,
   "speech": "绝对值等于根号下，一加对角值，除以二。"
  },
  {
   "scene": "definitions",
   "index": 23,
   "start": 364.4,
   "dur": 2.17,
   "speech": "符号还缺一半。"
  },
  {
   "scene": "definitions",
   "index": 24,
   "start": 366.75,
   "dur": 2.13,
   "speech": "用第一行补上。"
  },
  {
   "scene": "definitions",
   "index": 25,
   "start": 369.06,
   "dur": 3.9,
   "speech": "第一行给出第一个角与每个角的和。"
  },
  {
   "scene": "definitions",
   "index": 26,
   "start": 373.14,
   "dur": 4.07,
   "speech": "逐列比较两个候选角，选更接近的那个。"
  },
  {
   "scene": "definitions",
   "index": 27,
   "start": 377.39,
   "dur": 2.51,
   "speech": "这就是完整的反解。"
  },
  {
   "scene": "definitions",
   "index": 28,
   "start": 380.08,
