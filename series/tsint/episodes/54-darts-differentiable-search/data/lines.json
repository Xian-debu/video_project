   "dur": 5.03,
   "speech": "超网，也就是混合算子网络，是二八八点四七四。"
  },
  {
   "scene": "metrics",
   "index": 23,
   "start": 714.63,
   "dur": 5.03,
   "speech": "top-1 架构重训一百五十步，是二六七点二一八五。"
  },
  {
   "scene": "metrics",
   "index": 24,
   "start": 719.84,
   "dur": 4.33,
   "speech": "top-2 架构重训，是二五六点三零零四。"
  },
  {
   "scene": "metrics",
   "index": 25,
   "start": 724.35,
   "dur": 4.14,
   "speech": "随机架构重训，是二三零点二七三八。"
  },
  {
   "scene": "metrics",
   "index": 26,
   "start": 728.68,
   "dur": 4.79,
   "speech": "不切验证集的同批架构，是二三六点八四零三。"
  },
