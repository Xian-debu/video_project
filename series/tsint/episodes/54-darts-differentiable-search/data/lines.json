   "scene": "metrics",
   "index": 2,
   "start": 632.39,
   "dur": 3.64,
   "speech": "权重轨迹从第一步到第二十步。"
  },
  {
   "scene": "metrics",
   "index": 3,
   "start": 636.21,
   "dur": 5.37,
   "speech": "平均最大权重从零点三三三四走到零点三三三八。"
