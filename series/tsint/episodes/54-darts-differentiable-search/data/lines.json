   "scene": "metrics",
   "index": 28,
   "start": 737.46,
   "dur": 3.37,
   "speech": "从零基线开始，一路往上看。"
  },
  {
   "scene": "metrics",
   "index": 29,
   "start": 741.02,
   "dur": 2.15,
   "speech": "零基线最低。"
  },
  {
   "scene": "metrics",
   "index": 30,
   "start": 743.35,
   "dur": 2.39,
   "speech": "随机架构第二低。"
  },
  {
   "scene": "metrics",
   "index": 31,
   "start": 745.92,
   "dur": 2.25,
   "speech": "同批架构第三。"
  },
  {
   "scene": "metrics",
   "index": 32,
   "start": 748.34,
   "dur": 2.13,
   "speech": "top-2 第四。"
  },
  {
   "scene": "metrics",
   "index": 33,
   "start": 750.65,
   "dur": 2.13,
   "speech": "top-1 第五。"
  },
  {
   "scene": "metrics",
   "index": 34,
   "start": 752.96,
   "dur": 1.98,
   "speech": "初始化第六。"
  },
  {
   "scene": "metrics",
   "index": 35,
   "start": 755.12,
   "dur": 2.73,
   "speech": "超网最高，排第七。"
  },
  {
   "scene": "metrics",
   "index": 36,
   "start": 758.02,
   "dur": 3.57,
   "speech": "所有训练过的网络都输给零基线。"
  },
  {
   "scene": "metrics",
   "index": 37,
   "start": 761.77,
   "dur": 4.41,
   "speech": "这不是架构搜索的问题，是任务本身没有信号。"
  },
  {
   "scene": "metrics",
   "index": 38,
   "start": 766.36,
   "dur": 4.19,
   "speech": "三十只股票的次日收益，预测不出方向。"
  },
  {
   "scene": "metrics",
   "index": 39,
   "start": 770.73,
   "dur": 3.33,
   "speech": "但搜索的机制还是被检验了。"
  },
  {
   "scene": "metrics",
   "index": 40,
   "start": 774.23,
   "dur": 3.3,
   "speech": "top-1 比随机差百分之十六。"
  },
  {
   "scene": "metrics",
   "index": 41,
   "start": 777.71,
   "dur": 3.9,
   "speech": "top-2 比 top-1 低百分之四点零九。"
  },
  {
   "scene": "metrics",
   "index": 42,
   "start": 781.8,
   "dur": 4.19,
   "speech": "不切验证集时，八条边里有七条不同。"
  },
  {
   "scene": "metrics",
   "index": 43,
   "start": 786.17,
   "dur": 3.78,
   "speech": "同一个种子跑两次，结果逐位一致。"
  },
  {
   "scene": "metrics",
   "index": 44,
   "start": 790.13,
   "dur": 4.48,
   "speech": "四条读数，两条关于机制，两条关于收益。"
  },
  {
   "scene": "metrics",
   "index": 45,
   "start": 794.79,
   "dur": 3.66,
   "speech": "机制：离散化能跑，搜索可复现。"
  },
  {
   "scene": "metrics",
   "index": 46,
   "start": 798.63,
   "dur": 4.45,
   "speech": "收益：top-1 不如随机，top-2 也没赢。"
  },
  {
   "scene": "metrics",
   "index": 47,
   "start": 803.26,
   "dur": 3.9,
   "speech": "还有一个数：搜索空间六千五百六十一。"
  },
  {
   "scene": "metrics",
   "index": 48,
   "start": 807.34,
   "dur": 4.74,
   "speech": "四十八个离散决策，约是原论文的两万分之一。"
  },
  {
   "scene": "metrics",
   "index": 49,
   "start": 812.27,
   "dur": 2.61,
   "speech": "读数够了，看实现。"
  },
  {
   "scene": "implementation",
   "index": 0,
   "start": 818.27,
   "dur": 3.16,
   "speech": "两个模块，三百一十一行。"
  },
  {
   "scene": "implementation",
   "index": 1,
   "start": 821.61,
   "dur": 4,
   "speech": "一个管可微搜索，一个管三层空间。"
  },
  {
   "scene": "implementation",
   "index": 2,
   "start": 825.79,
   "dur": 4.41,
   "speech": "都是纯函数，没有随机数，没有外部数值库。"
  },
  {
   "scene": "implementation",
   "index": 3,
   "start": 830.37,
   "dur": 2.41,
   "speech": "第一个模块，DARTS。"
  },
  {
   "scene": "implementation",
   "index": 4,
   "start": 832.97,
   "dur": 5.46,
   "speech": "导出三个函数：混合算子、softmax 权重、搜索一步。"
  },
  {
   "scene": "implementation",
   "index": 5,
   "start": 838.61,
   "dur": 4.21,
   "speech": "softmax 权重接收一个温度和一组参数。"
  },
  {
   "scene": "implementation",
   "index": 6,
   "start": 843,
   "dur": 3.64,
   "speech": "先减去最大值，防止指数溢出。"
  },
  {
   "scene": "implementation",
   "index": 7,
   "start": 846.82,
   "dur": 2.65,
   "speech": "再取指数、归一化。"
  },
  {
   "scene": "implementation",
   "index": 8,
   "start": 849.65,
   "dur": 3.49,
   "speech": "温度用来控制锐度，默认是一。"
  },
  {
   "scene": "implementation",
   "index": 9,
   "start": 853.33,
   "dur": 4.21,
   "speech": "混合算子接收权重、算子列表和输入。"
  },
  {
   "scene": "implementation",
   "index": 10,
   "start": 857.72,
   "dur": 4.43,
   "speech": "每个算子先算输出，再按权重加权求和。"
  },
  {
