   "scene": "metrics",
   "index": 15,
   "start": 684.35,
   "dur": 4,
   "speech": "一条边一个选择，八条边里两种算子。"
  },
  {
   "scene": "metrics",
   "index": 16,
   "start": 688.53,
   "dur": 2.29,
   "speech": "塌缩不等于选对。"
  },
  {
   "scene": "metrics",
   "index": 17,
   "start": 691,
   "dur": 2.41,
   "speech": "这是第二个负结果。"
  },
  {
   "scene": "metrics",
   "index": 18,
   "start": 693.6,
   "dur": 2.75,
   "speech": "再看离散化之后的误差。"
  },
