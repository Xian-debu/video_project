   "start": 433.17,
   "dur": 2.89,
   "speech": "第一条式子，混合算子。"
  },
  {
   "scene": "definitions",
   "index": 2,
   "start": 436.25,
   "dur": 2.85,
   "speech": "每个算子先算一个输出。"
  },
  {
   "scene": "definitions",
   "index": 3,
   "start": 439.27,
   "dur": 2.65,
   "speech": "每个算子有一个权重。"
  },
  {
   "scene": "definitions",
   "index": 4,
   "start": 442.11,
   "dur": 3.16,
   "speech": "权重是参数的 softmax。"
  },
  {
   "scene": "definitions",
   "index": 5,
   "start": 445.45,
   "dur": 4.14,
   "speech": "混合输出等于权重乘输出再求和。"
  },
  {
   "scene": "definitions",
   "index": 6,
   "start": 449.77,
   "dur": 2.08,
   "speech": "式六点一一。"
  },
  {
   "scene": "definitions",
   "index": 7,
   "start": 452.03,
   "dur": 3.69,
   "speech": "参数全零的时候，三个权重相等。"
  },
  {
   "scene": "definitions",
   "index": 8,
   "start": 455.89,
   "dur": 4.5,
   "speech": "两个算子全零，权重就是零点五和零点五。"
  },
  {
   "scene": "definitions",
   "index": 9,
   "start": 460.57,
   "dur": 7.09,
   "speech": "参数是零和十，权重变成四点五四乘十的负五次方和零点九九九九五。"
  },
  {
   "scene": "definitions",
   "index": 10,
   "start": 467.85,
   "dur": 3.52,
   "speech": "这两个是黄金值，单测里写死。"
  },
  {
   "scene": "definitions",
   "index": 11,
   "start": 471.55,
   "dur": 3.54,
   "speech": "混合两个算子，恒等和置零。"
  },
  {
   "scene": "definitions",
   "index": 12,
   "start": 475.27,
   "dur": 3.23,
   "speech": "输入是一和二，权重各一半。"
  },
  {
   "scene": "definitions",
   "index": 13,
   "start": 478.68,
   "dur": 3.18,
   "speech": "输出是零点五和一点零。"
  },
  {
   "scene": "definitions",
   "index": 14,
   "start": 482.04,
   "dur": 4.17,
   "speech": "置零算子输出零，恒等算子输出原值。"
  },
  {
   "scene": "definitions",
   "index": 15,
   "start": 486.39,
   "dur": 3.88,
   "speech": "权重全给恒等，输出就复现输入。"
  },
  {
   "scene": "definitions",
   "index": 16,
   "start": 490.44,
   "dur": 2.56,
   "speech": "这是第二条黄金值。"
  },
  {
   "scene": "definitions",
   "index": 17,
   "start": 493.18,
   "dur": 2.92,
   "speech": "第二条式子，双层目标。"
  },
  {
   "scene": "definitions",
   "index": 18,
   "start": 496.28,
   "dur": 4,
   "speech": "下层是训练损失，对参数求最小。"
  },
  {
   "scene": "definitions",
   "index": 19,
   "start": 500.46,
   "dur": 3.88,
   "speech": "上层是验证损失，对权重求最小。"
  },
  {
   "scene": "definitions",
   "index": 20,
   "start": 504.52,
   "dur": 3.16,
   "speech": "上层更新用验证集的梯度。"
  },
  {
   "scene": "definitions",
   "index": 21,
   "start": 507.85,
   "dur": 3.18,
   "speech": "下层更新用训练集的梯度。"
  },
  {
   "scene": "definitions",
   "index": 22,
   "start": 511.22,
   "dur": 2.51,
   "speech": "两个学习率分开设。"
  },
  {
   "scene": "definitions",
   "index": 23,
   "start": 513.91,
   "dur": 4.84,
   "speech": "权重学习率通常比参数学习率小两三个数量级。"
  },
  {
   "scene": "definitions",
   "index": 24,
   "start": 518.92,
   "dur": 5.05,
   "speech": "原论文用三乘十的负四次方，本机放大到零点零五。"
  },
  {
   "scene": "definitions",
   "index": 25,
   "start": 524.16,
   "dur": 4.38,
   "speech": "放大是因为步数太少，不放大看不到塌缩。"
  },
  {
   "scene": "definitions",
   "index": 26,
   "start": 528.72,
   "dur": 3.54,
   "speech": "第三条式子，三层搜索空间。"
  },
  {
   "scene": "definitions",
   "index": 27,
   "start": 532.44,
   "dur": 3.09,
   "speech": "第一层是宏观：选哪些块。"
  },
  {
   "scene": "definitions",
   "index": 28,
   "start": 535.71,
   "dur": 4.57,
   "speech": "第二层是微观：每个块里用哪些隐藏表达式。"
  },
  {
   "scene": "definitions",
   "index": 29,
   "start": 540.46,
   "dur": 3.81,
   "speech": "第三层是算子：每条边用哪个算子。"
  },
  {
   "scene": "definitions",
   "index": 30,
   "start": 544.45,
   "dur": 3.76,
   "speech": "三层各自做 softmax，各自归一。"
  },
  {
   "scene": "definitions",
   "index": 31,
   "start": 548.39,
   "dur": 3.95,
   "speech": "宏观权重乘以块输出，再求和。"
  },
  {
   "scene": "definitions",
   "index": 32,
   "start": 552.52,
   "dur": 4,
   "speech": "微观权重乘以表达式输出，再求和。"
  },
  {
   "scene": "definitions",
   "index": 33,
   "start": 556.69,
   "dur": 4.19,
   "speech": "算子权重乘以算子输出，再求和。"
  },
  {
   "scene": "definitions",
   "index": 34,
   "start": 561.06,
   "dur": 3.57,
   "speech": "三层套在一起，就是 ST 块。"
  },
  {
   "scene": "definitions",
   "index": 35,
   "start": 564.81,
   "dur": 5.46,
   "speech": "黄金值：宏观权重零点九和零点一，块输出一和三。"
  },
  {
   "scene": "definitions",
   "index": 36,
   "start": 570.45,
   "dur": 2.61,
   "speech": "加权结果是一点二。"
  },
  {
   "scene": "definitions",
   "index": 37,
   "start": 573.24,
   "dur": 4.07,
   "speech": "微观权重各一半，表达式输出二和四。"
  },
  {
   "scene": "definitions",
   "index": 38,
   "start": 577.49,
   "dur": 2.29,
   "speech": "加权结果是三。"
  },
  {
   "scene": "definitions",
   "index": 39,
   "start": 579.96,
   "dur": 4.77,
   "speech": "再看一层：宏观一半、微观一半、块输出十。"
  },
  {
   "scene": "definitions",
   "index": 40,
   "start": 584.91,
   "dur": 2.61,
   "speech": "组合结果是六点五。"
  },
  {
   "scene": "definitions",
   "index": 41,
   "start": 587.69,
   "dur": 3.33,
   "speech": "三个黄金值分别写进单测。"
  },
  {
   "scene": "definitions",
   "index": 42,
   "start": 591.2,
   "dur": 3.49,
   "speech": "三层空间的离散选择数是十二。"
  },
  {
   "scene": "definitions",
   "index": 43,
   "start": 594.87,
   "dur": 4.17,
   "speech": "三个算子乘两个表达式乘两个块。"
  },
  {
   "scene": "definitions",
   "index": 44,
   "start": 599.22,
   "dur": 3.69,
   "speech": "这个数字很小，但结构是完整的。"
  },
  {
   "scene": "definitions",
   "index": 45,
   "start": 603.09,
   "dur": 2.2,
   "speech": "还需要两个性质。"
  },
  {
   "scene": "definitions",
   "index": 46,
   "start": 605.46,
   "dur": 3.81,
   "speech": "第一，混合输出落在输入的凸包内。"
  },
  {
   "scene": "definitions",
   "index": 47,
   "start": 609.45,
   "dur": 4.33,
   "speech": "第二，权重和输出一起换序，结果不变。"
  },
  {
   "scene": "definitions",
   "index": 48,
   "start": 613.96,
   "dur": 5.08,
   "speech": "凸包保证不会外插，置换等变保证与顺序无关。"
  },
  {
   "scene": "definitions",
   "index": 49,
   "start": 619.22,
   "dur": 2.53,
   "speech": "定义齐了，看读数。"
  },
  {
   "scene": "metrics",
   "index": 0,
   "start": 625.16,
   "dur": 3.85,
   "speech": "二十八项检查，五组，三点八秒。"
  },
  {
   "scene": "metrics",
   "index": 1,
   "start": 629.19,
   "dur": 3.01,
   "speech": "先看搜索本身有没有发生。"
  },
