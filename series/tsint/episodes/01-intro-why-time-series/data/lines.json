   "index": 28,
   "start": 429.51,
   "dur": 2.8,
   "speech": "下一集开始，逐个实现。"
  },
  {
   "scene": "intuition",
   "index": 29,
   "start": 432.86,
   "dur": 3.93,
   "speech": "先看这条管线怎么把数变成证据。"
  },
  {
   "scene": "implementation",
   "index": 0,
