  {
   "scene": "implementation",
   "index": 7,
   "start": 669.23,
   "dur": 4.65,
   "speech": "没有 IO，没有外部库，只依赖核心线性代数。"
  },
  {
   "scene": "implementation",
   "index": 8,
   "start": 674.05,
   "dur": 2.68,
   "speech": "这是仓库的硬规矩。"
  },
  {
   "scene": "implementation",
   "index": 9,
   "start": 676.91,
   "dur": 3.11,
   "speech": "下面挑四处关键实现讲。"
  },
  {
   "scene": "implementation",
   "index": 10,
   "start": 680.2,
   "dur": 2.25,
   "speech": "先看损失函数。"
  },
  {
   "scene": "implementation",
   "index": 11,
   "start": 682.63,
   "dur": 4.09,
   "speech": "参数是 tau、真实值 y、预测 q。"
  },
  {
   "scene": "implementation",
   "index": 12,
   "start": 686.9,
   "dur": 4.26,
   "speech": "tau 不在零到一之间直接报错，不静默夹断。"
  },
  {
   "scene": "implementation",
   "index": 13,
   "start": 691.34,
   "dur": 4.14,
   "speech": "y 大于等于 q 时罚 tau 乘 y 减 q。"
  },
  {
   "scene": "implementation",
   "index": 14,
   "start": 695.66,
   "dur": 3.59,
   "speech": "否则罚一减 tau 乘 q 减 y。"
  },
