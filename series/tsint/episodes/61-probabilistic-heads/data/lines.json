   "dur": 3.16,
   "speech": "分母写错是最容易犯的错。"
  },
  {
   "scene": "implementation",
   "index": 18,
   "start": 710.38,
   "dur": 3.73,
   "speech": "所以检查里专门有一条手算对照。"
