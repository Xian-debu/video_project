   "index": 30,
   "start": 596.01,
   "dur": 2.63,
   "speech": "第三个问题是分布头。"
  },
  {
   "scene": "metrics",
   "index": 31,
   "start": 598.82,
   "dur": 3.59,
   "speech": "拟合高斯：均值负零点零二六六。"
  },
  {
   "scene": "metrics",
   "index": 32,
   "start": 602.59,
   "dur": 2.7,
   "speech": "标准差二点一六九。"
