   "index": 38,
   "start": 627.16,
   "dur": 3.45,
   "speech": "五百天里三十八天落在区间外。"
  },
  {
   "scene": "metrics",
   "index": 39,
   "start": 630.78,
   "dur": 3.4,
   "speech": "尾部比高斯厚，这条线照实报。"
  },
  {
   "scene": "implementation",
