   "scene": "metrics",
   "index": 10,
   "start": 524.28,
   "dur": 2.08,
   "speech": "先看交叉率。"
  },
  {
   "scene": "metrics",
   "index": 11,
   "start": 526.54,
   "dur": 4.74,
   "speech": "测试段七百二十八样本，两万六千二百零八对。"
  },
  {
   "scene": "metrics",
   "index": 12,
   "start": 531.46,
   "dur": 2.41,
   "speech": "逆序对八百八十一。"
