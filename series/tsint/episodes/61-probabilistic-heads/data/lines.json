   "scene": "metrics",
   "index": 2,
   "start": 491.46,
   "dur": 3.09,
   "speech": "全序列六千五百九十九行。"
  },
  {
   "scene": "metrics",
   "index": 3,
   "start": 494.73,
   "dur": 4.05,
   "speech": "从一九九八年十一月到二零二六年十月。"
  },
  {
   "scene": "metrics",
   "index": 4,
   "start": 498.95,
   "dur": 5.01,
   "speech": "训练池取目标日在一五到一九年的一千二百一十九个。"
