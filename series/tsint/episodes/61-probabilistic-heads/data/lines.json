   "scene": "metrics",
   "index": 14,
   "start": 537.52,
   "dur": 3.42,
   "speech": "落在书里百分之三到五的量级里。"
  },
  {
   "scene": "metrics",
   "index": 15,
   "start": 541.12,
   "dur": 2.75,
   "speech": "排序之后逆序对是零。"
  },
  {
   "scene": "metrics",
   "index": 16,
   "start": 544.05,
   "dur": 3.28,
   "speech": "交叉率百分之零，精确的零。"
  },
  {
   "scene": "metrics",
   "index": 17,
   "start": 547.51,
   "dur": 3.71,
   "speech": "而且每个样本的九个值一个不少。"
  },
  {
   "scene": "metrics",
   "index": 18,
   "start": 551.4,
   "dur": 2.99,
   "speech": "只换了位置，没有丢预测。"
  },
  {
   "scene": "metrics",
   "index": 19,
   "start": 554.57,
   "dur": 2.92,
   "speech": "这是零成本最硬的证据。"
  },
  {
   "scene": "metrics",
   "index": 20,
   "start": 557.66,
   "dur": 2.37,
   "speech": "再看排序的代价。"
  },
  {
   "scene": "metrics",
   "index": 21,
   "start": 560.21,
   "dur": 4.12,
   "speech": "排序前 pinball 损失零点七二六七三一。"
  },
  {
   "scene": "metrics",
   "index": 22,
   "start": 564.51,
   "dur": 3.28,
   "speech": "排序后零点七二四八六四。"
  },
  {
   "scene": "metrics",
   "index": 23,
   "start": 567.97,
   "dur": 3.97,
   "speech": "相对变化是负的百分之零点二五六八。"
  },
  {
   "scene": "metrics",
   "index": 24,
   "start": 572.12,
   "dur": 3.88,
   "speech": "也就是说几乎没变，还略降了一点。"
