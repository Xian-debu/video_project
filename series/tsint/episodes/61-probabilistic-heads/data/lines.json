  },
  {
   "scene": "metrics",
   "index": 34,
   "start": 609.34,
   "dur": 4.19,
   "speech": "锚点检查：mu 等于 y、sigma 等于一。"
  },
  {
   "scene": "metrics",
   "index": 35,
   "start": 613.71,
   "dur": 4.48,
   "speech": "这时 NLL 零点九一八九，手算能对上。"
  },
  {
   "scene": "metrics",
   "index": 36,
   "start": 618.37,
   "dur": 4.45,
   "speech": "半乘 ln 二 pi 加半，就是零点九一八九。"
  },
  {
   "scene": "metrics",
   "index": 37,
   "start": 623,
   "dur": 3.97,
   "speech": "覆盖率：名义九十五，实测九十二点四。"
  },
