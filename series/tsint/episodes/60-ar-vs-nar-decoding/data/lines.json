 "lines": [
  {
   "scene": "open",
   "index": 0,
   "start": 1.2,
   "dur": 3.21,
   "speech": "这一集问一个很具体的问题。"
  },
  {
   "scene": "open",
   "index": 1,
   "start": 4.59,
   "dur": 5.44,
   "speech": "预测未来二十天，应该一步一步走，还是一口气吐出来。"
  },
  {
   "scene": "open",
   "index": 2,
   "start": 10.2,
   "dur": 5.29,
   "speech": "两种做法都有名字：自回归解码，和非自回归解码。"
  },
  {
   "scene": "open",
   "index": 3,
   "start": 15.68,
   "dur": 4.07,
   "speech": "不是模型结构之争，是解码方式之争。"
  },
  {
   "scene": "open",
   "index": 4,
   "start": 19.93,
   "dur": 4.45,
   "speech": "同一个编码器，同一个窗口，同一批测试数据。"
  },
  {
   "scene": "open",
   "index": 5,
   "start": 24.56,
   "dur": 4.12,
   "speech": "只换最后那一步：把表示变成预测的方式。"
  },
  {
   "scene": "open",
   "index": 6,
   "start": 28.86,
   "dur": 4.53,
   "speech": "一步一步，每一步都把自己的输出塞回输入。"
  },
  {
   "scene": "open",
   "index": 7,
   "start": 33.57,
   "dur": 4.45,
   "speech": "一口气，一次矩阵乘法直接给出二十个点。"
  },
  {
   "scene": "open",
   "index": 8,
   "start": 38.2,
   "dur": 5.27,
   "speech": "前者慢、误差会累积；后者快、但会把尖峰抹平。"
  },
  {
   "scene": "open",
   "index": 9,
   "start": 43.65,
   "dur": 4,
   "speech": "这一集把这两句话拆开，一项一项量。"
  },
  {
   "scene": "open",
   "index": 10,
   "start": 47.83,
   "dur": 3.97,
   "speech": "先说清楚为什么值得单独讲一集。"
  },
  {
   "scene": "open",
   "index": 11,
   "start": 51.98,
   "dur": 5.1,
   "speech": "因为解码方式决定两件事：误差怎么长，算力怎么花。"
  },
  {
   "scene": "open",
   "index": 12,
   "start": 57.26,
   "dur": 5.08,
   "speech": "自回归要跑二十次前向，每一次都依赖上一次的结果。"
  },
  {
   "scene": "open",
   "index": 13,
   "start": 62.52,
   "dur": 4.17,
   "speech": "非自回归只跑一次，二十个点同时出来。"
  },
  {
   "scene": "open",
   "index": 14,
   "start": 66.87,
   "dur": 4.02,
   "speech": "代价是二十个点之间不再有条件依赖。"
  },
  {
   "scene": "open",
   "index": 15,
   "start": 71.07,
   "dur": 5.15,
   "speech": "在收益率这种信噪比很低的数据上，代价往往看得见。"
  },
  {
   "scene": "open",
   "index": 16,
   "start": 76.4,
   "dur": 5.65,
   "speech": "所以问题不是哪个更先进，而是各自在哪一段地平线上赢。"
  },
  {
   "scene": "open",
   "index": 17,
   "start": 82.23,
   "dur": 5.68,
   "speech": "书里给了一个直觉：两条误差曲线会在某个地平线附近交叉。"
  },
  {
   "scene": "open",
   "index": 18,
   "start": 88.09,
   "dur": 4.05,
   "speech": "这一集的任务，就是把那个交叉点量出来。"
  },
  {
   "scene": "open",
   "index": 19,
   "start": 92.32,
   "dur": 3.23,
   "speech": "量不出来也算结果，照实写。"
  },
  {
   "scene": "open",
   "index": 20,
   "start": 95.73,
   "dur": 4.19,
   "speech": "先看四个数，后面每一场都会回到它们。"
  },
  {
   "scene": "open",
   "index": 21,
   "start": 100.1,
   "dur": 4.84,
   "speech": "测试窗口一百九十七个，地平线从一走到二十。"
  },
  {
   "scene": "open",
   "index": 22,
   "start": 105.12,
   "dur": 4.89,
   "speech": "二十步处，自回归的相对误差是一点五六四七。"
  },
  {
   "scene": "open",
   "index": 23,
   "start": 110.18,
   "dur": 4.41,
   "speech": "同样二十步，非自回归是一点二九三二。"
  },
  {
   "scene": "open",
   "index": 24,
   "start": 114.77,
   "dur": 5.27,
   "speech": "两条曲线在第八步交叉，之后非自回归一直领先。"
  },
  {
   "scene": "open",
   "index": 25,
   "start": 120.22,
   "dur": 4.67,
   "speech": "推理耗时比是十五点七倍，非自回归更快。"
  },
  {
   "scene": "open",
   "index": 26,
   "start": 125.07,
   "dur": 4.96,
   "speech": "这几组数都来自同一条命令，十八条检查全过。"
  },
  {
   "scene": "open",
   "index": 27,
   "start": 130.21,
   "dur": 3.45,
   "speech": "注意，两个相对误差都大于一。"
  },
  {
   "scene": "open",
   "index": 28,
   "start": 133.83,
   "dur": 3.95,
   "speech": "意思是，它们都还没打过最简单的基线。"
  },
  {
   "scene": "open",
   "index": 29,
   "start": 137.96,
   "dur": 3.45,
   "speech": "这句话会一直留到边界那一场。"
  },
  {
   "scene": "open",
   "index": 30,
   "start": 141.59,
   "dur": 2.25,
   "speech": "接下来分八场。"
  },
  {
   "scene": "open",
   "index": 31,
   "start": 144.01,
   "dur": 4.53,
   "speech": "第一场把问题摆出来：误差为什么会随步数长。"
  },
  {
   "scene": "open",
   "index": 32,
   "start": 148.72,
   "dur": 4.81,
   "speech": "第二场给定义：回灌、教师强制、一次输出。"
  },
  {
   "scene": "open",
   "index": 33,
   "start": 153.71,
   "dur": 5.17,
   "speech": "第三场定度量：相对误差、持久化基线、窗口口径。"
  },
  {
   "scene": "open",
   "index": 34,
   "start": 159.07,
   "dur": 4.84,
   "speech": "第四场写实现：两个纯函数模块和它们的测试。"
  },
  {
   "scene": "open",
   "index": 35,
   "start": 164.09,
   "dur": 5.56,
   "speech": "第五场把证据摊开：曲线、参数、耗时、曝光偏差。"
  },
  {
   "scene": "open",
   "index": 36,
   "start": 169.82,
   "dur": 4.53,
   "speech": "第六场讲边界：哪里没做到，哪里不能下结论。"
  },
  {
   "scene": "open",
   "index": 37,
   "start": 174.53,
   "dur": 3.52,
   "speech": "最后一场收束，并指向下一集。"
  },
  {
   "scene": "open",
   "index": 38,
   "start": 178.23,
   "dur": 4.55,
   "speech": "每一屏上的数字都能由仓库里的一条命令复现。"
  },
  {
   "scene": "open",
   "index": 39,
   "start": 182.96,
   "dur": 2.99,
   "speech": "先从一个具体的困境说起。"
  },
  {
   "scene": "problem",
   "index": 0,
   "start": 189.35,
   "dur": 3.4,
   "speech": "假设你要预测未来二十天的走势。"
  },
  {
   "scene": "problem",
   "index": 1,
   "start": 192.93,
   "dur": 4.84,
   "speech": "你手上有一个能压缩窗口的编码器，输出六十四维。"
  },
  {
   "scene": "problem",
   "index": 2,
   "start": 197.95,
   "dur": 4.38,
   "speech": "还有一个线性头，把六十四维映射成一个数。"
  },
  {
   "scene": "problem",
   "index": 3,
   "start": 202.51,
   "dur": 4.45,
   "speech": "自回归的做法很直接：先用头预测第一天。"
  },
  {
   "scene": "problem",
   "index": 4,
   "start": 207.14,
   "dur": 4.41,
   "speech": "把预测值接到窗口末尾，丢掉最老的一点。"
  },
  {
   "scene": "problem",
   "index": 5,
   "start": 211.73,
   "dur": 3.25,
   "speech": "再用这个新窗口预测第二天。"
  },
  {
   "scene": "problem",
   "index": 6,
   "start": 215.16,
   "dur": 3.33,
   "speech": "重复二十次，得到二十个预测。"
  },
  {
   "scene": "problem",
   "index": 7,
   "start": 218.67,
   "dur": 5.34,
   "speech": "非自回归换一条路：一次训练一个头，直接输出二十维。"
  },
  {
   "scene": "problem",
   "index": 8,
   "start": 224.19,
   "dur": 4.84,
   "speech": "推理时只做一次矩阵乘法，二十个点同时落地。"
  },
  {
   "scene": "problem",
   "index": 9,
   "start": 229.21,
   "dur": 4.86,
   "speech": "两条路用的是同一个编码器，差别只在头的形状。"
  },
  {
   "scene": "problem",
   "index": 10,
   "start": 234.25,
   "dur": 3.73,
   "speech": "自回归的第一个隐患是误差回灌。"
  },
  {
   "scene": "problem",
   "index": 11,
   "start": 238.16,
   "dur": 4.48,
   "speech": "第一步的预测有误差，它会被当成第二步的输入。"
  },
  {
   "scene": "problem",
   "index": 12,
   "start": 242.82,
   "dur": 3.95,
   "speech": "第二步的误差又进第三步，像滚雪球。"
  },
  {
   "scene": "problem",
   "index": 13,
   "start": 246.95,
   "dur": 4.57,
   "speech": "如果每一步的误差相互独立，方差会线性相加。"
  },
  {
   "scene": "problem",
   "index": 14,
   "start": 251.71,
   "dur": 4.55,
   "speech": "二十步之后，标准差大约是一步的四点四七倍。"
  },
  {
   "scene": "problem",
   "index": 15,
   "start": 256.44,
   "dur": 4.65,
   "speech": "这就是根号 F 的来源，F 是地平线长度。"
  },
  {
   "scene": "problem",
   "index": 16,
   "start": 261.26,
   "dur": 3.64,
   "speech": "它是一个上界式的直觉，不是定理。"
  },
  {
   "scene": "problem",
   "index": 17,
   "start": 265.08,
   "dur": 3.93,
   "speech": "真实模型里，误差往往有系统性成分。"
  },
  {
   "scene": "problem",
   "index": 18,
   "start": 269.19,
   "dur": 5.17,
   "speech": "系统性偏差每一步都往同一个方向推，不会相互抵消。"
  },
  {
   "scene": "problem",
   "index": 19,
   "start": 274.54,
   "dur": 4.98,
   "speech": "所以实测曲线可能比根号 F 陡，也可能更平。"
  },
  {
   "scene": "problem",
   "index": 20,
   "start": 279.7,
   "dur": 3.4,
   "speech": "我们先把预期写下来，再去测。"
  },
  {
   "scene": "problem",
   "index": 21,
   "start": 283.28,
   "dur": 4.45,
   "speech": "预期一：自回归的误差随步数单调增长。"
  },
  {
   "scene": "problem",
   "index": 22,
   "start": 287.91,
   "dur": 4.17,
   "speech": "预期二：非自回归长得更慢，最终反超。"
  },
  {
   "scene": "problem",
   "index": 23,
   "start": 292.26,
   "dur": 3.71,
   "speech": "预期三：两步之间误差不是独立噪声。"
  },
  {
   "scene": "problem",
   "index": 24,
   "start": 296.15,
   "dur": 4.45,
   "speech": "所以根号 F 的曲线大概率不会贴住实测。"
  },
  {
   "scene": "problem",
   "index": 25,
   "start": 300.78,
   "dur": 4.12,
   "speech": "如果贴住了，说明误差确实接近白噪声。"
  },
  {
   "scene": "problem",
   "index": 26,
   "start": 305.08,
   "dur": 4.36,
   "speech": "如果差很远，说明模型有系统性的偏差。"
  },
  {
   "scene": "problem",
   "index": 27,
   "start": 309.62,
   "dur": 3.21,
   "speech": "这两种结果都值得讲清楚。"
  },
  {
   "scene": "problem",
   "index": 28,
   "start": 313.01,
   "dur": 4.09,
   "speech": "更重要的，是别把一次巧合当成规律。"
  },
  {
   "scene": "problem",
   "index": 29,
   "start": 317.28,
   "dur": 4.69,
   "speech": "所以要固定窗口、固定编码器、固定切分。"
  },
  {
   "scene": "problem",
   "index": 30,
   "start": 322.15,
   "dur": 2.61,
   "speech": "具体要回答三个问题。"
  },
  {
   "scene": "problem",
   "index": 31,
   "start": 324.94,
   "dur": 3.45,
   "speech": "第一，回灌式 rollout 写得对不对。"
  },
  {
   "scene": "problem",
   "index": 32,
   "start": 328.57,
   "dur": 5.05,
   "speech": "检验办法是复制函数：每一步都返回窗口最后一点。"
  },
  {
   "scene": "problem",
   "index": 33,
   "start": 333.8,
   "dur": 4.07,
   "speech": "那么二十步之后，每个输出都该等于那个点。"
  },
  {
   "scene": "problem",
   "index": 34,
   "start": 338.05,
   "dur": 3.45,
   "speech": "这是纯定义检查，不涉及训练。"
  },
  {
   "scene": "problem",
   "index": 35,
   "start": 341.68,
   "dur": 5.58,
   "speech": "第二，误差随地平线怎么长，什么时候被非自回归反超。"
  },
  {
   "scene": "problem",
   "index": 36,
   "start": 347.44,
   "dur": 5.53,
   "speech": "第三，非自回归一次前向，能比自回归二十次快多少。"
  },
  {
   "scene": "problem",
   "index": 37,
   "start": 353.15,
   "dur": 3.21,
   "speech": "计划的验收线是五倍以上。"
  },
  {
   "scene": "problem",
   "index": 38,
   "start": 356.54,
   "dur": 5.13,
   "speech": "三个问题分别对应三组检查：ar、curve、timing。"
  },
  {
   "scene": "problem",
   "index": 39,
   "start": 361.84,
   "dur": 3.54,
   "speech": "答案在第五场，先把定义写清楚。"
  },
  {
   "scene": "definitions",
   "index": 0,
   "start": 368.79,
   "dur": 3.33,
   "speech": "自回归解码的定义只有一行。"
  },
  {
   "scene": "definitions",
   "index": 1,
   "start": 372.3,
   "dur": 3.88,
   "speech": "下一时刻的预测，是当前窗口的函数。"
  },
  {
   "scene": "definitions",
   "index": 2,
   "start": 376.35,
   "dur": 3.76,
   "speech": "拿到预测之后，把它接到窗口末尾。"
  },
  {
   "scene": "definitions",
   "index": 3,
   "start": 380.29,
   "dur": 4.05,
   "speech": "窗口长度固定，所以丢掉最老的一点。"
  },
  {
   "scene": "definitions",
   "index": 4,
   "start": 384.52,
   "dur": 4.57,
   "speech": "这就是一次推进，重复 F 次就是 F 步解码。"
  },
  {
   "scene": "definitions",
   "index": 5,
   "start": 389.27,
   "dur": 3.93,
   "speech": "F 等于一，退化成普通的单步预测。"
  },
  {
   "scene": "definitions",
   "index": 6,
   "start": 393.38,
   "dur": 3.73,
   "speech": "F 等于二十，就是这一集的主设定。"
  },
  {
   "scene": "definitions",
   "index": 7,
   "start": 397.29,
   "dur": 4.41,
   "speech": "注意，推理时窗口里混进了模型自己的预测。"
  },
  {
   "scene": "definitions",
   "index": 8,
   "start": 401.88,
   "dur": 5.46,
   "speech": "训练时窗口里全是真实值，这个不对称叫曝光偏差。"
  },
  {
   "scene": "definitions",
   "index": 9,
   "start": 407.52,
   "dur": 3.59,
   "speech": "它会在验证那一段被单独量出来。"
  },
  {
   "scene": "definitions",
   "index": 10,
   "start": 411.29,
   "dur": 3.01,
   "speech": "接口定义成三个纯函数。"
  },
  {
   "scene": "definitions",
   "index": 11,
   "start": 414.48,
   "dur": 4.43,
   "speech": "第一个是预测器类型：给一个窗口，返回一个数。"
  },
  {
   "scene": "definitions",
   "index": 12,
   "start": 419.09,
   "dur": 4.96,
   "speech": "第二个是 rollout：给初始窗口和步数，返回路径。"
  },
  {
   "scene": "definitions",
   "index": 13,
   "start": 424.23,
   "dur": 4.79,
   "speech": "第三个是教师强制版本：每一步都用真实历史。"
  },
  {
   "scene": "definitions",
   "index": 14,
   "start": 429.2,
   "dur": 5.46,
   "speech": "教师强制里，第 j 个预测只看真实窗口的第 j 段。"
  },
  {
   "scene": "definitions",
   "index": 15,
   "start": 434.84,
   "dur": 3.88,
   "speech": "它从不吃自己的预测，所以适合训练。"
  },
  {
   "scene": "definitions",
   "index": 16,
   "start": 438.9,
   "dur": 4.55,
   "speech": "rollout 每一步都要复制窗口，这是它的主要成本。"
  },
  {
   "scene": "definitions",
   "index": 17,
   "start": 443.63,
   "dur": 4.96,
   "speech": "五百一十二个点乘二十步，复制比矩阵乘法还贵。"
  },
  {
   "scene": "definitions",
   "index": 18,
   "start": 448.77,
   "dur": 5.05,
   "speech": "更快的写法是环形缓冲，本集没有做，写进注释。"
  },
  {
   "scene": "definitions",
   "index": 19,
   "start": 454,
   "dur": 4.33,
   "speech": "边界都做了硬断言：步数为负直接报错。"
  },
  {
   "scene": "definitions",
   "index": 20,
   "start": 458.52,
   "dur": 3.57,
   "speech": "非自回归解码的定义也是一行。"
  },
  {
   "scene": "definitions",
   "index": 21,
   "start": 462.26,
   "dur": 4.29,
   "speech": "二十个预测点，一次线性映射同时给出。"
  },
  {
   "scene": "definitions",
   "index": 22,
   "start": 466.73,
   "dur": 4.67,
   "speech": "映射的权重是一个矩阵，行数是地平线长度。"
  },
  {
   "scene": "definitions",
   "index": 23,
   "start": 471.58,
   "dur": 3.85,
   "speech": "每一行负责一个未来时刻，互不依赖。"
  },
  {
   "scene": "definitions",
   "index": 24,
   "start": 475.61,
   "dur": 4.77,
   "speech": "输入是六十四维表示，再拼一个常数一作为偏置。"
  },
  {
   "scene": "definitions",
   "index": 25,
   "start": 480.56,
   "dur": 4.55,
   "speech": "所以每个输出点有六十五个权重加一个偏置。"
  },
  {
   "scene": "definitions",
   "index": 26,
   "start": 485.29,
   "dur": 4.84,
   "speech": "二十个点就是六十六乘二十，一千三百二十个参数。"
  },
  {
   "scene": "definitions",
   "index": 27,
   "start": 490.31,
   "dur": 4.12,
   "speech": "计划书写一千三百，差在偏置怎么记。"
  },
  {
   "scene": "definitions",
   "index": 28,
   "start": 494.61,
   "dur": 4.81,
   "speech": "偏置单独一列也是参数，所以实测多出二十个。"
  },
  {
   "scene": "definitions",
   "index": 29,
   "start": 499.6,
   "dur": 2.87,
   "speech": "屏幕上永远用实算值。"
  },
  {
   "scene": "definitions",
   "index": 30,
   "start": 502.65,
   "dur": 2.32,
   "speech": "接口同样极简。"
  },
  {
   "scene": "definitions",
   "index": 31,
   "start": 505.15,
   "dur": 5.17,
   "speech": "矩阵按行主序存，行数等于 F，列数等于六十六。"
  },
  {
   "scene": "definitions",
   "index": 32,
   "start": 510.5,
   "dur": 4.6,
   "speech": "参数个数公式是输入维加一，再乘地平线。"
  },
  {
   "scene": "definitions",
   "index": 33,
   "start": 515.28,
   "dur": 4.36,
   "speech": "narDecode 只做一件事：一次矩阵向量乘。"
  },
  {
   "scene": "definitions",
   "index": 34,
   "start": 519.82,
   "dur": 3.97,
   "speech": "行宽不对就直接报错，不做静默截断。"
  },
  {
   "scene": "definitions",
   "index": 35,
   "start": 523.97,
   "dur": 3.59,
   "speech": "augmentFeat 在表示末尾补一个一。"
  },
  {
   "scene": "definitions",
   "index": 36,
   "start": 527.74,
   "dur": 3.78,
   "speech": "测试里用恒等任务验证表达力。"
  },
  {
   "scene": "definitions",
   "index": 37,
   "start": 531.7,
   "dur": 5.08,
   "speech": "一百个样本、八维输入、三维输出，闭式解拟合。"
  },
  {
   "scene": "definitions",
   "index": 38,
   "start": 536.96,
   "dur": 5.1,
   "speech": "均方误差是零，说明这个头能精确表达线性映射。"
  },
  {
   "scene": "definitions",
   "index": 39,
   "start": 542.24,
   "dur": 2.92,
   "speech": "定义讲完，下一场定度量。"
  },
  {
   "scene": "metrics",
   "index": 0,
   "start": 548.56,
   "dur": 4.57,
   "speech": "这一集预测的不是收益，是标准化后的价格路径。"
  },
  {
   "scene": "metrics",
   "index": 1,
   "start": 553.31,
   "dur": 3.54,
   "speech": "具体说，取未来二十天的收盘价。"
  },
  {
   "scene": "metrics",
   "index": 2,
   "start": 557.04,
   "dur": 4.41,
   "speech": "每个点减去窗口均值，再除以窗口标准差。"
  },
  {
   "scene": "metrics",
   "index": 3,
   "start": 561.62,
   "dur": 4.09,
   "speech": "这样二十个点的量纲和窗口内部一致。"
  },
  {
   "scene": "metrics",
   "index": 4,
   "start": 565.9,
   "dur": 4.84,
   "speech": "持久化基线：把窗口最后一点原样重复二十次。"
  },
  {
   "scene": "metrics",
   "index": 5,
   "start": 570.91,
   "dur": 4.41,
   "speech": "它回答一个问题：如果什么都不变，误差多大。"
  },
  {
   "scene": "metrics",
   "index": 6,
   "start": 575.5,
   "dur": 3.73,
   "speech": "所有模型误差都除以这个基线误差。"
  },
  {
   "scene": "metrics",
   "index": 7,
   "start": 579.41,
   "dur": 4.36,
   "speech": "得到的数叫相对误差，基线正好是一。"
  },
  {
   "scene": "metrics",
   "index": 8,
   "start": 583.95,
   "dur": 3.83,
   "speech": "小于一比基线好，大于一比基线差。"
  },
  {
   "scene": "metrics",
   "index": 9,
   "start": 587.96,
   "dur": 4,
   "speech": "用相对误差，不同股票之间也能比较。"
  },
  {
   "scene": "metrics",
   "index": 10,
   "start": 592.14,
   "dur": 3.93,
   "speech": "为什么用平均绝对误差，不用均方误差。"
  },
  {
   "scene": "metrics",
   "index": 11,
   "start": 596.25,
   "dur": 4.96,
   "speech": "均方误差被大波动主导，一个极端点能左右结论。"
  },
  {
   "scene": "metrics",
   "index": 12,
   "start": 601.38,
   "dur": 5.13,
   "speech": "平均绝对误差每个点同权，和基线对照更直白。"
  },
  {
   "scene": "metrics",
   "index": 13,
   "start": 606.69,
   "dur": 4.17,
   "speech": "代价是它对系统性偏差的惩罚更线性。"
  },
  {
   "scene": "metrics",
   "index": 14,
   "start": 611.04,
   "dur": 4.89,
   "speech": "所以我们会同时看两端：第一步和第二十步。"
  },
  {
   "scene": "metrics",
   "index": 15,
   "start": 616.1,
   "dur": 4.07,
   "speech": "第一步接近一时，说明模型几乎没有信息。"
  },
  {
   "scene": "metrics",
   "index": 16,
   "start": 620.35,
   "dur": 4.33,
   "speech": "第二十步的变化，才说明它有没有积累优势。"
  },
  {
   "scene": "metrics",
   "index": 17,
   "start": 624.87,
   "dur": 4.29,
   "speech": "两个模型用同一批窗口、同一批测试点。"
  },
  {
   "scene": "metrics",
   "index": 18,
   "start": 629.33,
   "dur": 4.36,
   "speech": "连随机种子都不需要，这里全是闭式解。"
  },
  {
   "scene": "metrics",
   "index": 19,
   "start": 633.87,
   "dur": 3.61,
   "speech": "没有随机性，就没有选种子的空间。"
  },
  {
   "scene": "metrics",
   "index": 20,
   "start": 637.66,
   "dur": 2.51,
   "speech": "数据口径分三段。"
  },
  {
   "scene": "metrics",
   "index": 21,
   "start": 640.35,
   "dur": 3.54,
   "speech": "全集是六千六百个后复权收盘。"
  },
  {
   "scene": "metrics",
   "index": 22,
   "start": 644.08,
   "dur": 4.09,
   "speech": "从一九九八年十一月，到二零二六年十月。"
  },
  {
   "scene": "metrics",
   "index": 23,
   "start": 648.35,
   "dur": 5.22,
   "speech": "测试段取二零二零到二零二二这三年，共七百二十八点。"
  },
  {
   "scene": "metrics",
   "index": 24,
   "start": 653.75,
   "dur": 3.95,
   "speech": "这一段波动大，模型的问题更容易露出来。"
  },
  {
   "scene": "metrics",
   "index": 25,
   "start": 657.88,
   "dur": 5.2,
   "speech": "七百二十八点能切一百九十七个窗口，每个五百一十二点。"
  },
