   "index": 2,
   "start": 396.78,
   "dur": 3.9,
   "speech": "六边形更接近圆，方向偏差更小。"
  },
  {
   "scene": "intuition",
   "index": 3,
   "start": 401.23,
   "dur": 2.7,
   "speech": "坐标用轴向整数对。"
