   "scene": "intuition",
   "index": 16,
   "start": 439.02,
   "dur": 2.75,
   "speech": "候选一，每个点加五。"
  },
  {
   "scene": "intuition",
   "index": 17,
   "start": 441.95,
   "dur": 3.25,
   "speech": "候选二，每个点乘一点零二。"
  },
  {
   "scene": "intuition",
   "index": 18,
   "start": 445.38,
   "dur": 2.49,
   "speech": "真值均值五十左右。"
  },
  {
   "scene": "intuition",
   "index": 19,
   "start": 448.05,
   "dur": 2.49,
   "speech": "加五，误差五块。"
  },
