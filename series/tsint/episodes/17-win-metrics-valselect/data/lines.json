   "scene": "intuition",
   "index": 20,
   "start": 450.71,
   "dur": 4.12,
   "speech": "乘一点零二，误差一块，均值五十时。"
  },
  {
   "scene": "intuition",
   "index": 21,
   "start": 455.01,
   "dur": 2.37,
   "speech": "但百分比反过来。"
  },
  {
   "scene": "intuition",
   "index": 22,
   "start": 457.56,
   "dur": 2.73,
   "speech": "加五，百分之二十五。"
  },
  {
   "scene": "intuition",
   "index": 23,
   "start": 460.46,
   "dur": 2.8,
   "speech": "乘一点零二，百分之二。"
  },
  {
   "scene": "intuition",
   "index": 24,
   "start": 463.44,
   "dur": 2.61,
   "speech": "按误差选，选加五。"
  },
