   "scene": "intuition",
   "index": 14,
   "start": 433.66,
   "dur": 2.25,
   "speech": "再看合成数据。"
  },
  {
   "scene": "intuition",
   "index": 15,
   "start": 436.09,
   "dur": 2.75,
   "speech": "真值是一条平滑曲线。"
  },
