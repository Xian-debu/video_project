   "start": 516.39,
   "dur": 4.91,
   "speech": "总长减偏移减输入减标签，整除步长，加一。"
  },
  {
   "scene": "implementation",
   "index": 7,
   "start": 521.48,
   "dur": 3.69,
   "speech": "窗口函数按这个公式生成样本。"
  },
