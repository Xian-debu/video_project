   "scene": "intuition",
   "index": 26,
   "start": 469.78,
   "dur": 3.04,
   "speech": "同一个验证集，两个赢家。"
  },
  {
   "scene": "intuition",
   "index": 27,
   "start": 473,
   "dur": 1.93,
   "speech": "为什么会这样。"
  },
