   "index": 32,
   "start": 490.38,
   "dur": 3.83,
   "speech": "所以下一步，把训练和选模也写死。"
  },
  {
   "scene": "implementation",
   "index": 0,
   "start": 497.61,
   "dur": 2.94,
   "speech": "三个模块，各管一件事。"
