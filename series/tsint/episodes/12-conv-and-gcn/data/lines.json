   "scene": "intuition",
   "index": 3,
   "start": 291.39,
   "dur": 3.4,
   "speech": "核往右挪一格，再乘加一次。"
  },
  {
   "scene": "intuition",
   "index": 4,
   "start": 295.34,
   "dur": 3.69,
   "speech": "同一个核，在每个位置重复使用。"
  },
  {
   "scene": "intuition",
   "index": 5,
   "start": 299.57,
   "dur": 4.55,
   "speech": "这就是参数共享：核的大小不随序列变长。"
  },
  {
   "scene": "intuition",
   "index": 6,
   "start": 304.67,
   "dur": 4.38,
   "speech": "每个输出的邻居，就是它前面固定的那几格。"
  },
  {
   "scene": "intuition",
   "index": 7,
   "start": 309.6,
   "dur": 3.95,
   "speech": "邻居由距离决定，跟数据内容无关。"
  },
  {
   "scene": "intuition",
   "index": 8,
