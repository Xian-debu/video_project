  {
   "scene": "boundary",
   "index": 29,
   "start": 1373.53,
   "dur": 4.55,
   "speech": "换个窗口长度，换个通道数，数字就变了。"
  },
  {
   "scene": "boundary",
   "index": 30,
   "start": 1378.63,
   "dur": 3.01,
   "speech": "但因果性这个性质，不变。"
