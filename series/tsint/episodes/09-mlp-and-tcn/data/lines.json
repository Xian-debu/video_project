  {
   "scene": "boundary",
   "index": 35,
   "start": 1395.41,
   "dur": 2.85,
   "speech": "茅台五千零三十三行。"
  },
  {
   "scene": "boundary",
   "index": 36,
   "start": 1398.81,
   "dur": 3.93,
   "speech": "上证指数那只票，四千九百五十三行。"
