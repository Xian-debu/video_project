  {
   "scene": "boundary",
   "index": 41,
   "start": 1418.77,
   "dur": 3.25,
   "speech": "这一点，前面几集已经说过。"
  },
  {
   "scene": "boundary",
   "index": 42,
   "start": 1422.57,
   "dur": 2.27,
   "speech": "这一集继续沿用。"
  },
  {
   "scene": "outro",
   "index": 0,
   "start": 1428.24,
   "dur": 3.95,
   "speech": "两个模型，四个数字，给这一集收尾。"
  },
  {
   "scene": "outro",
   "index": 1,
