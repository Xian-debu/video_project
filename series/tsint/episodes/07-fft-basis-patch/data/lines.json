   "index": 3,
   "start": 892.04,
   "dur": 5.05,
   "speech": "FFT 二十六条，基展开十八条，Patch 十一条。"
  },
  {
   "scene": "verification",
   "index": 4,
   "start": 897.64,
   "dur": 3.33,
   "speech": "手算的部分，先看 Parseval。"
  },
  {
