  {
   "scene": "intuition",
   "index": 0,
   "start": 341.79,
   "dur": 2.94,
   "speech": "先看 FFT 在做什么。"
  },
  {
   "scene": "intuition",
   "index": 1,
   "start": 345.28,
   "dur": 3.93,
   "speech": "一条序列，看成一组正弦波的叠加。"
  },
  {
   "scene": "intuition",
   "index": 2,
   "start": 349.76,
   "dur": 3.69,
   "speech": "每个频率配一个复数：振幅和相位。"
  },
  {
   "scene": "intuition",
   "index": 3,
   "start": 353.99,
   "dur": 2.94,
   "speech": "频谱就是这组复数的模。"
  },
  {
   "scene": "intuition",
   "index": 4,
   "start": 357.49,
   "dur": 3.64,
   "speech": "相位也在里面，只是这一集只看模。"
  },
  {
   "scene": "intuition",
   "index": 5,
   "start": 361.67,
   "dur": 3.28,
   "speech": "书里图二点一二，是一个例子。"
  },
  {
   "scene": "intuition",
   "index": 6,
   "start": 365.5,
   "dur": 6.4,
   "speech": "呼吸，零点三赫兹；心跳，一点一七赫兹；再加十赫兹的噪声。"
  },
  {
   "scene": "intuition",
   "index": 7,
   "start": 372.45,
   "dur": 3.81,
   "speech": "采样率一千赫兹，四千零九十六个点。"
  },
  {
   "scene": "intuition",
   "index": 8,
   "start": 376.81,
   "dur": 4.67,
   "speech": "做一次 FFT，三个峰落在对应的频率上。"
  },
  {
   "scene": "intuition",
   "index": 9,
   "start": 382.03,
   "dur": 2.65,
   "speech": "把九到十一赫兹滤掉。"
  },
  {
   "scene": "intuition",
   "index": 10,
   "start": 385.23,
   "dur": 4.09,
   "speech": "剩下的 RMS 是零点七九零六。"
  },
  {
   "scene": "intuition",
   "index": 11,
   "start": 389.87,
   "dur": 4.79,
   "speech": "被滤掉的那部分，RMS 是零点一七九零。"
  },
  {
   "scene": "intuition",
   "index": 12,
   "start": 395.21,
   "dur": 2.77,
   "speech": "手算是零点一七六八。"
  },
  {
   "scene": "intuition",
   "index": 13,
   "start": 398.54,
   "dur": 3.95,
   "speech": "差的那一点，来自十赫兹不在整 bin 上。"
  },
  {
   "scene": "intuition",
   "index": 14,
   "start": 403.04,
   "dur": 4.69,
   "speech": "这就是泄漏：频率对不上格子，能量摊到邻格。"
  },
  {
   "scene": "intuition",
   "index": 15,
   "start": 408.28,
   "dur": 3.04,
   "speech": "格子越稀，泄漏越明显。"
  },
  {
   "scene": "intuition",
   "index": 16,
   "start": 411.87,
   "dur": 2.65,
   "speech": "第二个办法，基展开。"
  },
  {
   "scene": "intuition",
   "index": 17,
   "start": 415.07,
   "dur": 3.85,
   "speech": "不一定是正弦，任何一组函数都行。"
  },
  {
   "scene": "intuition",
   "index": 18,
   "start": 419.48,
   "dur": 4.53,
   "speech": "多项式、傅里叶基、小波，只要能算内积。"
  },
  {
   "scene": "intuition",
   "index": 19,
   "start": 424.55,
   "dur": 3.45,
   "speech": "选一组基，解一个最小二乘。"
  },
  {
   "scene": "intuition",
   "index": 20,
   "start": 428.55,
   "dur": 3.23,
   "speech": "系数就是内积意义下的投影。"
  },
  {
   "scene": "intuition",
   "index": 21,
   "start": 432.33,
   "dur": 5.39,
   "speech": "线性序列，二百五十个点，真值斜率零点一，截距五。"
  },
  {
   "scene": "intuition",
   "index": 22,
   "start": 438.27,
   "dur": 4.33,
   "speech": "拟合出来的系数，是十七点五和十二点五。"
  },
  {
   "scene": "intuition",
   "index": 23,
   "start": 443.15,
   "dur": 5.22,
   "speech": "为什么是这个数？因为基用的是 v 等于二 u 减一。"
  },
  {
   "scene": "intuition",
   "index": 24,
   "start": 448.93,
   "dur": 3.9,
   "speech": "u 从零到一，v 就从负一到一。"
  },
  {
   "scene": "intuition",
   "index": 25,
   "start": 453.38,
   "dur": 4.14,
   "speech": "所以截距落在 v 等于零，也就是中点。"
  },
  {
   "scene": "intuition",
   "index": 26,
   "start": 458.07,
   "dur": 4.17,
   "speech": "残差最大值，七点一乘十的负十五次方。"
  },
  {
   "scene": "intuition",
   "index": 27,
   "start": 462.79,
   "dur": 2.8,
   "speech": "机器精度，等于精确。"
  },
  {
   "scene": "intuition",
   "index": 28,
   "start": 466.13,
   "dur": 2.58,
   "speech": "第三个办法，Patch。"
  },
  {
   "scene": "intuition",
   "index": 29,
   "start": 469.27,
   "dur": 2.63,
   "speech": "不再假设整段平稳。"
  },
  {
   "scene": "intuition",
   "index": 30,
   "start": 472.45,
   "dur": 4.38,
   "speech": "切成固定长度的小段，每段自己一个表示。"
  },
  {
   "scene": "intuition",
   "index": 31,
   "start": 477.38,
   "dur": 3.64,
   "speech": "长度四十八，段长八，步长四。"
  },
  {
   "scene": "intuition",
   "index": 32,
   "start": 481.57,
   "dur": 5.2,
   "speech": "段数等于四十八减八，除以四，向下取整，再加二。"
  },
  {
   "scene": "intuition",
   "index": 33,
   "start": 487.31,
   "dur": 2.89,
   "speech": "四十八个点，一共十二段。"
  },
  {
   "scene": "intuition",
   "index": 34,
   "start": 490.76,
   "dur": 4.19,
   "speech": "最后一段不够八个数，末尾补四个重复值。"
  },
  {
   "scene": "intuition",
   "index": 35,
   "start": 495.5,
   "dur": 4.19,
   "speech": "拼回去的时候，重叠的地方按次数平均。"
  },
  {
   "scene": "intuition",
   "index": 36,
   "start": 500.24,
   "dur": 3.28,
   "speech": "四十八个点，往返误差是零。"
  },
  {
   "scene": "intuition",
   "index": 37,
   "start": 504.07,
   "dur": 3.35,
   "speech": "三种办法，一句话各说一遍。"
  },
  {
   "scene": "intuition",
   "index": 38,
   "start": 507.97,
   "dur": 3.09,
   "speech": "FFT：整段变成频率。"
  },
  {
   "scene": "intuition",
   "index": 39,
   "start": 511.6,
   "dur": 3.47,
   "speech": "基展开：整段变成一组系数。"
  },
  {
   "scene": "intuition",
   "index": 40,
   "start": 515.62,
   "dur": 3.13,
   "speech": "Patch：整段变成很多小段。"
  },
  {
   "scene": "intuition",
   "index": 41,
   "start": 519.31,
   "dur": 5.89,
   "speech": "换坐标之后，局部性、稀疏性、可解释性，各自换了位置。"
  },
  {
   "scene": "definitions",
   "index": 0,
   "start": 528.6,
   "dur": 4,
   "speech": "三个算法，三条签名，三套约定。"
  },
  {
   "scene": "definitions",
   "index": 1,
   "start": 533.15,
   "dur": 2.56,
   "speech": "第一条，FFT。"
  },
  {
   "scene": "definitions",
   "index": 2,
   "start": 536.26,
   "dur": 4.62,
   "speech": "输入一个复数向量，输出同样长度的复数向量。"
  },
  {
   "scene": "definitions",
   "index": 3,
   "start": 541.43,
   "dur": 3.52,
   "speech": "长度必须是二的幂，不是就报错。"
  },
  {
   "scene": "definitions",
   "index": 4,
   "start": 545.5,
   "dur": 3.49,
   "speech": "频带滤波的签名，多一个采样率。"
  },
  {
   "scene": "definitions",
   "index": 5,
   "start": 549.54,
   "dur": 3.37,
   "speech": "频带的单位是赫兹，不是 bin。"
  },
  {
   "scene": "definitions",
   "index": 6,
   "start": 553.46,
   "dur": 2.29,
   "speech": "这个约定很重要。"
  },
  {
   "scene": "definitions",
   "index": 7,
   "start": 556.31,
   "dur": 4.79,
   "speech": "用户说十赫兹，指的是频率，不是第十个格子。"
  },
  {
   "scene": "definitions",
   "index": 8,
   "start": 561.65,
   "dur": 3.9,
   "speech": "正变换不归一化，逆变换除以 N。"
  },
  {
   "scene": "definitions",
   "index": 9,
   "start": 566.1,
   "dur": 4.17,
   "speech": "所以 FFT 再做 IFFT，回到原序列。"
  },
  {
   "scene": "definitions",
   "index": 10,
   "start": 570.82,
   "dur": 3.81,
   "speech": "这条往返恒等式，后面有一条检查。"
  },
  {
   "scene": "definitions",
   "index": 11,
   "start": 575.17,
   "dur": 4.81,
   "speech": "频带之外的能量，用频域掩码清零，再变回去。"
  },
  {
   "scene": "definitions",
   "index": 12,
   "start": 580.54,
   "dur": 3.76,
   "speech": "掩码是硬边，后面会讲它的代价。"
  },
  {
   "scene": "definitions",
   "index": 13,
   "start": 584.84,
   "dur": 4.07,
   "speech": "硬边等价于在频域加了一个矩形窗。"
  },
  {
   "scene": "definitions",
   "index": 14,
   "start": 589.46,
   "dur": 2.44,
   "speech": "第二条，基展开。"
  },
  {
   "scene": "definitions",
   "index": 15,
   "start": 592.45,
   "dur": 3.57,
   "speech": "输入一组基函数，一个观测向量。"
  },
  {
   "scene": "definitions",
   "index": 16,
   "start": 596.57,
   "dur": 2.65,
   "speech": "输出系数和拟合值。"
  },
  {
   "scene": "definitions",
   "index": 17,
   "start": 599.77,
   "dur": 4.17,
   "speech": "第一套约定：基的个数不能超过观测个数。"
  },
  {
   "scene": "definitions",
   "index": 18,
   "start": 604.49,
   "dur": 2.75,
   "speech": "多了，欠定，报错。"
  },
  {
   "scene": "definitions",
   "index": 19,
   "start": 607.79,
   "dur": 3.18,
   "speech": "第二套：设计矩阵必须满秩。"
  },
  {
   "scene": "definitions",
   "index": 20,
   "start": 611.52,
   "dur": 2.85,
   "speech": "不满秩，奇异，报错。"
  },
  {
   "scene": "definitions",
   "index": 21,
   "start": 614.92,
   "dur": 4.89,
   "speech": "第三套：基函数用 v 坐标，v 等于二 u 减一。"
  },
  {
   "scene": "definitions",
   "index": 22,
   "start": 620.35,
   "dur": 2.73,
   "speech": "这样数值条件好得多。"
  },
  {
   "scene": "definitions",
   "index": 23,
   "start": 623.63,
   "dur": 3.93,
   "speech": "实测条件数，归一化之后是七点零。"
  },
  {
   "scene": "definitions",
   "index": 24,
   "start": 628.1,
   "dur": 4.57,
   "speech": "直接用 t 的幂，是三点四乘十的十三次方。"
  },
  {
   "scene": "definitions",
   "index": 25,
   "start": 633.23,
   "dur": 2.41,
   "speech": "差了十二个数量级。"
  },
  {
   "scene": "definitions",
   "index": 26,
   "start": 636.19,
   "dur": 3.54,
   "speech": "同一个拟合问题，只换了一组坐标。"
  },
  {
   "scene": "definitions",
   "index": 27,
   "start": 640.28,
   "dur": 2.34,
   "speech": "第三条，Patch。"
  },
  {
   "scene": "definitions",
   "index": 28,
   "start": 643.18,
   "dur": 4.41,
   "speech": "输入长度、段长、步长，输出一个矩阵。"
  },
  {
   "scene": "definitions",
   "index": 29,
   "start": 648.13,
   "dur": 6.18,
   "speech": "段数公式写死：长度减段长，除以步长，向下取整，再加二。"
  },
  {
   "scene": "definitions",
   "index": 30,
   "start": 654.86,
   "dur": 5.32,
   "speech": "加二的意思是：开头一段，结尾一段，中间按步长走。"
  },
  {
   "scene": "definitions",
   "index": 31,
   "start": 660.73,
   "dur": 4.24,
   "speech": "填充只发生在末尾，填 S 个最后的值。"
  },
  {
   "scene": "definitions",
   "index": 32,
   "start": 665.52,
   "dur": 3.85,
   "speech": "填充不是补零，是把最后一个值重复。"
  },
  {
   "scene": "definitions",
   "index": 33,
   "start": 669.92,
   "dur": 3.25,
   "speech": "三条签名，三个错误类型。"
  },
  {
   "scene": "definitions",
   "index": 34,
   "start": 673.73,
   "dur": 3.73,
   "speech": "错误都用 Either 返回，不抛异常。"
  },
  {
   "scene": "definitions",
   "index": 35,
   "start": 678.01,
   "dur": 3.52,
   "speech": "这样测试可以逐条覆盖错误分支。"
  },
  {
   "scene": "definitions",
   "index": 36,
   "start": 682.08,
   "dur": 2.97,
   "speech": "错误分支也是接口的一部分。"
  },
  {
   "scene": "definitions",
   "index": 37,
   "start": 685.6,
   "dur": 5.03,
   "speech": "后面每一条数字，都对应一个错误分支，或者一条检查。"
  },
  {
   "scene": "implementation",
   "index": 0,
   "start": 694.03,
   "dur": 2.73,
   "speech": "先说 FFT 的实现。"
  },
  {
   "scene": "implementation",
   "index": 1,
   "start": 697.31,
   "dur": 3.78,
   "speech": "位反转置换，然后按级做蝶形。"
  },
  {
   "scene": "implementation",
   "index": 2,
   "start": 701.64,
   "dur": 4.21,
   "speech": "旋转因子每二百五十六个蝶形重算一次。"
  },
  {
   "scene": "implementation",
   "index": 3,
   "start": 706.4,
   "dur": 4.79,
   "speech": "这样内存占用小，代价是多算几次三角函数。"
  },
  {
   "scene": "implementation",
   "index": 4,
   "start": 711.74,
   "dur": 4.29,
   "speech": "用 ST 可变向量，原地做，不复制。"
  },
  {
   "scene": "implementation",
   "index": 5,
   "start": 716.58,
   "dur": 3.57,
   "speech": "代价是代码不再是纯函数式的。"
  },
  {
   "scene": "implementation",
   "index": 6,
   "start": 720.69,
   "dur": 3.61,
   "speech": "结果是复数向量，长度不变。"
  },
  {
   "scene": "implementation",
   "index": 7,
   "start": 724.86,
   "dur": 4.09,
   "speech": "和朴素 DFT 对比，一千零二十四个点。"
  },
  {
   "scene": "implementation",
   "index": 8,
   "start": 729.5,
   "dur": 3.81,
   "speech": "最大误差，一点二二乘十的负十次方。"
  },
  {
   "scene": "implementation",
   "index": 9,
   "start": 733.86,
   "dur": 3.78,
   "speech": "在这台机器上，这就是浮点噪声。"
  },
  {
   "scene": "implementation",
   "index": 10,
   "start": 738.19,
   "dur": 4.43,
   "speech": "两个实现的结果，在误差范围内是同一个。"
  },
  {
   "scene": "implementation",
   "index": 11,
   "start": 743.17,
   "dur": 4.67,
   "speech": "频带滤波：先把频带外的 bin 清零，再变回去。"
  },
  {
   "scene": "implementation",
   "index": 12,
   "start": 748.39,
   "dur": 2.82,
   "speech": "掩码是硬边，不是窗。"
  },
  {
   "scene": "implementation",
   "index": 13,
   "start": 751.76,
   "dur": 4.38,
   "speech": "硬边会带来振铃，这是边界那节要说的事。"
  },
  {
   "scene": "implementation",
   "index": 14,
   "start": 756.69,
   "dur": 4.02,
   "speech": "振铃不是 bug，是矩形窗的傅里叶变换。"
  },
  {
   "scene": "implementation",
   "index": 15,
   "start": 761.27,
   "dur": 3.09,
   "speech": "再说第二个办法，基展开。"
  },
  {
   "scene": "implementation",
   "index": 16,
   "start": 764.9,
   "dur": 3.16,
   "speech": "设计矩阵，一列一个基函数。"
  },
  {
   "scene": "implementation",
   "index": 17,
   "start": 768.61,
   "dur": 4.36,
   "speech": "正规方程，矩阵乘转置，解线性系统。"
  },
  {
   "scene": "implementation",
   "index": 18,
   "start": 773.52,
   "dur": 4.09,
   "speech": "Cholesky 分解，只对对称正定矩阵有效。"
  },
  {
   "scene": "implementation",
   "index": 19,
   "start": 778.16,
   "dur": 3.23,
   "speech": "所以先检查秩，再分解。"
  },
  {
   "scene": "implementation",
   "index": 20,
   "start": 781.94,
   "dur": 4.43,
   "speech": "系数出来之后，拟合值是设计矩阵乘系数。"
  },
  {
   "scene": "implementation",
   "index": 21,
   "start": 786.92,
   "dur": 2.97,
   "speech": "残差是观测减拟合值。"
  },
  {
   "scene": "implementation",
   "index": 22,
   "start": 790.44,
   "dur": 3.78,
   "speech": "真实数据上，前二百五十个收盘价。"
  },
  {
   "scene": "implementation",
   "index": 23,
   "start": 794.77,
   "dur": 4.69,
   "speech": "三次多项式拟合，残差最大值九十七点一一。"
  },
  {
   "scene": "implementation",
   "index": 24,
   "start": 800.01,
   "dur": 4.74,
   "speech": "这个数看着大，但价格本身在五百到两千之间。"
  },
  {
   "scene": "implementation",
   "index": 25,
   "start": 805.31,
   "dur": 4.84,
   "speech": "重建误差是零：拟合值加残差，精确等于观测。"
  },
  {
   "scene": "implementation",
   "index": 26,
   "start": 810.69,
   "dur": 3.37,
   "speech": "这条是恒等式，不是拟合得好。"
  },
  {
   "scene": "implementation",
   "index": 27,
   "start": 814.62,
   "dur": 4.09,
   "speech": "所以重建误差这个数，永远接近零。"
  },
  {
   "scene": "implementation",
   "index": 28,
   "start": 819.26,
   "dur": 2.1,
   "speech": "最后说 Patch。"
  },
  {
   "scene": "implementation",
   "index": 29,
   "start": 821.91,
   "dur": 3.57,
   "speech": "填充：末尾补 S 个最后的值。"
  },
  {
   "scene": "implementation",
   "index": 30,
   "start": 826.03,
   "dur": 3.73,
   "speech": "四十八个点，补四个，变五十二个。"
  },
  {
   "scene": "implementation",
   "index": 31,
   "start": 830.31,
   "dur": 4.26,
   "speech": "按步长四切，正好十二段，每段八个点。"
  },
  {
   "scene": "implementation",
   "index": 32,
   "start": 835.13,
   "dur": 4.05,
   "speech": "拼回去：重叠的点按覆盖次数平均。"
  },
  {
   "scene": "implementation",
   "index": 33,
   "start": 839.72,
   "dur": 3.47,
   "speech": "原来的四十八个点，全部被覆盖。"
  },
  {
   "scene": "implementation",
   "index": 34,
   "start": 843.74,
   "dur": 3.01,
   "speech": "拼回来，往返误差是零。"
  },
  {
   "scene": "implementation",
   "index": 35,
   "start": 847.31,
   "dur": 4.21,
   "speech": "这个零是精确的，因为每一步都是线性操作。"
  },
  {
   "scene": "implementation",
   "index": 36,
   "start": 852.07,
   "dur": 4.12,
   "speech": "但它依赖填充和覆盖次数正好对上。"
  },
  {
   "scene": "implementation",
   "index": 37,
   "start": 856.74,
   "dur": 2.99,
   "speech": "三种实现，三种代价。"
  },
  {
   "scene": "implementation",
   "index": 38,
   "start": 860.28,
   "dur": 3.73,
   "speech": "FFT 快，但要求长度是二的幂。"
  },
  {
   "scene": "implementation",
   "index": 39,
   "start": 864.56,
   "dur": 3.66,
   "speech": "基展开准，但要解一个线性系统。"
  },
  {
   "scene": "implementation",
   "index": 40,
   "start": 868.77,
   "dur": 3.09,
   "speech": "Patch 灵活，但要处理边界。"
  },
  {
   "scene": "implementation",
   "index": 41,
   "start": 872.41,
   "dur": 3.59,
   "speech": "这些代价，都会在数字那节出现。"
  },
  {
   "scene": "verification",
   "index": 0,
   "start": 879.4,
   "dur": 2.97,
   "speech": "五十五条检查，零失败。"
  },
  {
   "scene": "verification",
   "index": 1,
   "start": 882.92,
   "dur": 4.81,
   "speech": "十五条手算，七条真实数据，三十三条合成。"
  },
  {
   "scene": "verification",
   "index": 2,
   "start": 888.28,
   "dur": 3.21,
   "speech": "三条证据文件，按算法分。"
  },
  {
