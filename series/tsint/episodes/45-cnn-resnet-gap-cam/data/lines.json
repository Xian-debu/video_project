  {
   "scene": "definitions",
   "index": 14,
   "start": 366.3,
   "dur": 1.55,
   "speech": "池化把长度减半，也把「在哪里」变成「有没有」。"
  },
  {
   "scene": "definitions",
   "index": 15,
   "start": 368.03,
   "dur": 2.99,
   "speech": "位置信息，从这里开始丢。"
  },
