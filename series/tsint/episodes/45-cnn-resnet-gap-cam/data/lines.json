   "start": 402.08,
   "dur": 2.53,
   "speech": "卷积有两种做法。"
  },
  {
   "scene": "definitions",
   "index": 25,
   "start": 404.79,
   "dur": 4.45,
   "speech": "通道独立：每个通道各卷各的，最后拼起来。"
  },
  {
   "scene": "definitions",
   "index": 26,
   "start": 409.42,
   "dur": 3.78,
   "speech": "通道依赖：同一个核同时看五个通道。"
  },
  {
   "scene": "definitions",
   "index": 27,
   "start": 413.39,
   "dur": 4.14,
   "speech": "前者参数少，后者能学通道间的关系。"
  },
  {
   "scene": "definitions",
   "index": 28,
   "start": 417.71,
   "dur": 2.89,
   "speech": "我们的网络用通道依赖。"
  },
  {
   "scene": "definitions",
   "index": 29,
   "start": 420.78,
   "dur": 3.04,
   "speech": "输入 5 个通道，输出 16 个。"
  },
  {
   "scene": "definitions",
   "index": 30,
   "start": 424,
   "dur": 3.4,
   "speech": "一个核是 5 乘 8，四十个权重。"
  },
  {
   "scene": "definitions",
   "index": 31,
   "start": 427.58,
   "dur": 3.66,
   "speech": "参数不多，但关系要数据来教。"
  },
  {
   "scene": "definitions",
   "index": 32,
   "start": 431.42,
   "dur": 3.54,
   "speech": "第四个模块是全局平均池化。"
  },
  {
   "scene": "definitions",
   "index": 33,
   "start": 435.14,
   "dur": 3.78,
   "speech": "它对时间维取平均，不管序列多长。"
  },
  {
   "scene": "definitions",
   "index": 34,
   "start": 439.1,
   "dur": 3.25,
   "speech": "一二三四，平均是二点五。"
  },
  {
   "scene": "definitions",
   "index": 35,
   "start": 442.54,
   "dur": 3.88,
   "speech": "GAP 等于 2.5，这是第二个黄金值。"
  },
  {
   "scene": "definitions",
   "index": 36,
   "start": 446.6,
   "dur": 5.1,
   "speech": "好处是：同一套权重，吃 60 步和 120 步都行。"
  },
  {
   "scene": "definitions",
   "index": 37,
   "start": 451.88,
   "dur": 2.94,
   "speech": "输出都是三个 logits。"
  },
  {
   "scene": "definitions",
   "index": 38,
   "start": 455,
   "dur": 3.81,
   "speech": "坏处也明显：时间顺序被平均掉了。"
  },
  {
   "scene": "definitions",
   "index": 39,
   "start": 458.99,
   "dur": 3.83,
   "speech": "所以它必须配 CAM，把顺序找回来。"
  },
  {
   "scene": "definitions",
   "index": 40,
   "start": 463,
   "dur": 2.65,
   "speech": "CAM 是一行加权和。"
  },
  {
   "scene": "definitions",
   "index": 41,
   "start": 465.83,
   "dur": 3.78,
   "speech": "分类头的权重，乘回每个位置的通道。"
  },
  {
   "scene": "definitions",
   "index": 42,
   "start": 469.79,
   "dur": 5.75,
   "speech": "权重取零点五，四个位置：零点五、一、一点五、二。"
  },
  {
   "scene": "definitions",
   "index": 43,
   "start": 475.72,
   "dur": 2.61,
   "speech": "再做 min-max 归一化。"
  },
  {
   "scene": "definitions",
   "index": 44,
   "start": 478.51,
   "dur": 3.88,
   "speech": "零、三分之一、三分之二、一。"
  },
  {
   "scene": "definitions",
   "index": 45,
   "start": 482.57,
   "dur": 5.37,
   "speech": "屏幕上是零、零点三三三三、零点六六六七、一。"
  },
  {
   "scene": "definitions",
   "index": 46,
   "start": 488.11,
   "dur": 3.37,
   "speech": "这就是 CAM 归一化四元组。"
  },
  {
   "scene": "definitions",
   "index": 47,
   "start": 491.67,
   "dur": 4.69,
   "speech": "它只对「GAP 加单层线性头」成立，偏置不参与。"
  },
  {
   "scene": "metrics",
   "index": 0,
   "start": 499.76,
   "dur": 1.89,
   "speech": "先定口径。"
  },
  {
   "scene": "metrics",
   "index": 1,
   "start": 501.83,
   "dur": 3.49,
   "speech": "300 只股票，三行业各 100。"
  },
  {
   "scene": "metrics",
   "index": 2,
   "start": 505.5,
   "dur": 4.14,
   "speech": "每只取四个窗口，一共 1,178 个。"
  },
  {
   "scene": "metrics",
   "index": 3,
   "start": 509.82,
   "dur": 4.55,
   "speech": "按股票切分，240 只训练，60 只测试。"
  },
  {
   "scene": "metrics",
   "index": 4,
   "start": 514.55,
   "dur": 4.21,
   "speech": "训练 945 窗，测试 233 窗。"
  },
  {
   "scene": "metrics",
   "index": 5,
   "start": 518.95,
   "dur": 4.31,
   "speech": "每个窗口 60 步、5 个字段，各自标准化。"
  },
  {
   "scene": "metrics",
   "index": 6,
   "start": 523.44,
   "dur": 3.21,
   "speech": "三分类，随机猜三分之一。"
  },
  {
   "scene": "metrics",
   "index": 7,
   "start": 526.82,
   "dur": 3.18,
   "speech": "所有模型都吃同一批窗口。"
  },
  {
   "scene": "metrics",
   "index": 8,
   "start": 530.18,
   "dur": 3.09,
   "speech": "差别只在模型，不在数据。"
  },
  {
   "scene": "metrics",
   "index": 9,
   "start": 533.45,
   "dur": 2.56,
   "speech": "四个模型摆在一起。"
  },
  {
   "scene": "metrics",
   "index": 10,
   "start": 536.19,
   "dur": 3.54,
   "speech": "线性 softmax：零点五四九四。"
  },
  {
   "scene": "metrics",
   "index": 11,
   "start": 539.91,
   "dur": 4.38,
   "speech": "卷积：零点五八八零，训练集零点八二。"
  },
  {
   "scene": "metrics",
   "index": 12,
   "start": 544.47,
   "dur": 3.16,
   "speech": "四块残差：零点六二六六。"
  },
  {
   "scene": "metrics",
   "index": 13,
   "start": 547.81,
   "dur": 3.18,
   "speech": "一块残差：零点六六零九。"
  },
  {
   "scene": "metrics",
   "index": 14,
   "start": 551.17,
   "dur": 3.06,
   "speech": "GAP-CAM：零点四八九三。"
  },
  {
   "scene": "metrics",
   "index": 15,
   "start": 554.41,
   "dur": 2.87,
   "speech": "最高的是最浅的残差。"
  },
  {
   "scene": "metrics",
   "index": 16,
   "start": 557.46,
   "dur": 3.23,
   "speech": "卷积比线性高三点九个点。"
  },
  {
   "scene": "metrics",
   "index": 17,
   "start": 560.87,
   "dur": 3.01,
   "speech": "这是卷积唯一明确的收益。"
  },
  {
   "scene": "metrics",
   "index": 18,
   "start": 564.07,
   "dur": 2.68,
   "speech": "残差这组要单独看。"
  },
  {
   "scene": "metrics",
   "index": 19,
   "start": 566.93,
   "dur": 5.1,
   "speech": "四块：训练零点八二五四，测试零点六二六六。"
  },
  {
   "scene": "metrics",
   "index": 20,
   "start": 572.21,
   "dur": 2.7,
   "speech": "中间差了将近两毛。"
  },
  {
   "scene": "metrics",
   "index": 21,
   "start": 575.09,
   "dur": 3.23,
   "speech": "一块：测试零点六六零九。"
  },
  {
   "scene": "metrics",
   "index": 22,
   "start": 578.5,
   "dur": 2.77,
   "speech": "参数少，反而泛化好。"
  },
  {
   "scene": "metrics",
   "index": 23,
   "start": 581.45,
   "dur": 3.95,
   "speech": "窗口只有 60 步，样本只有一千出头。"
  },
  {
   "scene": "metrics",
   "index": 24,
   "start": 585.58,
   "dur": 3.61,
   "speech": "深网没有足够的数据去用它的容量。"
  },
  {
   "scene": "metrics",
   "index": 25,
   "start": 589.38,
   "dur": 4.07,
   "speech": "加深不等于更强，这一集按实测讲。"
  },
  {
   "scene": "metrics",
   "index": 26,
   "start": 593.63,
   "dur": 3.85,
   "speech": "书的结论有前提，前提是数据够。"
  },
  {
   "scene": "metrics",
   "index": 27,
   "start": 597.66,
   "dur": 2.53,
   "speech": "还有一个数要先说。"
  },
  {
   "scene": "metrics",
   "index": 28,
   "start": 600.38,
   "dur": 4.6,
   "speech": "五个字段两两相关，平均绝对值零点七五。"
  },
  {
   "scene": "metrics",
   "index": 29,
   "start": 605.15,
   "dur": 5.13,
   "speech": "开盘、最高、最低、收盘，本来就捆在一起。"
  },
  {
   "scene": "metrics",
   "index": 30,
   "start": 610.46,
   "dur": 2.7,
   "speech": "成交量稍微独立一点。"
  },
  {
   "scene": "metrics",
   "index": 31,
   "start": 613.34,
   "dur": 4.96,
   "speech": "卷积的通道依赖，本该从五个通道里学互补信息。"
  },
  {
   "scene": "metrics",
   "index": 32,
   "start": 618.48,
   "dur": 3.45,
   "speech": "在这批数据上，互补信息不多。"
  },
  {
   "scene": "metrics",
   "index": 33,
   "start": 622.11,
   "dur": 3.54,
   "speech": "所以多通道的收益，被高估了。"
  },
  {
   "scene": "metrics",
   "index": 34,
   "start": 625.83,
   "dur": 2.34,
   "speech": "这一条写进边界。"
  },
  {
   "scene": "metrics",
   "index": 35,
   "start": 628.35,
   "dur": 3.49,
   "speech": "不是实现错，是数据本身冗余。"
  },
  {
   "scene": "metrics",
   "index": 36,
   "start": 632.02,
   "dur": 2.56,
   "speech": "训练过程也要看一眼。"
  },
  {
   "scene": "metrics",
   "index": 37,
   "start": 634.76,
   "dur": 5.61,
   "speech": "卷积十二轮，损失从零点八二八三降到零点二八三一。"
  },
  {
   "scene": "metrics",
   "index": 38,
   "start": 640.55,
   "dur": 4.79,
   "speech": "残差十五轮，零点八六二八到零点二九三零。"
  },
  {
   "scene": "metrics",
   "index": 39,
   "start": 645.52,
   "dur": 4.98,
   "speech": "GAP-CAM 三十轮，一点一一一三只降到零点九九九。"
  },
  {
   "scene": "metrics",
   "index": 40,
   "start": 650.68,
   "dur": 2.2,
   "speech": "损失几乎没动。"
  },
  {
   "scene": "metrics",
   "index": 41,
   "start": 653.06,
   "dur": 4.12,
   "speech": "它容量太小：单层卷积、十六个通道。"
  },
  {
   "scene": "metrics",
   "index": 42,
   "start": 657.36,
   "dur": 3.54,
   "speech": "它学到的是弱信号，不是强规律。"
  },
  {
   "scene": "metrics",
   "index": 43,
   "start": 661.08,
   "dur": 2.51,
   "speech": "这条也写进边界。"
  },
  {
   "scene": "implementation",
   "index": 0,
   "start": 666.99,
   "dur": 3.3,
   "speech": "三个模块，四十二条新断言。"
  },
  {
   "scene": "implementation",
   "index": 1,
   "start": 670.47,
   "dur": 4.48,
   "speech": "Cnn 管卷积、池化、反传，十九条。"
  },
  {
   "scene": "implementation",
   "index": 2,
   "start": 675.13,
   "dur": 3.76,
   "speech": "ResNet 管残差块和深网，十条。"
  },
  {
   "scene": "implementation",
   "index": 3,
   "start": 679.07,
   "dur": 4.26,
   "speech": "GapCam 管 GAP、CAM 和训练，十三条。"
  },
  {
   "scene": "implementation",
   "index": 4,
   "start": 683.51,
   "dur": 4.89,
   "speech": "全仓现在是 142 套、1,938 条断言。"
  },
  {
   "scene": "implementation",
   "index": 5,
   "start": 688.58,
   "dur": 2.44,
   "speech": "三套 spec 全绿。"
  },
  {
   "scene": "implementation",
   "index": 6,
   "start": 691.19,
   "dur": 3.3,
   "speech": "下面挑三个容易写错的地方讲。"
  },
  {
   "scene": "implementation",
   "index": 7,
   "start": 694.68,
   "dur": 3.16,
   "speech": "每一个都用数值梯度校过。"
  },
  {
   "scene": "implementation",
   "index": 8,
   "start": 698.01,
   "dur": 3.04,
   "speech": "维度账在代码里是显式的。"
  },
  {
   "scene": "implementation",
   "index": 9,
   "start": 701.23,
   "dur": 4.19,
   "speech": "卷积层记输入通道、输出通道、核长。"
  },
  {
   "scene": "implementation",
   "index": 10,
   "start": 705.6,
   "dur": 3.23,
   "speech": "池化只记窗口，不记参数。"
  },
  {
   "scene": "implementation",
   "index": 11,
   "start": 709.01,
   "dur": 6.25,
   "speech": "前向一路带着形状走：60、53、26、19、9。"
  },
  {
   "scene": "implementation",
   "index": 12,
   "start": 715.45,
   "dur": 3.81,
   "speech": "展平 9 乘 32，等于 288。"
  },
  {
   "scene": "implementation",
   "index": 13,
   "start": 719.43,
   "dur": 3.37,
   "speech": "分类头 288 进，3 出。"
  },
  {
   "scene": "implementation",
   "index": 14,
   "start": 722.99,
   "dur": 3.21,
   "speech": "形状写错，第一层就会报错。"
  },
  {
   "scene": "implementation",
   "index": 15,
   "start": 726.37,
   "dur": 3.66,
   "speech": "这比训到一半发现不收敛便宜得多。"
  },
  {
   "scene": "implementation",
   "index": 16,
   "start": 730.21,
   "dur": 2.39,
   "speech": "反传有两个坑。"
  },
  {
   "scene": "implementation",
   "index": 17,
   "start": 732.78,
   "dur": 2.13,
   "speech": "第一个是池化。"
  },
  {
   "scene": "implementation",
   "index": 18,
   "start": 735.09,
   "dur": 3.78,
   "speech": "梯度只回最大值那个位置，其余是零。"
  },
  {
   "scene": "implementation",
   "index": 19,
   "start": 739.05,
   "dur": 4.74,
   "speech": "所以前向要记下 argmax，反传按表路由。"
  },
  {
   "scene": "implementation",
   "index": 20,
   "start": 743.97,
   "dur": 2.2,
   "speech": "第二个是卷积。"
  },
  {
   "scene": "implementation",
   "index": 21,
   "start": 746.35,
   "dur": 4.09,
   "speech": "对输入是 full 卷积，对权重是互相关。"
  },
  {
   "scene": "implementation",
   "index": 22,
   "start": 750.63,
   "dur": 4.53,
   "speech": "第一版把两者写成同一个函数，梯度差了三倍。"
  },
  {
   "scene": "implementation",
   "index": 23,
   "start": 755.33,
   "dur": 4.26,
   "speech": "数值梯度校到十的负十一次方，才算过。"
  },
  {
   "scene": "implementation",
   "index": 24,
   "start": 759.77,
   "dur": 2.41,
   "speech": "第三个坑更隐蔽。"
  },
  {
   "scene": "implementation",
   "index": 25,
   "start": 762.37,
   "dur": 4.6,
   "speech": "六层 ReLU 的网络，训练损失停在零点六九。"
  },
  {
   "scene": "implementation",
   "index": 26,
   "start": 767.15,
   "dur": 2.25,
   "speech": "正好是 log 二。"
  },
  {
   "scene": "implementation",
   "index": 27,
   "start": 769.57,
   "dur": 3.59,
   "speech": "查下去：第一层隐层输出全是零。"
  },
  {
   "scene": "implementation",
   "index": 28,
   "start": 773.34,
   "dur": 4.45,
   "speech": "ReLU 一旦整层死掉，梯度就再也回不来。"
  },
  {
   "scene": "implementation",
   "index": 29,
   "start": 777.98,
   "dur": 3.16,
   "speech": "修法是把偏置抬高一点。"
  },
  {
   "scene": "implementation",
   "index": 30,
   "start": 781.31,
   "dur": 3.23,
   "speech": "隐层零点一，主干零点五。"
  },
  {
   "scene": "implementation",
   "index": 31,
   "start": 784.72,
   "dur": 3.01,
   "speech": "之后损失才开始下降。"
  },
  {
   "scene": "implementation",
   "index": 32,
   "start": 787.92,
   "dur": 2.53,
   "speech": "训练循环是两层。"
  },
  {
   "scene": "implementation",
   "index": 33,
   "start": 790.63,
   "dur": 2.99,
   "speech": "外层轮数，内层小批量。"
  },
  {
   "scene": "implementation",
   "index": 34,
   "start": 793.8,
   "dur": 5.15,
   "speech": "每个批量：前向、算交叉熵、反传、Adam 更新。"
  },
  {
   "scene": "implementation",
   "index": 35,
   "start": 799.13,
   "dur": 4.91,
   "speech": "卷积层、池化层、线性头，梯度一路传回去。"
  },
  {
   "scene": "implementation",
   "index": 36,
   "start": 804.22,
   "dur": 3.83,
   "speech": "批量为三十二，学习率零点零零五。"
  },
  {
   "scene": "implementation",
   "index": 37,
   "start": 808.23,
   "dur": 3.47,
   "speech": "每轮开始前打乱一次样本顺序。"
  },
  {
   "scene": "implementation",
   "index": 38,
   "start": 811.88,
   "dur": 3.45,
   "speech": "损失每轮记一次，画成曲线。"
  },
  {
   "scene": "implementation",
   "index": 39,
   "start": 815.51,
   "dur": 3.83,
   "speech": "曲线不降，先查梯度，别调超参。"
  },
  {
   "scene": "implementation",
   "index": 40,
   "start": 819.52,
   "dur": 2.39,
   "speech": "训练配方很朴素。"
  },
  {
   "scene": "implementation",
   "index": 41,
   "start": 822.09,
   "dur": 4.21,
   "speech": "Adam，学习率零点零零五，批量三十二。"
  },
  {
   "scene": "implementation",
   "index": 42,
   "start": 826.48,
   "dur": 3.04,
   "speech": "卷积跑十二轮，七十二秒。"
  },
  {
   "scene": "implementation",
   "index": 43,
