   "scene": "definitions",
   "index": 1,
   "start": 319.64,
   "dur": 4.21,
   "speech": "输入四个点：一、二、三、四。"
  },
  {
   "scene": "definitions",
   "index": 2,
   "start": 324.03,
   "dur": 3.23,
   "speech": "核长三：一、零、负一。"
  },
  {
   "scene": "definitions",
   "index": 3,
   "start": 327.44,
   "dur": 1.72,
   "speech": "偏置零。"
  },
  {
   "scene": "definitions",
   "index": 4,
   "start": 329.34,
   "dur": 5.65,
   "speech": "第一个位置：一乘一，加二乘零，加三乘负一，等于负二。"
  },
  {
   "scene": "definitions",
   "index": 5,
   "start": 335.17,
   "dur": 3.45,
   "speech": "第二个位置：二减四，还是负二。"
  },
  {
   "scene": "definitions",
   "index": 6,
   "start": 338.8,
   "dur": 3.33,
   "speech": "输出就两个数：负二、负二。"
  },
  {
   "scene": "definitions",
   "index": 7,
   "start": 342.31,
   "dur": 3.81,
   "speech": "长 4 减核长 3，加一，正好 2。"
  },
  {
   "scene": "definitions",
   "index": 8,
   "start": 346.29,
   "dur": 3.18,
   "speech": "池化是把两个位置并成一个。"
  },
  {
   "scene": "definitions",
   "index": 9,
   "start": 349.65,
   "dur": 3.83,
   "speech": "取最大：窗口里一和三，留三。"
  },
  {
   "scene": "definitions",
   "index": 10,
   "start": 353.66,
   "dur": 2.37,
   "speech": "二和五，留五。"
  },
  {
   "scene": "definitions",
   "index": 11,
   "start": 356.21,
   "dur": 2.13,
   "speech": "输出三和五。"
  },
  {
   "scene": "definitions",
   "index": 12,
   "start": 358.52,
   "dur": 3.49,
   "speech": "如果两个一样大，取最左边那个。"
  },
