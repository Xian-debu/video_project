   "scene": "metrics",
   "index": 16,
   "start": 532.67,
   "dur": 3.66,
   "speech": "组合预测器一万次，但只用四块。"
  },
  {
   "scene": "metrics",
   "index": 17,
   "start": 536.51,
   "dur": 2.7,
   "speech": "比较器的性价比最高。"
  },
