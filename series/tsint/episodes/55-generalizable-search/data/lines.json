   "index": 28,
   "start": 431.26,
   "dur": 4.24,
   "speech": "老参数乘系数，新参数乘一减系数。"
  },
  {
   "scene": "definitions",
   "index": 29,
   "start": 435.67,
   "dur": 2.63,
   "speech": "这就是式 6.16。"
  },
  {
   "scene": "definitions",
   "index": 30,
   "start": 438.48,
   "dur": 2.82,
   "speech": "三个黄金值，先记住。"
  },
  {
   "scene": "definitions",
   "index": 31,
   "start": 441.49,
   "dur": 2.75,
   "speech": "子空间：样本零二四。"
  },
  {
   "scene": "definitions",
   "index": 32,
   "start": 444.42,
   "dur": 3.37,
   "speech": "均值二，标准差一点六三三。"
  },
  {
   "scene": "definitions",
   "index": 33,
   "start": 447.97,
   "dur": 4.24,
   "speech": "下界零点三六七，上界三点六三三。"
  },
  {
   "scene": "definitions",
   "index": 34,
   "start": 452.39,
   "dur": 4.77,
   "speech": "排序零点九、零点五、零点七、零点三。"
  },
  {
   "scene": "definitions",
   "index": 35,
   "start": 457.33,
   "dur": 4.05,
   "speech": "按分数从高到低，编号是一三二四。"
  },
  {
   "scene": "definitions",
   "index": 36,
   "start": 461.56,
   "dur": 2.97,
   "speech": "剪枝：八块分数一到八。"
  },
  {
   "scene": "definitions",
   "index": 37,
   "start": 464.71,
   "dur": 2.94,
   "speech": "留一半，就是五六七八。"
  },
  {
   "scene": "definitions",
   "index": 38,
   "start": 467.83,
   "dur": 3.69,
   "speech": "继承：老参数一二，新参数三四。"
  },
  {
   "scene": "definitions",
   "index": 39,
   "start": 471.69,
   "dur": 3.97,
   "speech": "系数零点七，得到一点六和二点六。"
  },
  {
   "scene": "metrics",
   "index": 0,
   "start": 479.07,
   "dur": 4,
   "speech": "六组，三十三项，四点八三秒。"
  },
  {
   "scene": "metrics",
   "index": 1,
   "start": 483.25,
   "dur": 3.11,
   "speech": "先看合成空间的四个读数。"
