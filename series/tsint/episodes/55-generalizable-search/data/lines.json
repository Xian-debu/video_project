   "scene": "metrics",
   "index": 4,
   "start": 493.14,
   "dur": 3.01,
   "speech": "比较器，三点九零七二。"
  },
  {
   "scene": "metrics",
   "index": 5,
   "start": 496.34,
   "dur": 3.4,
   "speech": "组合预测器，三点九一八三。"
  },
  {
   "scene": "metrics",
   "index": 6,
   "start": 499.91,
   "dur": 3.45,
   "speech": "阈值三点三零一四，全部越线。"
  },
