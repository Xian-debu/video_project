   "scene": "definitions",
   "index": 11,
   "start": 375.81,
   "dur": 2.82,
   "speech": "两个架构，各有一个分数。"
  },
  {
   "scene": "definitions",
   "index": 12,
   "start": 378.81,
   "dur": 3.16,
   "speech": "我们不看分数，只看谁高。"
  },
  {
   "scene": "definitions",
   "index": 13,
   "start": 382.15,
   "dur": 3.21,
   "speech": "把两个架构的差，当成输入。"
  },
  {
   "scene": "definitions",
   "index": 14,
   "start": 385.53,
   "dur": 2.77,
   "speech": "把谁高，当成标签。"
  },
  {
   "scene": "definitions",
   "index": 15,
   "start": 388.49,
   "dur": 3.33,
   "speech": "用岭回归，学一个线性比较器。"
  },
  {
   "scene": "definitions",
   "index": 16,
   "start": 391.99,
   "dur": 3.69,
   "speech": "打分函数，就是参数的加权和。"
  },
  {
   "scene": "definitions",
   "index": 17,
   "start": 395.86,
   "dur": 3.76,
   "speech": "排序用归并，比较器说谁在前。"
  },
  {
   "scene": "definitions",
   "index": 18,
   "start": 399.8,
   "dur": 3.33,
   "speech": "稳定排序，相同分数不乱序。"
  },
  {
   "scene": "definitions",
   "index": 19,
   "start": 403.3,
   "dur": 2.61,
   "speech": "这就是式 6.15。"
  },
  {
   "scene": "definitions",
   "index": 20,
   "start": 406.09,
   "dur": 3.42,
   "speech": "第三条，组合预测器怎么剪。"
  },
  {
   "scene": "definitions",
   "index": 21,
   "start": 409.69,
   "dur": 3.37,
   "speech": "每个子空间，有若干已评点。"
  },
  {
   "scene": "definitions",
   "index": 22,
   "start": 413.24,
   "dur": 3.21,
   "speech": "取平均分，作为这块的预测。"
  },
  {
   "scene": "definitions",
   "index": 23,
   "start": 416.63,
   "dur": 2.8,
   "speech": "按预测从高到低排。"
  },
  {
   "scene": "definitions",
   "index": 24,
   "start": 419.61,
   "dur": 2.65,
   "speech": "留下前面的一个比例。"
  },
  {
   "scene": "definitions",
   "index": 25,
   "start": 422.44,
   "dur": 2.97,
   "speech": "比例零点五，就是留一半。"
  },
  {
   "scene": "definitions",
   "index": 26,
   "start": 425.59,
   "dur": 2.15,
   "speech": "八块留四块。"
  },
  {
   "scene": "definitions",
   "index": 27,
   "start": 427.92,
   "dur": 3.16,
   "speech": "留下之后，参数还可以继承。"
  },
  {
