  },
  {
   "scene": "implementation",
   "index": 24,
   "start": 730.43,
   "dur": 3.35,
   "speech": "留下前一个比例，至少留一个。"
  },
  {
   "scene": "implementation",
   "index": 25,
   "start": 733.96,
   "dur": 3.59,
   "speech": "返回时按索引升序，方便复现。"
  },
  {
   "scene": "implementation",
   "index": 26,
   "start": 737.73,
   "dur": 3.37,
