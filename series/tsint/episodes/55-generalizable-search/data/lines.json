   "scene": "metrics",
   "index": 2,
   "start": 486.54,
   "dur": 3.33,
   "speech": "随机基线，三点七七五九。"
  },
  {
   "scene": "metrics",
   "index": 3,
   "start": 490.04,
   "dur": 2.92,
   "speech": "子空间，三点八七八。"
  },
