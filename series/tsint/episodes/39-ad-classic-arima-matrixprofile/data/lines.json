  {
   "scene": "definitions",
   "index": 0,
   "start": 249.46,
   "dur": 4.33,
   "speech": "先写 ARIMA，式(4.41) 的位置。"
  },
  {
   "scene": "definitions",
   "index": 1,
   "start": 253.97,
   "dur": 3.83,
   "speech": "非书中：书只写了「ARIMA」三个字母。"
  },
  {
   "scene": "definitions",
   "index": 2,
   "start": 257.98,
   "dur": 5.77,
   "speech": "phi(B) 乘 (1-B) 的 d 次方，再乘 y_t。"
  },
  {
   "scene": "definitions",
   "index": 3,
   "start": 263.94,
   "dur": 4.45,
   "speech": "等于 c 加 theta(B) 乘 eps_t。"
  },
  {
   "scene": "definitions",
   "index": 4,
   "start": 268.57,
   "dur": 4,
   "speech": "B 是滞后算子，eps 是白噪声。"
  },
  {
   "scene": "definitions",
   "index": 5,
   "start": 272.75,
   "dur": 3.4,
   "speech": "d 是差分阶数，把趋势磨平。"
  },
  {
   "scene": "definitions",
   "index": 6,
   "start": 276.33,
   "dur": 2.85,
   "speech": "残差从拟合里递推出来。"
  },
  {
   "scene": "definitions",
   "index": 7,
   "start": 279.35,
   "dur": 4.05,
   "speech": "分数取绝对值，除以训练段 sigma。"
  },
  {
   "scene": "definitions",
   "index": 8,
   "start": 283.58,
   "dur": 3.16,
   "speech": "阶数怎么定：AIC 网格。"
  },
  {
   "scene": "definitions",
   "index": 9,
   "start": 286.92,
   "dur": 4.84,
   "speech": "p 从零到三，d 取零或一，q 从零到二。"
  },
  {
   "scene": "definitions",
   "index": 10,
   "start": 291.94,
   "dur": 4.55,
   "speech": "最后选中的是 ARIMA(0,0,2)。"
  },
  {
   "scene": "definitions",
   "index": 11,
   "start": 296.67,
   "dur": 3.49,
   "speech": "两阶移动平均，没有自回归项。"
  },
  {
   "scene": "definitions",
   "index": 12,
   "start": 300.34,
   "dur": 4.26,
   "speech": "为什么不是 ARIMA(1,0,1)。"
  },
  {
   "scene": "definitions",
   "index": 13,
   "start": 304.78,
   "dur": 3.95,
   "speech": "AIC 差在这里很小，选谁都能跑。"
  },
  {
   "scene": "definitions",
   "index": 14,
   "start": 308.91,
   "dur": 3.13,
   "speech": "我们固定这套选择，不再调。"
  },
  {
   "scene": "definitions",
   "index": 15,
   "start": 312.23,
   "dur": 4.57,
   "speech": "参数一共四个：c、两个 theta、sigma。"
  },
  {
   "scene": "definitions",
   "index": 16,
   "start": 316.98,
   "dur": 3.57,
   "speech": "c 是漂移，theta 是移动平均。"
  },
  {
   "scene": "definitions",
   "index": 17,
   "start": 320.73,
   "dur": 3.45,
   "speech": "拟合分两步，叫 Hannan-Rissanen。"
  },
  {
   "scene": "definitions",
   "index": 18,
   "start": 324.35,
   "dur": 3.13,
   "speech": "第一步：先拟合一个高阶 AR。"
  },
  {
   "scene": "definitions",
   "index": 19,
   "start": 327.67,
   "dur": 3.47,
   "speech": "拿它的残差，当 MA 项的替身。"
  },
  {
   "scene": "definitions",
   "index": 20,
   "start": 331.32,
   "dur": 4.19,
   "speech": "第二步：把 y 的滞后和残差滞后拼起来。"
  },
  {
   "scene": "definitions",
   "index": 21,
   "start": 335.69,
   "dur": 4.6,
   "speech": "做一次最小二乘，解出 phi、theta、c。"
  },
  {
   "scene": "definitions",
   "index": 22,
   "start": 340.46,
   "dur": 3.81,
   "speech": "最小二乘用 Householder QR，手写。"
  },
  {
   "scene": "definitions",
   "index": 23,
   "start": 344.45,
   "dur": 2.94,
   "speech": "因为环境里没有 LAPACK。"
  },
  {
   "scene": "definitions",
   "index": 24,
   "start": 347.57,
   "dur": 3.57,
   "speech": "AR 那一步用 Levinson-Durbin 递推。"
  },
  {
   "scene": "definitions",
   "index": 25,
   "start": 351.32,
   "dur": 3.52,
   "speech": "复杂度是阶数的平方，不解矩阵。"
  },
  {
   "scene": "definitions",
   "index": 26,
   "start": 355.02,
   "dur": 3.37,
   "speech": "两步法不是最优，但足够稳。"
  },
  {
   "scene": "definitions",
   "index": 27,
   "start": 358.57,
   "dur": 3.59,
   "speech": "真实数据上，它的 theta 会越界。"
  },
  {
   "scene": "definitions",
   "index": 28,
   "start": 362.34,
   "dur": 2.56,
   "speech": "这个坑后面专门讲。"
  },
  {
   "scene": "definitions",
   "index": 29,
   "start": 365.08,
   "dur": 2.7,
   "speech": "再写 Matrix Profile。"
  },
  {
   "scene": "definitions",
   "index": 30,
   "start": 367.96,
   "dur": 4.17,
   "speech": "非书中：书只有一句「全局最近邻距离」。"
  },
  {
   "scene": "definitions",
   "index": 31,
   "start": 372.31,
   "dur": 4.5,
   "speech": "P(i) 等于 i 之外所有子序列的距离最小值。"
  },
  {
   "scene": "definitions",
   "index": 32,
   "start": 376.99,
   "dur": 2.87,
   "speech": "排除区里的子序列不算。"
  },
  {
   "scene": "definitions",
   "index": 33,
   "start": 380.04,
   "dur": 3.13,
   "speech": "距离用 z 归一化欧氏距离。"
  },
  {
