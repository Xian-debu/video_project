   "dur": 2.65,
   "speech": "命中率只看第一名。"
  },
  {
   "scene": "definitions",
   "index": 31,
   "start": 407.29,
   "dur": 4.09,
   "speech": "选中的候选等于真值冠军，记一分。"
  },
  {
