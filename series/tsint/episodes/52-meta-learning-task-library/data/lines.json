  },
  {
   "scene": "definitions",
   "index": 21,
   "start": 372.54,
   "dur": 3.78,
   "speech": "对一个任务，把十个候选都拟合一遍。"
  },
  {
   "scene": "definitions",
   "index": 22,
   "start": 376.5,
   "dur": 3.37,
   "speech": "每个候选在验证段给一个误差。"
  },
  {
   "scene": "definitions",
   "index": 23,
   "start": 380.06,
   "dur": 3.23,
   "speech": "十个误差就是一条十维标签。"
  },
  {
   "scene": "definitions",
   "index": 24,
   "start": 383.47,
   "dur": 3.54,
   "speech": "输入四维特征，输出十维误差。"
  },
  {
   "scene": "definitions",
   "index": 25,
   "start": 387.19,
   "dur": 2.51,
   "speech": "用多输出岭回归。"
  },
  {
   "scene": "definitions",
   "index": 26,
   "start": 389.88,
   "dur": 3.61,
   "speech": "一次矩阵求逆，十个输出一起解。"
  },
  {
   "scene": "definitions",
   "index": 27,
   "start": 393.67,
   "dur": 3.49,
   "speech": "特征标准化只用训练折的统计量。"
