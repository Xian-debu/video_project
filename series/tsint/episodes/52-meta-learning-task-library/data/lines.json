   "scene": "definitions",
   "index": 39,
   "start": 435.02,
   "dur": 2.97,
   "speech": "因为它们讲的是两个故事。"
  },
  {
   "scene": "definitions",
   "index": 40,
   "start": 438.17,
   "dur": 2.25,
   "speech": "切分有两层。"
  },
  {
   "scene": "definitions",
   "index": 41,
   "start": 440.6,
   "dur": 2.13,
   "speech": "第一层是时间。"
  },
  {
   "scene": "definitions",
   "index": 42,
   "start": 442.9,
   "dur": 4.02,
   "speech": "训练、验证、测试，按日历切。"
  },
  {
   "scene": "definitions",
   "index": 43,
   "start": 447.1,
   "dur": 2.08,
   "speech": "第二层是任务。"
  },
  {
   "scene": "definitions",
   "index": 44,
   "start": 449.36,
   "dur": 3.69,
   "speech": "五折交叉验证，任务轮流做留出。"
  },
  {
   "scene": "definitions",
   "index": 45,
   "start": 453.23,
   "dur": 3.4,
   "speech": "折与折之间不共享任何信息。"
  },
  {
   "scene": "definitions",
   "index": 46,
   "start": 456.81,
   "dur": 3.23,
   "speech": "标准化参数只来自训练折。"
  },
