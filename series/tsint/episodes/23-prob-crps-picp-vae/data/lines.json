  {
   "scene": "problem",
   "index": 27,
   "start": 167.27,
   "dur": 3.35,
   "speech": "计划书写了一点八零六八五三。"
  },
  {
   "scene": "problem",
   "index": 28,
   "start": 170.8,
   "dur": 4.12,
   "speech": "手算是 1.306853，差在系数。"
  },
  {
   "scene": "problem",
   "index": 29,
   "start": 175.1,
   "dur": 3.97,
   "speech": "这三个坑都不报错，只会悄悄换口径。"
  },
  {
   "scene": "definitions",
   "index": 0,
   "start": 182.47,
   "dur": 2.63,
   "speech": "先把三种输出钉住。"
  },
  {
   "scene": "definitions",
   "index": 1,
   "start": 185.28,
   "dur": 2.53,
   "speech": "点预测，给一个数。"
  },
  {
   "scene": "definitions",
   "index": 2,
   "start": 187.99,
   "dur": 3.21,
   "speech": "分位数预测，给 τ 个分位数。"
  },
  {
   "scene": "definitions",
   "index": 3,
   "start": 191.38,
   "dur": 2.73,
   "speech": "概率预测，给一个分布。"
  },
  {
   "scene": "definitions",
   "index": 4,
   "start": 194.29,
   "dur": 3.73,
   "speech": "三种输出的错误价格，完全不一样。"
  },
  {
   "scene": "definitions",
   "index": 5,
   "start": 198.2,
   "dur": 3.78,
   "speech": "点预测用平方误差或绝对误差。"
  },
  {
   "scene": "definitions",
   "index": 6,
   "start": 202.16,
   "dur": 3.85,
   "speech": "分位数预测用 pinball，上一集讲过。"
  },
  {
   "scene": "definitions",
   "index": 7,
   "start": 206.2,
   "dur": 4.26,
   "speech": "分布预测用 CRPS，也可以写成积分。"
  },
  {
   "scene": "definitions",
   "index": 8,
   "start": 210.64,
   "dur": 3.81,
   "speech": "CRPS 的定义，是平方差的积分。"
  },
  {
   "scene": "definitions",
   "index": 9,
   "start": 214.62,
   "dur": 4.38,
   "speech": "积分里是预测分布函数，减去观测的阶跃。"
  },
  {
   "scene": "definitions",
   "index": 10,
   "start": 219.19,
   "dur": 3.71,
   "speech": "直观说，就是每个分位数都罚一次。"
  },
  {
   "scene": "definitions",
   "index": 11,
   "start": 223.08,
   "dur": 3.25,
   "speech": "所以它同时管中心和形状。"
  },
  {
   "scene": "definitions",
   "index": 12,
   "start": 226.51,
   "dur": 2.75,
   "speech": "高斯的闭式解长这样。"
  },
  {
   "scene": "definitions",
   "index": 13,
   "start": 229.44,
   "dur": 4.36,
   "speech": "σ 乘 z，再乘两倍分布函数减一。"
  },
  {
   "scene": "definitions",
   "index": 14,
   "start": 233.98,
   "dur": 3.85,
   "speech": "加两倍密度，再减掉根号派分之一。"
  },
  {
   "scene": "definitions",
   "index": 15,
   "start": 238.01,
   "dur": 3.09,
   "speech": "当 y 等于 μ，只剩常数。"
  },
  {
   "scene": "definitions",
   "index": 16,
   "start": 241.28,
   "dur": 3.04,
   "speech": "这个常数是根号派分之一。"
  },
  {
   "scene": "definitions",
   "index": 17,
   "start": 244.5,
   "dur": 4.45,
   "speech": "约等于零点二三四，是 CRPS 的黄金值。"
  },
  {
   "scene": "definitions",
   "index": 18,
   "start": 249.13,
   "dur": 1.96,
   "speech": "再看覆盖率。"
  },
  {
   "scene": "definitions",
   "index": 19,
   "start": 251.27,
   "dur": 3.85,
   "speech": "覆盖率等于盖住的观测，除以总数。"
  },
  {
   "scene": "definitions",
   "index": 20,
   "start": 255.3,
   "dur": 3.06,
   "speech": "它只能落在 1/n 的栅格上。"
  },
  {
   "scene": "definitions",
   "index": 21,
   "start": 258.54,
   "dur": 4.12,
   "speech": "二十四个观测，就只能是二十四分之一。"
  },
  {
   "scene": "definitions",
   "index": 22,
   "start": 262.84,
   "dur": 3.52,
   "speech": "一万个样本盖住 8023 个。"
  },
  {
   "scene": "definitions",
   "index": 23,
   "start": 266.54,
   "dur": 3.64,
   "speech": "所以覆盖率报 0.8023。"
  },
  {
   "scene": "definitions",
   "index": 24,
   "start": 270.36,
   "dur": 2.34,
   "speech": "最后是 ELBO。"
  },
  {
   "scene": "definitions",
   "index": 25,
   "start": 272.88,
   "dur": 3.61,
   "speech": "变分下界等于重建项加 KL。"
  },
  {
   "scene": "definitions",
   "index": 26,
   "start": 276.67,
   "dur": 3.3,
   "speech": "我们的 loss，是负的 ELBO。"
  },
  {
   "scene": "definitions",
   "index": 27,
   "start": 280.16,
   "dur": 3.45,
   "speech": "高斯先验下，KL 有闭式。"
  },
  {
   "scene": "definitions",
   "index": 28,
   "start": 283.78,
   "dur": 4.45,
   "speech": "均值平方，加方差，减一，减对数方差。"
  },
  {
   "scene": "definitions",
   "index": 29,
   "start": 288.42,
   "dur": 3.52,
   "speech": "手算 μ 等于一、方差等于四。"
  },
  {
   "scene": "definitions",
   "index": 30,
   "start": 292.11,
   "dur": 3.9,
   "speech": "结果是 1.3068528194。"
  },
  {
   "scene": "intuition",
   "index": 0,
   "start": 299.42,
   "dur": 3.49,
   "speech": "直觉上，CRPS 在积分什么？"
  },
  {
   "scene": "intuition",
   "index": 1,
   "start": 303.09,
   "dur": 3.4,
   "speech": "把分位数损失，按 τ 积起来。"
  },
  {
   "scene": "intuition",
   "index": 2,
   "start": 306.67,
   "dur": 3.59,
   "speech": "每个 τ 都在罚，权重自动出现。"
  },
  {
   "scene": "intuition",
   "index": 3,
   "start": 310.44,
   "dur": 3.66,
   "speech": "所以它跟分位数回归是一家人。"
  },
  {
   "scene": "intuition",
   "index": 4,
   "start": 314.28,
   "dur": 4.09,
   "speech": "但 CRPS 用一个数总结全部 τ。"
  },
  {
   "scene": "intuition",
   "index": 5,
   "start": 318.56,
   "dur": 3.59,
   "speech": "好处是，能直接和平均误差比。"
  },
  {
   "scene": "intuition",
   "index": 6,
   "start": 322.33,
   "dur": 4.5,
   "speech": "同一组预测，误差越小，两个数都越小。"
  },
  {
   "scene": "intuition",
   "index": 7,
   "start": 327.01,
   "dur": 2.53,
   "speech": "但它们的价格不同。"
  },
  {
   "scene": "intuition",
   "index": 8,
   "start": 329.72,
   "dur": 4.55,
   "speech": "平均误差只看点，CRPS 看整个分布。"
  },
  {
   "scene": "intuition",
   "index": 9,
   "start": 334.45,
   "dur": 3.85,
   "speech": "所以 CRPS 可以比平均误差更小。"
  },
  {
   "scene": "intuition",
   "index": 10,
   "start": 338.49,
   "dur": 3.18,
   "speech": "真实数据上，就是这么回事。"
  },
  {
   "scene": "intuition",
   "index": 11,
   "start": 341.85,
   "dur": 4.29,
   "speech": "八个通道，CRPS 全部低于平均误差。"
  },
  {
   "scene": "intuition",
   "index": 12,
   "start": 346.32,
   "dur": 4.14,
   "speech": "平均是 0.0096 对 0.0126。"
  },
  {
   "scene": "intuition",
   "index": 13,
   "start": 350.64,
   "dur": 2.44,
   "speech": "低了大约四分之一。"
  },
  {
   "scene": "intuition",
   "index": 14,
   "start": 353.26,
   "dur": 2.39,
   "speech": "这点优势从哪来？"
  },
  {
   "scene": "intuition",
   "index": 15,
   "start": 355.83,
   "dur": 2.46,
   "speech": "从区间的宽度来。"
  },
  {
   "scene": "intuition",
   "index": 16,
   "start": 358.47,
   "dur": 3.04,
   "speech": "分布敢在窄的地方报窄。"
  },
  {
   "scene": "intuition",
   "index": 17,
   "start": 361.69,
   "dur": 3.13,
   "speech": "平均误差没有宽度这个概念。"
  },
  {
   "scene": "intuition",
   "index": 18,
   "start": 365,
   "dur": 2.99,
   "speech": "覆盖率的故事正好相反。"
  },
  {
   "scene": "intuition",
   "index": 19,
   "start": 368.17,
   "dur": 2.87,
   "speech": "覆盖率高的，不一定更好。"
  },
  {
   "scene": "intuition",
   "index": 20,
   "start": 371.22,
   "dur": 2.99,
   "speech": "名义八成，实际八成五。"
  },
  {
   "scene": "intuition",
   "index": 21,
   "start": 374.39,
   "dur": 1.93,
   "speech": "为什么偏高？"
  },
  {
   "scene": "intuition",
   "index": 22,
   "start": 376.5,
   "dur": 3.06,
   "speech": "因为 σ 被尾巴撑大了。"
  },
  {
   "scene": "intuition",
   "index": 23,
   "start": 379.75,
   "dur": 2.89,
   "speech": "区间宽了，自然盖得多。"
  },
  {
   "scene": "intuition",
   "index": 24,
   "start": 382.82,
   "dur": 2.68,
   "speech": "这是保守，不是准确。"
  },
  {
   "scene": "intuition",
   "index": 25,
   "start": 385.68,
   "dur": 3.28,
   "speech": "同一现象上一集也出现过。"
  },
  {
   "scene": "intuition",
   "index": 26,
   "start": 389.14,
   "dur": 3.42,
   "speech": "那次是八成四，这次八成五。"
  },
  {
   "scene": "intuition",
   "index": 27,
   "start": 392.74,
   "dur": 3.78,
   "speech": "所以覆盖率必须和宽度一起报。"
  },
  {
   "scene": "intuition",
   "index": 28,
   "start": 396.7,
   "dur": 3.28,
   "speech": "只报覆盖率，等于只报一半。"
  },
  {
   "scene": "intuition",
   "index": 29,
   "start": 400.16,
   "dur": 2.87,
   "speech": "VAE 这边，直觉是压缩。"
  },
