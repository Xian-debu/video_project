  {
   "scene": "problem",
   "index": 0,
   "start": 105.54,
   "dur": 2.56,
   "speech": "人工选模型有三步。"
  },
  {
   "scene": "problem",
   "index": 1,
   "start": 108.28,
   "dur": 2.61,
   "speech": "第一，想出一批候选。"
  },
