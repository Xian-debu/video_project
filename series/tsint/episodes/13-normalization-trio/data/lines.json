   "dur": 3.42,
   "speech": "它学到的就是 mu 和 sigma。"
  },
  {
   "scene": "verification",
   "index": 12,
   "start": 631.77,
   "dur": 3.23,
   "speech": "损失九点六乘十的负十次方。"
  },
  {
   "scene": "verification",
   "index": 13,
   "start": 635.18,
   "dur": 4.43,
   "speech": "alpha 的平均误差三点八乘十的负十一次方。"
  },
  {
   "scene": "verification",
   "index": 14,
   "start": 639.79,
   "dur": 2.49,
   "speech": "然后是诚实的部分。"
  },
  {
   "scene": "verification",
   "index": 15,
   "start": 642.45,
   "dur": 2.77,
   "speech": "SAN 的第一阶段，输了。"
  },
  {
   "scene": "verification",
   "index": 16,
   "start": 645.41,
   "dur": 4.07,
   "speech": "预测下一片均值，平均误差二点五一。"
  },
  {
   "scene": "verification",
   "index": 17,
   "start": 649.66,
   "dur": 3.37,
   "speech": "直接沿用上一片，零点六九。"
