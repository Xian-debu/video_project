   "start": 318.06,
   "dur": 4.07,
   "speech": "Z-score 用训练集的统计量，全程固定。"
  },
  {
   "scene": "definitions",
   "index": 27,
   "start": 322.31,
   "dur": 4.21,
   "speech": "RevIN 用当前这一段输入自己的统计量。"
  },
