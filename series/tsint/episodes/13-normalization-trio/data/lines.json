   "scene": "verification",
   "index": 18,
   "start": 653.21,
   "dur": 2.39,
   "speech": "差三点六四倍。"
  },
  {
   "scene": "verification",
   "index": 19,
   "start": 655.78,
   "dur": 3.93,
   "speech": "预测标准差，零点三四对零点二三。"
  },
  {
   "scene": "verification",
   "index": 20,
   "start": 659.89,
   "dur": 2.08,
   "speech": "差一点五倍。"
  },
  {
   "scene": "verification",
   "index": 21,
   "start": 662.14,
   "dur": 2.94,
   "speech": "二十四项检查，零失败。"
  },
  {
   "scene": "verification",
   "index": 22,
   "start": 665.27,
   "dur": 4.33,
   "speech": "但其中两项检查，写的是「误差同量级」。"
  },
  {
   "scene": "verification",
   "index": 23,
   "start": 669.78,
   "dur": 1.96,
   "speech": "不是「我们赢了」。"
  },
  {
   "scene": "verification",
   "index": 24,
   "start": 671.92,
   "dur": 2.97,
   "speech": "这句话必须留在片子里。"
  },
  {
   "scene": "verification",
   "index": 25,
   "start": 675.06,
   "dur": 4.53,
   "speech": "再说一次：检查全过，结论仍然是没赢。"
  },
  {
   "scene": "verification",
   "index": 26,
   "start": 679.77,
   "dur": 4.38,
   "speech": "因为检查验的是「实现对不对」，不是「模型强不强」。"
  },
  {
   "scene": "verification",
   "index": 27,
   "start": 684.33,
   "dur": 3.81,
   "speech": "这两件事分开说，才不会被数字骗。"
  },
  {
   "scene": "verification",
   "index": 28,
   "start": 688.32,
   "dur": 4.05,
   "speech": "桥接怎么做的：把参数写死，再比较。"
  },
  {
   "scene": "verification",
   "index": 29,
   "start": 692.54,
   "dur": 5.29,
   "speech": "DAIN 的 W_a 换成单位阵，偏置换成零。"
  },
  {
   "scene": "verification",
   "index": 30,
   "start": 698.02,
   "dur": 4.33,
   "speech": "SAN 的 tau 取满一个窗口，旁路掉 MLP。"
  },
  {
   "scene": "verification",
   "index": 31,
   "start": 702.53,
   "dur": 4.48,
   "speech": "三种情况下，输出与 RevIN 的差都是零。"
  },
  {
   "scene": "verification",
   "index": 32,
   "start": 707.19,
   "dur": 3.42,
   "speech": "零不是误差小，是逐位相同。"
  },
  {
   "scene": "verification",
   "index": 33,
   "start": 710.79,
   "dur": 3.9,
   "speech": "这说明形状一样，差别真在统计量。"
  },
  {
   "scene": "boundary",
   "index": 0,
   "start": 718.09,
   "dur": 3.23,
   "speech": "归一化承诺什么，不承诺什么。"
  },
  {
   "scene": "boundary",
   "index": 1,
   "start": 721.5,
   "dur": 2.63,
   "speech": "第一，它不创造信息。"
  },
  {
   "scene": "boundary",
   "index": 2,
   "start": 724.31,
   "dur": 3.49,
   "speech": "可逆的归一化，信息原样都在。"
  },
  {
   "scene": "boundary",
   "index": 3,
   "start": 727.98,
   "dur": 2.61,
   "speech": "它只是换了一套坐标。"
  },
  {
   "scene": "boundary",
   "index": 4,
   "start": 730.77,
   "dur": 2.65,
   "speech": "第二，它不解决漂移。"
  },
  {
   "scene": "boundary",
   "index": 5,
   "start": 733.6,
   "dur": 5.44,
   "speech": "分布变了，窗口统计量跟着变，只能跟上，不能预测。"
  },
  {
   "scene": "boundary",
   "index": 6,
   "start": 739.22,
   "dur": 4.89,
   "speech": "预测，是 SAN 想做的事，也是它第一阶段没做成的事。"
  },
  {
   "scene": "boundary",
   "index": 7,
   "start": 744.29,
   "dur": 3.81,
   "speech": "第三，MSE 小不等于预测更准。"
  },
  {
   "scene": "boundary",
   "index": 8,
   "start": 748.27,
   "dur": 4.05,
   "speech": "统计量预测得准，不代表下游任务更好。"
  },
  {
   "scene": "boundary",
   "index": 9,
   "start": 752.5,
   "dur": 4.14,
   "speech": "那要训完整模型才知道，那是后面的集。"
  },
  {
   "scene": "boundary",
   "index": 10,
   "start": 756.82,
   "dur": 4.29,
   "speech": "数据方面，一百二十只票，二百五十个交易日。"
  },
  {
   "scene": "boundary",
   "index": 11,
   "start": 761.29,
   "dur": 3.54,
   "speech": "九十个窗口训练，三十个测试。"
  },
  {
   "scene": "boundary",
   "index": 12,
   "start": 765.01,
   "dur": 2.68,
   "speech": "全是前复权收盘价。"
  },
  {
   "scene": "boundary",
   "index": 13,
   "start": 767.87,
   "dur": 2.56,
   "speech": "书里没给训练配方。"
  },
  {
   "scene": "boundary",
   "index": 14,
   "start": 770.61,
   "dur": 4.07,
   "speech": "优化器、学习率、轮数，一章都没有。"
  },
  {
   "scene": "boundary",
   "index": 15,
   "start": 774.86,
   "dur": 5.58,
   "speech": "所以 DAIN 用闭式最小二乘，SAN 用固定步长梯度下降。"
  },
  {
   "scene": "boundary",
   "index": 16,
   "start": 780.62,
   "dur": 2.46,
   "speech": "这些都不是书里的。"
  },
  {
   "scene": "boundary",
   "index": 17,
   "start": 783.26,
   "dur": 2.22,
   "speech": "画面会标出来。"
  },
  {
   "scene": "boundary",
   "index": 18,
   "start": 785.66,
   "dur": 2.94,
   "speech": "还有一件事：常数序列。"
  },
  {
   "scene": "boundary",
   "index": 19,
   "start": 788.78,
   "dur": 2.85,
   "speech": "常数序列的 sigma 是零。"
  },
  {
   "scene": "boundary",
   "index": 20,
   "start": 791.81,
   "dur": 4.84,
   "speech": "除零会毁掉整条链，所以 eps 不是可选项。"
  },
  {
   "scene": "boundary",
   "index": 21,
   "start": 796.83,
   "dur": 2.99,
   "speech": "我们另做了两个合成用例。"
  },
  {
   "scene": "boundary",
   "index": 22,
   "start": 800,
   "dur": 4.6,
   "speech": "常数序列的 sigma 是零，直接走 eps 保护。"
  },
  {
   "scene": "boundary",
   "index": 23,
   "start": 804.78,
   "dur": 5.22,
   "speech": "短于 tau 的序列，分片数为零，返回错误而不是崩溃。"
  },
  {
   "scene": "boundary",
   "index": 24,
   "start": 810.18,
   "dur": 3.59,
   "speech": "这两个用例在测试里，不在证据里。"
  },
  {
   "scene": "boundary",
   "index": 25,
   "start": 813.95,
   "dur": 3.66,
   "speech": "另一个边界：归一化不改变信息量。"
  },
  {
   "scene": "boundary",
   "index": 26,
   "start": 817.79,
   "dur": 3.18,
   "speech": "它只做线性变换，秩不变。"
  },
  {
   "scene": "boundary",
   "index": 27,
   "start": 821.15,
   "dur": 3.59,
   "speech": "所以它不能让模型看见新东西。"
  },
  {
   "scene": "boundary",
   "index": 28,
   "start": 824.92,
   "dur": 3.45,
   "speech": "能让模型更稳，不能让它更聪明。"
  },
  {
   "scene": "outro",
   "index": 0,
   "start": 831.77,
   "dur": 3.88,
   "speech": "一句话：三个归一化，只差一件事。"
  },
  {
