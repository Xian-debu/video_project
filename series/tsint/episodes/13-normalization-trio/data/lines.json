   "scene": "verification",
   "index": 6,
   "start": 608.23,
   "dur": 1.93,
   "speech": "这就是可逆。"
  },
  {
   "scene": "verification",
   "index": 7,
   "start": 610.35,
   "dur": 3.18,
   "speech": "DAIN 的拟合，闭式解一步到位。"
  },
  {
   "scene": "verification",
   "index": 8,
   "start": 613.71,
   "dur": 4.77,
   "speech": "拟合出来的 W_a，第一维是一点零。"
  },
  {
   "scene": "verification",
   "index": 9,
   "start": 618.66,
   "dur": 3.4,
   "speech": "其余两个维度是十的负十一次方。"
  },
  {
   "scene": "verification",
   "index": 10,
   "start": 622.23,
   "dur": 5.75,
   "speech": "W_b 的第二维是零点九九九九九九九九九七。"
