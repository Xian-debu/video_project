   "scene": "definitions",
   "index": 22,
   "start": 409.37,
   "dur": 3.04,
   "speech": "反传要一路传回第一步。"
  },
  {
   "scene": "definitions",
   "index": 23,
   "start": 412.58,
   "dur": 4.33,
   "speech": "这叫 BPTT，按时间展开的反向传播。"
  },
  {
   "scene": "definitions",
   "index": 24,
   "start": 417.1,
   "dur": 3.16,
   "speech": "梯度会累积，所以要裁剪。"
  },
  {
   "scene": "definitions",
   "index": 25,
   "start": 420.44,
   "dur": 4.31,
   "speech": "全局 L2 范数超过五，就整体缩到五。"
  },
  {
   "scene": "definitions",
   "index": 26,
   "start": 424.93,
   "dur": 2.92,
   "speech": "brick 并行把序列切块。"
  },
  {
   "scene": "definitions",
   "index": 27,
   "start": 428.02,
   "dur": 3.61,
   "speech": "五百步，块长五十，正好十块。"
  },
  {
   "scene": "definitions",
   "index": 28,
   "start": 431.82,
   "dur": 3.81,
   "speech": "十块各跑一个 RNN，互不干扰。"
  },
  {
   "scene": "definitions",
   "index": 29,
   "start": 435.8,
   "dur": 3.06,
   "speech": "每块只留最后一个隐状态。"
  },
  {
   "scene": "definitions",
   "index": 30,
   "start": 439.05,
   "dur": 3.57,
   "speech": "十个状态拼成一条十步的序列。"
  },
  {
   "scene": "definitions",
   "index": 31,
   "start": 442.79,
   "dur": 3.28,
   "speech": "第二层 RNN 只吃这十步。"
  },
  {
   "scene": "definitions",
   "index": 32,
   "start": 446.25,
   "dur": 2.87,
   "speech": "串行深度是五十加十。"
  },
  {
   "scene": "definitions",
   "index": 33,
   "start": 449.3,
   "dur": 3.83,
   "speech": "参数八十七个，和窗口长度无关。"
  },
  {
   "scene": "definitions",
   "index": 34,
   "start": 453.31,
   "dur": 3.52,
   "speech": "代价写在定义里：块间不通信。"
  },
  {
   "scene": "definitions",
   "index": 35,
   "start": 457.01,
   "dur": 3.21,
   "speech": "空洞卷积的公式只多一个 d。"
  },
  {
   "scene": "definitions",
   "index": 36,
   "start": 460.39,
   "dur": 5.97,
   "speech": "输出第 i 个点，取输入第 i、i 加 d、i 加二 d 三个点。"
  },
  {
   "scene": "definitions",
   "index": 37,
   "start": 466.54,
   "dur": 2.61,
   "speech": "核长三，间隔 d。"
  },
  {
   "scene": "definitions",
   "index": 38,
   "start": 469.33,
   "dur": 3.35,
   "speech": "d 等于一，退化成普通卷积。"
  },
  {
   "scene": "definitions",
   "index": 39,
   "start": 472.86,
   "dur": 4.89,
   "speech": "输出长度是输入长度减，核长减一，乘 d。"
  },
  {
   "scene": "definitions",
   "index": 40,
   "start": 477.92,
   "dur": 3.42,
   "speech": "五百步过五层，每层核长三。"
  },
  {
   "scene": "definitions",
   "index": 41,
   "start": 481.52,
   "dur": 2.61,
   "speech": "d 取一二四八十六。"
  },
  {
   "scene": "definitions",
   "index": 42,
   "start": 484.31,
   "dur": 2.7,
   "speech": "输出长度四百三十八。"
  },
  {
   "scene": "definitions",
   "index": 43,
   "start": 487.19,
   "dur": 2.63,
   "speech": "每过一层，短一点。"
  },
  {
   "scene": "definitions",
   "index": 44,
   "start": 490,
   "dur": 4.6,
   "speech": "感受野是一加，核长减一，乘间隔之和。"
  },
  {
   "scene": "definitions",
   "index": 45,
   "start": 494.78,
   "dur": 3.93,
   "speech": "四层 d 取一二四八，感受野三十一。"
  },
  {
   "scene": "definitions",
   "index": 46,
   "start": 498.89,
   "dur": 3.73,
   "speech": "再加一层 d 等于十六，六十三。"
  },
  {
   "scene": "definitions",
   "index": 47,
   "start": 502.8,
   "dur": 2.63,
   "speech": "参数只由核长决定。"
  },
  {
   "scene": "definitions",
   "index": 48,
   "start": 505.61,
   "dur": 3.64,
   "speech": "五层，每层核长三，十五个参数。"
  },
  {
   "scene": "definitions",
   "index": 49,
   "start": 509.43,
   "dur": 3.64,
   "speech": "同感受野的普通卷积要六十三个。"
  },
  {
   "scene": "definitions",
   "index": 50,
   "start": 513.25,
   "dur": 3.76,
   "speech": "十五除以六十三，约等于四分之一。"
  },
  {
   "scene": "definitions",
   "index": 51,
   "start": 517.18,
   "dur": 2.8,
   "speech": "这是这一集最干净的省。"
  },
  {
   "scene": "metrics",
   "index": 0,
   "start": 523.38,
   "dur": 2.51,
   "speech": "这一集量三样东西。"
  },
  {
   "scene": "metrics",
   "index": 1,
   "start": 526.07,
   "dur": 4.17,
   "speech": "第一样是结构：深度、参数、感受野。"
  },
  {
   "scene": "metrics",
   "index": 2,
   "start": 530.42,
   "dur": 3.76,
   "speech": "这些不靠训练，算出来就是算出来。"
  },
  {
   "scene": "metrics",
   "index": 3,
   "start": 534.35,
   "dur": 4.21,
   "speech": "第二样是可学性：给一个有信号的合成任务。"
  },
  {
   "scene": "metrics",
   "index": 4,
   "start": 538.75,
   "dur": 3.52,
   "speech": "网络学得会，说明实现没写坏。"
  },
  {
   "scene": "metrics",
   "index": 5,
   "start": 542.45,
   "dur": 3.37,
   "speech": "第三样是真实标签上的准确率。"
  },
  {
   "scene": "metrics",
   "index": 6,
   "start": 546,
   "dur": 3.16,
   "speech": "这一样最诚实，也最不好看。"
  },
  {
   "scene": "metrics",
   "index": 7,
   "start": 549.34,
   "dur": 4.09,
   "speech": "三样分开量，才知道哪一层出了问题。"
  },
  {
   "scene": "metrics",
   "index": 8,
   "start": 553.61,
   "dur": 2.32,
   "speech": "先看真实标签。"
  },
  {
   "scene": "metrics",
   "index": 9,
   "start": 556.11,
   "dur": 3.85,
   "speech": "窗口五十步，测试零点三一六七。"
  },
  {
   "scene": "metrics",
   "index": 10,
   "start": 560.14,
   "dur": 3.35,
   "speech": "二百五十步，零点三三三三。"
  },
  {
   "scene": "metrics",
   "index": 11,
   "start": 563.67,
   "dur": 3.42,
   "speech": "五百步，还是零点三三三三。"
  },
  {
   "scene": "metrics",
   "index": 12,
   "start": 567.28,
   "dur": 4,
   "speech": "随机猜是三分之一，零点三三三三。"
  },
  {
   "scene": "metrics",
   "index": 13,
   "start": 571.45,
   "dur": 3.35,
   "speech": "窗口拉长十倍，准确率没动。"
  },
  {
   "scene": "metrics",
   "index": 14,
   "start": 574.98,
   "dur": 3.23,
   "speech": "训练集上是零点四七五零。"
  },
  {
   "scene": "metrics",
   "index": 15,
   "start": 578.39,
   "dur": 3.61,
   "speech": "训练比测试高，但也没高到哪去。"
  },
  {
   "scene": "metrics",
   "index": 16,
   "start": 582.19,
   "dur": 4.09,
   "speech": "这说明模型记住了一点点训练集的噪声。"
  },
  {
   "scene": "metrics",
   "index": 17,
   "start": 586.46,
   "dur": 2.63,
   "speech": "没学到能迁移的东西。"
  },
  {
   "scene": "metrics",
   "index": 18,
   "start": 589.27,
   "dur": 2.25,
   "speech": "再看训练损失。"
  },
  {
   "scene": "metrics",
   "index": 19,
   "start": 591.7,
   "dur": 5.17,
   "speech": "三十轮下来，从一点零七四四降到一点零三六二。"
  },
  {
   "scene": "metrics",
   "index": 20,
   "start": 597.05,
   "dur": 4.36,
   "speech": "三个类均匀猜，损失是一点零九八六。"
  },
  {
   "scene": "metrics",
   "index": 21,
   "start": 601.59,
   "dur": 4.69,
   "speech": "也就是训练损失比随机还低零点零六二四。"
  },
  {
   "scene": "metrics",
   "index": 22,
   "start": 606.46,
   "dur": 4.14,
   "speech": "这点下降，基本就是把训练集背下来了。"
  },
  {
   "scene": "metrics",
   "index": 23,
   "start": 610.79,
   "dur": 2.73,
   "speech": "测试损失没跟着降。"
  },
  {
   "scene": "metrics",
   "index": 24,
   "start": 613.69,
   "dur": 2.08,
   "speech": "曲线是平的。"
  },
  {
   "scene": "metrics",
   "index": 25,
   "start": 615.95,
   "dur": 2.58,
   "speech": "这就是「没信号」的样子。"
  },
  {
   "scene": "metrics",
   "index": 26,
   "start": 618.71,
   "dur": 2.94,
   "speech": "换一个有信号的合成任务。"
  },
  {
   "scene": "metrics",
   "index": 27,
   "start": 621.83,
   "dur": 4,
   "speech": "三类序列，周期八、十二、二十。"
  },
  {
   "scene": "metrics",
   "index": 28,
   "start": 626.01,
   "dur": 3.21,
   "speech": "每条六十步，加两成噪声。"
  },
  {
   "scene": "metrics",
   "index": 29,
   "start": 629.4,
   "dur": 3.85,
   "speech": "同一个 RNN，隐状态十六，四十轮。"
  },
  {
   "scene": "metrics",
   "index": 30,
   "start": 633.43,
   "dur": 2.61,
   "speech": "训练准确率一点零。"
  },
  {
   "scene": "metrics",
   "index": 31,
   "start": 636.22,
   "dur": 2.94,
   "speech": "测试准确率也是一点零。"
  },
  {
   "scene": "metrics",
   "index": 32,
   "start": 639.34,
   "dur": 2.2,
   "speech": "四十一秒跑完。"
  },
  {
   "scene": "metrics",
   "index": 33,
   "start": 641.72,
   "dur": 3.35,
   "speech": "同一个实现，换个任务就学得会。"
  },
  {
   "scene": "metrics",
   "index": 34,
   "start": 645.25,
   "dur": 3.54,
   "speech": "所以问题不在代码，在数据。"
  },
  {
   "scene": "metrics",
   "index": 35,
   "start": 648.97,
   "dur": 3.61,
   "speech": "这条对照是这一集最关键的一步。"
  },
  {
   "scene": "metrics",
   "index": 36,
   "start": 652.76,
   "dur": 3.42,
   "speech": "把三个量写成可复现的定义。"
  },
  {
   "scene": "metrics",
   "index": 37,
   "start": 656.37,
   "dur": 4.26,
   "speech": "深度比：串行五百步，除以并行六十步。"
  },
  {
   "scene": "metrics",
   "index": 38,
   "start": 660.81,
   "dur": 5.2,
   "speech": "参数：两个网络都数一遍，八十七对三十九加分类头。"
  },
  {
   "scene": "metrics",
   "index": 39,
   "start": 666.19,
   "dur": 4.41,
   "speech": "感受野：一加核长减一，乘间隔之和。"
  },
  {
   "scene": "metrics",
   "index": 40,
   "start": 670.77,
   "dur": 5.39,
   "speech": "墙钟时间：单线程，六十个五百步窗口，前向各跑一遍。"
  },
  {
   "scene": "metrics",
   "index": 41,
   "start": 676.34,
   "dur": 3.57,
   "speech": "单线程墙钟比测到零点四三八。"
  },
  {
   "scene": "metrics",
   "index": 42,
   "start": 680.09,
   "dur": 3.73,
   "speech": "不到一，意思是并行反而更慢。"
  },
  {
   "scene": "metrics",
   "index": 43,
   "start": 684,
   "dur": 4.09,
   "speech": "所以「快六倍」这条，我们只能给结构比。"
  },
  {
   "scene": "implementation",
   "index": 0,
   "start": 691.5,
   "dur": 3.37,
   "speech": "三个模块，二十七条新断言。"
  },
  {
   "scene": "implementation",
   "index": 1,
   "start": 695.05,
   "dur": 4.93,
   "speech": "Rnn 管单步、前向、损失、反传，十条。"
  },
  {
   "scene": "implementation",
   "index": 2,
   "start": 700.17,
   "dur": 4.14,
   "speech": "ShallowRnn 管切块与两层并行，八条。"
  },
  {
   "scene": "implementation",
   "index": 3,
   "start": 704.49,
   "dur": 4.26,
   "speech": "Dilated 管空洞卷积与感受野，九条。"
  },
  {
   "scene": "implementation",
   "index": 4,
   "start": 708.93,
   "dur": 5.03,
   "speech": "全仓现在是一百四十五组、一千九百六十五条断言。"
  },
  {
   "scene": "implementation",
   "index": 5,
   "start": 714.14,
   "dur": 4.74,
   "speech": "每个模块配一份 spec，跑 cabal test 一次全验。"
  },
  {
   "scene": "implementation",
   "index": 6,
   "start": 719.06,
   "dur": 2.15,
   "speech": "先写 Rnn。"
  },
  {
   "scene": "implementation",
   "index": 7,
   "start": 721.39,
   "dur": 4.65,
   "speech": "参数用扁平数组存，初始化用同一个种子。"
  },
  {
   "scene": "implementation",
   "index": 8,
   "start": 726.22,
   "dur": 3.59,
   "speech": "前向走一遍，每步记下隐状态。"
  },
  {
   "scene": "implementation",
   "index": 9,
   "start": 729.99,
   "dur": 4.36,
   "speech": "序列走完，隐状态取平均，再进线性层。"
  },
  {
   "scene": "implementation",
   "index": 10,
   "start": 734.53,
   "dur": 4.67,
   "speech": "损失用交叉熵，带 softmax 的数值稳定写法。"
  },
  {
   "scene": "implementation",
   "index": 11,
   "start": 739.38,
   "dur": 3.23,
   "speech": "反传是最容易写错的地方。"
  },
  {
   "scene": "implementation",
   "index": 12,
   "start": 742.79,
   "dur": 4.26,
   "speech": "第一步：把梯度从线性层传回平均池化。"
  },
  {
   "scene": "implementation",
   "index": 13,
   "start": 747.23,
   "dur": 4.12,
   "speech": "第二步：平均池化要把梯度分回每一步。"
  },
  {
   "scene": "implementation",
   "index": 14,
   "start": 751.53,
   "dur": 3.97,
   "speech": "第三步：每一步再往前传，累加梯度。"
  },
  {
   "scene": "implementation",
   "index": 15,
   "start": 755.68,
   "dur": 3.33,
   "speech": "漏掉任何一步，梯度就对不上。"
  },
  {
   "scene": "implementation",
   "index": 16,
   "start": 759.19,
   "dur": 4.29,
   "speech": "所以有一条检查：解析梯度和中心差分比。"
  },
  {
   "scene": "implementation",
   "index": 17,
   "start": 763.65,
   "dur": 3.9,
   "speech": "实测最大差一点五九乘十的负十次方。"
  },
  {
   "scene": "implementation",
   "index": 18,
   "start": 767.74,
   "dur": 2.32,
   "speech": "第二个坑是类型。"
  },
  {
   "scene": "implementation",
   "index": 19,
   "start": 770.23,
   "dur": 3.54,
   "speech": "向量有两种：boxed 和 unboxed。"
  },
  {
   "scene": "implementation",
   "index": 20,
   "start": 773.96,
   "dur": 3.59,
   "speech": "混用会编译不过，或者悄悄变慢。"
  },
  {
   "scene": "implementation",
   "index": 21,
   "start": 777.73,
   "dur": 2.92,
   "speech": "第三个坑是惰性求值。"
  },
  {
   "scene": "implementation",
   "index": 22,
   "start": 780.82,
   "dur": 4.31,
   "speech": "只算损失不强制求值，训练其实没发生。"
  },
  {
   "scene": "implementation",
   "index": 23,
   "start": 785.31,
   "dur": 4,
   "speech": "所以每个训练循环里，都要 evaluate。"
  },
  {
   "scene": "implementation",
   "index": 24,
   "start": 789.49,
   "dur": 3.95,
   "speech": "这三条都写进提交说明，下次不踩。"
  },
  {
   "scene": "implementation",
   "index": 25,
   "start": 793.62,
   "dur": 2.61,
   "speech": "brick 的实现分三层。"
  },
  {
   "scene": "implementation",
   "index": 26,
   "start": 796.41,
   "dur": 3.83,
   "speech": "第一层 brickify，把序列按块切开。"
  },
  {
   "scene": "implementation",
   "index": 27,
   "start": 800.42,
   "dur": 4.09,
   "speech": "第二层对每块跑 RNN，只取块末状态。"
  },
  {
   "scene": "implementation",
   "index": 28,
   "start": 804.69,
   "dur": 4.55,
   "speech": "第三层把块末状态拼起来，再跑一个短 RNN。"
  },
  {
   "scene": "implementation",
   "index": 29,
   "start": 809.42,
   "dur": 5.01,
   "speech": "检查里有一条：T 等于十二、块长四，要切出三块。"
  },
  {
   "scene": "implementation",
   "index": 30,
   "start": 814.61,
   "dur": 3.59,
   "speech": "拼回去逐项相等，不能丢一个点。"
  },
  {
   "scene": "implementation",
   "index": 31,
   "start": 818.38,
   "dur": 3.57,
   "speech": "第二层只吃三个状态，每个四维。"
  },
  {
   "scene": "implementation",
   "index": 32,
   "start": 822.12,
   "dur": 3.01,
   "speech": "浅层的「浅」，就浅在这里。"
  },
  {
   "scene": "implementation",
   "index": 33,
   "start": 825.32,
   "dur": 3.47,
   "speech": "窗口再长，第二层也只有十步。"
  },
  {
   "scene": "implementation",
   "index": 34,
   "start": 828.97,
   "dur": 2.92,
   "speech": "空洞卷积的实现更短。"
  },
  {
   "scene": "implementation",
   "index": 35,
   "start": 832.07,
   "dur": 4.69,
   "speech": "一个循环：对每个输出位置，按 d 间隔取核。"
  },
  {
   "scene": "implementation",
   "index": 36,
