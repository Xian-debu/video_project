   "scene": "intuition",
   "index": 21,
   "start": 595,
   "dur": 3.97,
   "speech": "这一条是我们自己在实现里踩过的坑。"
  },
  {
   "scene": "intuition",
   "index": 22,
   "start": 599.15,
   "dur": 4.65,
   "speech": "最后检查改成了，带质量下降加行熵下降。"
  },
