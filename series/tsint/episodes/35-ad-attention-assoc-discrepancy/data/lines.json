   "scene": "intuition",
   "index": 15,
   "start": 572.78,
   "dur": 4.67,
   "speech": "带内质量 0.080，带外质量 0.000。"
  },
  {
   "scene": "intuition",
   "index": 16,
   "start": 577.63,
   "dur": 3.45,
   "speech": "能量既不在带内，也不在带外。"
  },
  {
   "scene": "intuition",
   "index": 17,
   "start": 581.26,
   "dur": 2.15,
   "speech": "全在一个点上。"
  },
  {
   "scene": "intuition",
   "index": 18,
   "start": 583.59,
   "dur": 2.49,
   "speech": "这就是针尖签名。"
  },
  {
