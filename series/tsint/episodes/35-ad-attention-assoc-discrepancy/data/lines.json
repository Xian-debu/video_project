   "scene": "intuition",
   "index": 27,
   "start": 621.02,
   "dur": 4.36,
   "speech": "带内质量 0.354，和干净窗差不多。"
  },
  {
   "scene": "intuition",
   "index": 28,
   "start": 625.56,
   "dur": 3.85,
   "speech": "带外质量 0.682，比干净窗高。"
  },
  {
   "scene": "intuition",
   "index": 29,
   "start": 629.6,
   "dur": 3.73,
   "speech": "行熵 3.105，比干净窗还高。"
  },
  {
   "scene": "intuition",
   "index": 30,
   "start": 633.51,
   "dur": 3.47,
   "speech": "也就是，权重更平、更散。"
  },
