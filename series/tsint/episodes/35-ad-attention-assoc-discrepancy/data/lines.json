   "scene": "intuition",
   "index": 4,
   "start": 528.67,
   "dur": 4.53,
   "speech": "一百个点的窗口，降采样成四十乘四十。"
  },
  {
   "scene": "intuition",
   "index": 5,
   "start": 533.38,
   "dur": 4.6,
   "speech": "对角线上的格子，平均权重约百分之三到五。"
  },
  {
   "scene": "intuition",
   "index": 6,
   "start": 538.16,
   "dur": 3.25,
   "speech": "带内质量占比 0.329。"
  },
  {
   "scene": "intuition",
   "index": 7,
   "start": 541.59,
   "dur": 2.77,
   "speech": "带外质量 0.473。"
  },
  {
   "scene": "intuition",
   "index": 8,
   "start": 544.55,
   "dur": 6.71,
   "speech": "行熵平均 2.715；作为参照，一行一百格的熵上限是 4.61。"
  },
