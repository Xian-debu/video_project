   "dur": 4.05,
   "speech": "实现只用 vector，不依赖深度学习框架。"
  },
  {
   "scene": "implementation",
   "index": 10,
   "start": 707.05,
   "dur": 3.95,
   "speech": "第二个，DLinear 模块，一百四十三行。"
  },
