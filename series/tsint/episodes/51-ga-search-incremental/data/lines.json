  {
   "scene": "problem",
   "index": 38,
   "start": 284.37,
   "dur": 3.64,
   "speech": "后面会看到，它一次都没命中。"
  },
  {
   "scene": "problem",
   "index": 39,
   "start": 288.19,
   "dur": 2.94,
   "speech": "这就是第一个坏消息的伏笔。"
  },
  {
   "scene": "definitions",
   "index": 0,
   "start": 294.53,
   "dur": 3.33,
   "speech": "定义第一个量：搜索空间大小。"
  },
  {
   "scene": "definitions",
   "index": 1,
   "start": 298.04,
   "dur": 3.52,
   "speech": "它是所有超参取值个数的乘积。"
  },
  {
   "scene": "definitions",
   "index": 2,
   "start": 301.73,
   "dur": 4.29,
   "speech": "这一集的候选是十个现成模型，不是网格。"
  },
  {
   "scene": "definitions",
   "index": 3,
   "start": 306.2,
   "dur": 3.01,
   "speech": "所以搜索空间就是十。"
  },
  {
   "scene": "definitions",
   "index": 4,
   "start": 309.39,
   "dur": 3.18,
   "speech": "上一集的网格是六百四十八。"
  },
  {
   "scene": "definitions",
   "index": 5,
   "start": 312.76,
   "dur": 4.14,
   "speech": "后面说遗传算法只在搜不完的空间里划算，"
  },
  {
   "scene": "definitions",
   "index": 6,
   "start": 317.08,
   "dur": 3.4,
   "speech": "指的就是这两种规模的差别。"
  },
  {
   "scene": "definitions",
   "index": 7,
   "start": 320.66,
   "dur": 3.52,
   "speech": "十个的空间，穷举十次就完了。"
  },
  {
   "scene": "definitions",
   "index": 8,
   "start": 324.35,
   "dur": 4.21,
   "speech": "六百四十八的空间，穷举要六百四十八次。"
  },
  {
   "scene": "definitions",
   "index": 9,
   "start": 328.75,
   "dur": 2.73,
   "speech": "优势只能出现在后者。"
  },
  {
   "scene": "definitions",
   "index": 10,
   "start": 331.65,
   "dur": 2.97,
   "speech": "定义第二个量：评估预算。"
  },
  {
   "scene": "definitions",
   "index": 11,
   "start": 334.8,
   "dur": 3.69,
   "speech": "一次评估就是拿一个基因组去打分。"
  },
  {
   "scene": "definitions",
   "index": 12,
   "start": 338.67,
   "dur": 3.4,
   "speech": "一次训练是真正拟合一遍模型。"
  },
  {
   "scene": "definitions",
   "index": 13,
   "start": 342.24,
   "dur": 2.27,
   "speech": "两者不是一回事。"
  },
  {
   "scene": "definitions",
   "index": 14,
   "start": 344.69,
   "dur": 3.66,
   "speech": "有缓存时同一个基因只训练一次。"
  },
  {
   "scene": "definitions",
   "index": 15,
   "start": 348.54,
   "dur": 3.85,
   "speech": "这一集的缓存键就是整个基因向量。"
  },
  {
   "scene": "definitions",
   "index": 16,
   "start": 352.57,
   "dur": 4.07,
   "speech": "同一个基因在十代里可能被反复抽到。"
  },
  {
   "scene": "definitions",
   "index": 17,
   "start": 356.82,
   "dur": 3.73,
   "speech": "覆盖率记录的是去重后的训练次数。"
  },
  {
   "scene": "definitions",
   "index": 18,
   "start": 360.73,
   "dur": 3.21,
   "speech": "每代记一次，最后取末值。"
  },
  {
   "scene": "definitions",
   "index": 19,
   "start": 364.12,
   "dur": 3.93,
   "speech": "这是判断遗传算法值不值的直接依据。"
  },
  {
   "scene": "definitions",
   "index": 20,
   "start": 368.23,
   "dur": 2.85,
   "speech": "定义第三个量：阶段点。"
  },
  {
   "scene": "definitions",
   "index": 21,
   "start": 371.25,
   "dur": 3.21,
   "speech": "阶段点是训练量的采样位置。"
  },
  {
   "scene": "definitions",
   "index": 22,
   "start": 374.64,
   "dur": 3.83,
   "speech": "取八分之一、四分之一、二分之一。"
  },
  {
   "scene": "definitions",
   "index": 23,
   "start": 378.65,
   "dur": 2.44,
   "speech": "三个点单调递增。"
  },
  {
   "scene": "definitions",
   "index": 24,
   "start": 381.27,
   "dur": 4.26,
   "speech": "三次部分拟合，接触的数据加起来是多少。"
  },
  {
   "scene": "definitions",
   "index": 25,
   "start": 385.71,
   "dur": 4.72,
   "speech": "八分之一加四分之一加二分之一，等于八分之七。"
  },
  {
   "scene": "definitions",
   "index": 26,
   "start": 390.61,
   "dur": 3.09,
   "speech": "不是一半，是零点八七五。"
  },
  {
   "scene": "definitions",
   "index": 27,
   "start": 393.87,
   "dur": 3.85,
   "speech": "实际读数零点八七四，差在取整。"
  },
  {
   "scene": "definitions",
   "index": 28,
   "start": 397.91,
   "dur": 2.49,
   "speech": "这个数字后面要用。"
  },
  {
   "scene": "definitions",
   "index": 29,
   "start": 400.57,
   "dur": 2.58,
   "speech": "它决定了省钱的上限。"
  },
  {
   "scene": "definitions",
   "index": 30,
   "start": 403.33,
   "dur": 2.77,
   "speech": "定义第四个量：外推。"
  },
  {
   "scene": "definitions",
   "index": 31,
   "start": 406.29,
   "dur": 4.38,
   "speech": "线性外推假设误差随训练量线性下降。"
  },
  {
   "scene": "definitions",
   "index": 32,
   "start": 410.85,
   "dur": 4.19,
   "speech": "两点就能定一条线，三点做最小二乘。"
  },
  {
   "scene": "definitions",
   "index": 33,
   "start": 415.22,
   "dur": 2.89,
   "speech": "真实的学习曲线是凸的。"
  },
  {
   "scene": "definitions",
   "index": 34,
   "start": 418.29,
   "dur": 4.02,
   "speech": "凸曲线的割线，永远高估下降幅度。"
  },
  {
   "scene": "definitions",
   "index": 35,
   "start": 422.5,
   "dur": 3.76,
   "speech": "所以线性外推会系统性低估误差。"
  },
  {
   "scene": "definitions",
   "index": 36,
   "start": 426.43,
   "dur": 2.53,
   "speech": "幂律外推换一个假设。"
  },
  {
   "scene": "definitions",
   "index": 37,
   "start": 429.15,
   "dur": 3.37,
   "speech": "误差等于 a 乘 n 的负 b 次方。"
  },
  {
   "scene": "definitions",
   "index": 38,
   "start": 432.7,
   "dur": 4.09,
   "speech": "取对数之后还是一条直线，拟合方式一样。"
  },
  {
   "scene": "definitions",
   "index": 39,
   "start": 436.98,
   "dur": 4.21,
   "speech": "但形状对上了：凸、递减、有平台。"
  },
  {
   "scene": "definitions",
   "index": 40,
   "start": 441.37,
   "dur": 2.94,
   "speech": "定义第五个量：外推误差。"
  },
  {
   "scene": "definitions",
   "index": 41,
   "start": 444.49,
   "dur": 4.5,
   "speech": "它是外推 MAE 与全量验证 MAE 的平均绝对差。"
  },
  {
   "scene": "definitions",
   "index": 42,
   "start": 449.17,
   "dur": 3.04,
   "speech": "注意比的是 MAE，不是排序。"
  },
  {
   "scene": "definitions",
   "index": 43,
   "start": 452.39,
   "dur": 3.18,
   "speech": "排序对不对，还要另外几个量。"
  },
  {
   "scene": "definitions",
   "index": 44,
   "start": 455.75,
   "dur": 5.49,
   "speech": "一个是 Top-1 命中：外推选的和全量选的是不是同一个。"
  },
  {
   "scene": "definitions",
   "index": 45,
   "start": 461.42,
   "dur": 5.17,
   "speech": "一个是 Top-2 全等：两个名额的集合是否完全一样。"
  },
  {
   "scene": "definitions",
   "index": 46,
   "start": 466.77,
   "dur": 3.54,
   "speech": "再加一个平均交集，宽松一点。"
  },
  {
   "scene": "definitions",
   "index": 47,
   "start": 470.5,
   "dur": 3.76,
   "speech": "最后是冠军和亚军的验证 MAE 差距。"
  },
  {
   "scene": "definitions",
   "index": 48,
   "start": 474.43,
   "dur": 2.94,
   "speech": "这个差距是信号的尺度。"
  },
  {
   "scene": "definitions",
   "index": 49,
   "start": 477.56,
   "dur": 5.15,
   "speech": "外推误差比它大多少倍，就是排序能不能恢复的判据。"
  },
  {
   "scene": "metrics",
   "index": 0,
   "start": 486.11,
   "dur": 3.23,
   "speech": "指标只挑四个，够用就行。"
  },
  {
   "scene": "metrics",
   "index": 1,
   "start": 489.52,
   "dur": 5.17,
   "speech": "第一个是线性外推的黄金值：三点外推到六十得零点六。"
  },
  {
   "scene": "metrics",
   "index": 2,
   "start": 494.87,
   "dur": 3.81,
   "speech": "第二个是两点共线：外推到五十得六。"
  },
  {
   "scene": "metrics",
   "index": 3,
   "start": 498.86,
   "dur": 6.35,
   "speech": "第三个是阶段点：训练量切成三段，取二一三、四二六、八五二。"
  },
  {
   "scene": "metrics",
   "index": 4,
   "start": 505.39,
   "dur": 3.52,
   "speech": "第四个是遗传算法的黄金值。"
  },
  {
   "scene": "metrics",
   "index": 5,
   "start": 509.09,
   "dur": 4.79,
   "speech": "目标函数是负的 x 减三平方，种子一三六。"
  },
  {
   "scene": "metrics",
   "index": 6,
   "start": 514.06,
   "dur": 5.17,
   "speech": "第一代最好适应度负一，第二代出现基因三，适应度零。"
  },
  {
   "scene": "metrics",
   "index": 7,
   "start": 519.41,
   "dur": 5.03,
   "speech": "单调性也量了：两百对里一百六十一对单调不升。"
  },
  {
   "scene": "metrics",
   "index": 8,
   "start": 524.62,
   "dur": 3.33,
   "speech": "八成一的比例，后面边界要提。"
  },
  {
   "scene": "metrics",
   "index": 9,
   "start": 528.13,
   "dur": 3.18,
   "speech": "指标定义完，看真实读数。"
  },
  {
   "scene": "metrics",
   "index": 10,
   "start": 531.49,
   "dur": 3.01,
   "speech": "先看十候选的阶段曲线。"
  },
  {
   "scene": "metrics",
   "index": 11,
   "start": 534.68,
   "dur": 5.44,
   "speech": "表上有四个数：二一零、四二一、八四三、全量。"
  },
  {
   "scene": "metrics",
   "index": 12,
   "start": 540.3,
   "dur": 4.31,
   "speech": "朴素模型是一条平线，因为它不看训练量。"
  },
  {
   "scene": "metrics",
   "index": 13,
   "start": 544.79,
   "dur": 3.59,
   "speech": "拟合型的候选，曲线都往下掉。"
  },
  {
   "scene": "metrics",
   "index": 14,
   "start": 548.56,
   "dur": 2.77,
   "speech": "以 AR(1) 为例。"
  },
  {
   "scene": "metrics",
   "index": 15,
   "start": 551.52,
   "dur": 2.99,
   "speech": "二一零时误差十八点零。"
  },
  {
   "scene": "metrics",
   "index": 16,
   "start": 554.69,
   "dur": 4.74,
   "speech": "四二一时十一点四五，八四三时十点九一。"
  },
  {
   "scene": "metrics",
   "index": 17,
   "start": 559.61,
   "dur": 2.32,
   "speech": "全量十点八零。"
  },
  {
   "scene": "metrics",
   "index": 18,
   "start": 562.11,
   "dur": 3.64,
   "speech": "前两段掉得快，后两段几乎不动。"
  },
  {
   "scene": "metrics",
   "index": 19,
   "start": 565.92,
   "dur": 4.41,
   "speech": "这就是平台期：曲线在最后一段已经平了。"
  },
  {
   "scene": "metrics",
   "index": 20,
   "start": 570.51,
   "dur": 4.33,
   "speech": "同一批候选，两种外推的误差完全不同。"
  },
  {
   "scene": "metrics",
   "index": 21,
   "start": 575.02,
   "dur": 3.9,
   "speech": "线性外推的平均绝对差是四点七六。"
  },
  {
   "scene": "metrics",
   "index": 22,
   "start": 579.11,
   "dur": 3.25,
   "speech": "最大的一次差了两百一十九。"
  },
  {
   "scene": "metrics",
   "index": 23,
   "start": 582.54,
   "dur": 5.7,
   "speech": "为什么这么大：AR(1) 全量十点八，线性外推给一点七三。"
  },
  {
   "scene": "metrics",
   "index": 24,
   "start": 588.42,
   "dur": 3.54,
   "speech": "差了一个量级，排序自然塌了。"
  },
  {
   "scene": "metrics",
   "index": 25,
   "start": 592.14,
   "dur": 3.57,
   "speech": "幂律外推把误差压到一点三八。"
  },
  {
   "scene": "metrics",
   "index": 26,
   "start": 595.89,
   "dur": 2.82,
   "speech": "最大的差是五十五点七。"
  },
  {
   "scene": "metrics",
   "index": 27,
   "start": 598.89,
   "dur": 3.93,
   "speech": "压掉了三分之二，但离十点八还很远。"
  },
  {
   "scene": "metrics",
   "index": 28,
   "start": 603,
   "dur": 4.17,
   "speech": "三个点都在下降段，外推看不见平台。"
  },
  {
   "scene": "metrics",
   "index": 29,
   "start": 607.34,
   "dur": 3.59,
   "speech": "形状对了，平台期还是没读出来。"
  },
  {
   "scene": "metrics",
   "index": 30,
   "start": 611.11,
   "dur": 2.32,
   "speech": "再看排序对不对。"
  },
  {
   "scene": "metrics",
   "index": 31,
   "start": 613.61,
   "dur": 3.54,
   "speech": "线性外推的 Top-1 只有百分之五。"
  },
  {
   "scene": "metrics",
   "index": 32,
   "start": 617.33,
   "dur": 3.37,
   "speech": "二十只股票里只挑对一只。"
  },
  {
   "scene": "metrics",
   "index": 33,
   "start": 620.89,
   "dur": 3.95,
   "speech": "幂律外推把 Top-1 抬到百分之三十。"
  },
  {
   "scene": "metrics",
   "index": 34,
   "start": 625.02,
   "dur": 3.93,
   "speech": "六只挑对，仍远低于全量的百分之百。"
  },
  {
   "scene": "metrics",
   "index": 35,
   "start": 629.12,
   "dur": 3.35,
   "speech": "Top-2 全等，幂律只有三只。"
  },
  {
   "scene": "metrics",
   "index": 36,
   "start": 632.65,
   "dur": 3.16,
   "speech": "平均交集是零点七个名额。"
  },
  {
   "scene": "metrics",
   "index": 37,
   "start": 635.99,
   "dur": 4.77,
   "speech": "冠军和亚军的验证 MAE 平均只差零点零六五。"
  },
