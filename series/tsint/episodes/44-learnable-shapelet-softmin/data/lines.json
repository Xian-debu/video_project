   "dur": 4.17,
   "speech": "α 小的时候，权重摊在好几个窗口上。"
  },
  {
   "scene": "problem",
   "index": 22,
   "start": 201.61,
   "dur": 4,
   "speech": "α 大的时候，权重集中到最小那个。"
  },
