  {
   "scene": "definitions",
   "index": 0,
   "start": 286.7,
   "dur": 2.1,
   "speech": "定义四个东西。"
  },
  {
   "scene": "definitions",
   "index": 1,
   "start": 288.98,
   "dur": 2.53,
   "speech": "第一个，加权平均。"
  },
  {
   "scene": "definitions",
   "index": 2,
   "start": 291.7,
   "dur": 4.77,
   "speech": "式 6.5：预测等于权重乘各模型预测之和。"
  },
  {
   "scene": "definitions",
   "index": 3,
   "start": 296.64,
   "dur": 2.8,
   "speech": "权重非负，和为一。"
  },
  {
   "scene": "definitions",
   "index": 4,
   "start": 299.62,
   "dur": 3.01,
   "speech": "权重全相等，就是等权。"
  },
  {
   "scene": "definitions",
   "index": 5,
   "start": 302.81,
   "dur": 2.77,
   "speech": "第二个，中位数集成。"
  },
  {
   "scene": "definitions",
   "index": 6,
   "start": 305.77,
   "dur": 3.69,
   "speech": "每个时点，取十个预测的中位数。"
  },
  {
   "scene": "definitions",
   "index": 7,
   "start": 309.63,
   "dur": 3.04,
   "speech": "它不看权重，只看排序。"
  },
  {
   "scene": "definitions",
   "index": 8,
   "start": 312.85,
   "dur": 2.29,
   "speech": "对离群值更稳。"
  },
  {
   "scene": "definitions",
   "index": 9,
   "start": 315.33,
   "dur": 2.97,
   "speech": "代价是丢掉幅度信息。"
  },
  {
   "scene": "definitions",
   "index": 10,
   "start": 318.47,
   "dur": 2.53,
   "speech": "第三个，学习权重。"
  },
  {
   "scene": "definitions",
   "index": 11,
   "start": 321.19,
   "dur": 4.26,
   "speech": "把十个候选在调参段的预测排成矩阵。"
  },
  {
   "scene": "definitions",
   "index": 12,
   "start": 325.63,
   "dur": 2.92,
   "speech": "解一个带约束的岭回归。"
  },
  {
   "scene": "definitions",
   "index": 13,
   "start": 328.73,
   "dur": 4.43,
   "speech": "目标是最小化残差平方，加 L2 惩罚。"
  },
  {
   "scene": "definitions",
   "index": 14,
   "start": 333.34,
   "dur": 3.59,
   "speech": "约束是权重非负、和为一。"
  },
  {
   "scene": "definitions",
   "index": 15,
   "start": 337.11,
   "dur": 4.48,
   "speech": "做法是先解无约束，再投影回单纯形。"
  },
  {
   "scene": "definitions",
   "index": 16,
   "start": 341.76,
   "dur": 2.56,
   "speech": "投影用一维搜索。"
  },
  {
   "scene": "definitions",
   "index": 17,
   "start": 344.5,
   "dur": 3.18,
   "speech": "解一次线性方程组就够。"
  },
  {
   "scene": "definitions",
   "index": 18,
   "start": 347.86,
   "dur": 2.75,
   "speech": "惩罚系数取千分之一。"
  },
  {
   "scene": "definitions",
   "index": 19,
   "start": 350.79,
   "dur": 4.14,
   "speech": "二十只股票，权重和都精确等于一。"
  },
  {
   "scene": "definitions",
   "index": 20,
   "start": 355.12,
   "dur": 2.61,
   "speech": "第四个，有效权重。"
  },
  {
   "scene": "definitions",
   "index": 21,
   "start": 357.9,
   "dur": 3.59,
   "speech": "定义为一除以权重平方和。"
  },
  {
   "scene": "definitions",
   "index": 22,
   "start": 361.67,
   "dur": 3.64,
   "speech": "等权十个模型，有效权重是十。"
  },
  {
   "scene": "definitions",
   "index": 23,
   "start": 365.49,
   "dur": 3.54,
   "speech": "全押一个模型，有效权重是一。"
  },
  {
   "scene": "definitions",
   "index": 24,
   "start": 369.21,
   "dur": 2.63,
   "speech": "实测平均二点一六。"
  },
