   "dur": 3.85,
   "speech": "每轮先算集成误差和各模型误差。"
  },
  {
   "scene": "definitions",
   "index": 28,
   "start": 383.09,
   "dur": 3.54,
   "speech": "误差比集成小的模型，权重加。"
