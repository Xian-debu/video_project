   "scene": "definitions",
   "index": 36,
   "start": 431.17,
   "dur": 3.42,
   "speech": "均值填充，填进去的是常数。"
  },
  {
   "scene": "definitions",
   "index": 37,
   "start": 435.14,
   "dur": 2.65,
   "speech": "常数和观测无关。"
