   "speech": "方差只剩下观测部分。"
  },
  {
   "scene": "definitions",
   "index": 39,
   "start": 441.74,
   "dur": 2.75,
   "speech": "观测比例是一减 p。"
  },
  {
   "scene": "definitions",
   "index": 40,
   "start": 445.04,
   "dur": 4.29,
   "speech": "所以方差等于一减 p，乘以原方差。"
  },
