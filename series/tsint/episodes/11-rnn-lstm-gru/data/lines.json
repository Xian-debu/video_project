   "scene": "boundary",
   "index": 11,
   "start": 995.38,
   "dur": 6.16,
   "speech": "两百五十个点的抽样带，是二除以根号二百五十，零点一二六。"
  },
  {
   "scene": "boundary",
   "index": 12,
   "start": 1002.08,
   "dur": 5.05,
   "speech": "也就是说，真实日收益几乎没有可被记忆的线性结构。"
  },
  {
   "scene": "boundary",
   "index": 13,
   "start": 1007.69,
   "dur": 2.85,
   "speech": "这不是说循环网络没用。"
  },
  {
   "scene": "boundary",
   "index": 14,
   "start": 1011.08,
   "dur": 5.41,
   "speech": "它说的是：在这一类数据上，记忆本身可能没有东西可记。"
  },
  {
   "scene": "boundary",
   "index": 15,
   "start": 1017.05,
   "dur": 3.45,
   "speech": "边界要说三条，一条一条来。"
  },
  {
   "scene": "boundary",
   "index": 16,
   "start": 1021.04,
   "dur": 2.73,
   "speech": "第一条，是预算问题。"
  },
  {
   "scene": "boundary",
   "index": 17,
   "start": 1024.32,
   "dur": 5.39,
   "speech": "一百二十八条训练样本、四十轮上限，是刻意的小预算。"
  },
  {
   "scene": "boundary",
   "index": 18,
   "start": 1030.26,
   "dur": 4.91,
   "speech": "书里没有训练配方，我们只能选一套，并且说清楚。"
  },
  {
   "scene": "boundary",
   "index": 19,
   "start": 1035.72,
   "dur": 4.72,
   "speech": "换成一千条样本、几百轮，判决表可能会变。"
  },
  {
   "scene": "boundary",
   "index": 20,
   "start": 1040.99,
   "dur": 2.34,
   "speech": "第二条，是任务。"
  },
  {
   "scene": "boundary",
   "index": 21,
   "start": 1043.88,
   "dur": 4.6,
   "speech": "延迟复制是纯记忆任务，没有任何结构可利用。"
  },
  {
   "scene": "boundary",
   "index": 22,
   "start": 1049.03,
   "dur": 5.34,
   "speech": "真实序列有季节、有趋势、有跳跃，比它容易也复杂。"
  },
  {
   "scene": "boundary",
   "index": 23,
   "start": 1054.92,
   "dur": 2.51,
   "speech": "第三条，是指标。"
  },
  {
   "scene": "boundary",
   "index": 24,
   "start": 1057.98,
   "dur": 3.78,
   "speech": "命中率只说明符号有没有被记住。"
  },
  {
   "scene": "boundary",
   "index": 25,
   "start": 1062.31,
   "dur": 4.67,
   "speech": "它不说明幅度、不说明时序、不说明预测能力。"
  },
  {
   "scene": "boundary",
   "index": 26,
   "start": 1067.53,
   "dur": 4.21,
   "speech": "所以这一集不能说 LSTM 更好。"
  },
  {
   "scene": "boundary",
   "index": 27,
   "start": 1072.3,
   "dur": 6.21,
   "speech": "只能说：同样的预算下，加法路径在长延迟上留住了更多信号。"
  },
  {
   "scene": "boundary",
   "index": 28,
   "start": 1079.05,
   "dur": 3.52,
   "speech": "这是结构的优势，不是训练的保证。"
  },
  {
   "scene": "boundary",
   "index": 29,
   "start": 1083.12,
   "dur": 4.38,
   "speech": "要它变成保证，得靠数据量和训练配方。"
  },
  {
   "scene": "boundary",
   "index": 30,
   "start": 1088.05,
   "dur": 3.23,
   "speech": "这恰恰是书里没写的那部分。"
  },
  {
   "scene": "outro",
   "index": 0,
   "start": 1094.68,
   "dur": 2.61,
   "speech": "四个数字，收个尾。"
  },
  {
   "scene": "outro",
   "index": 1,
   "start": 1097.84,
   "dur": 4.26,
   "speech": "一点九乘十的负六，是零点五乘十九次。"
  },
  {
   "scene": "outro",
   "index": 2,
   "start": 1102.65,
   "dur": 4.09,
   "speech": "零点九八，是零点九九九乘二十次。"
  },
  {
   "scene": "outro",
   "index": 3,
   "start": 1107.29,
   "dur": 3.06,
   "speech": "五十一万倍，是两者之比。"
  },
  {
   "scene": "outro",
   "index": 4,
   "start": 1110.9,
   "dur": 5.53,
   "speech": "二百六十五、一千零二十一、七百六十九，是三者参数量。"
  },
  {
   "scene": "outro",
   "index": 5,
   "start": 1116.99,
   "dur": 4.93,
   "speech": "判决表补上一句：长延迟上，三者都远没学会。"
  },
  {
   "scene": "outro",
   "index": 6,
   "start": 1122.47,
   "dur": 3.35,
   "speech": "这一集真正想说的，是一句话。"
  },
  {
   "scene": "outro",
   "index": 7,
   "start": 1126.37,
   "dur": 5.2,
   "speech": "循环结构的差别，在梯度沿时间回传时走哪条路。"
  },
  {
   "scene": "outro",
   "index": 8,
   "start": 1132.12,
   "dur": 4.24,
   "speech": "乘法链会衰减，加法路径能保住信号。"
  },
  {
   "scene": "outro",
   "index": 9,
   "start": 1136.91,
   "dur": 3.35,
   "speech": "但保住信号，不等于学会记住。"
  },
  {
   "scene": "outro",
   "index": 10,
   "start": 1140.81,
   "dur": 3.83,
   "speech": "中间隔着数据、预算和初始化。"
  },
  {
   "scene": "outro",
   "index": 11,
   "start": 1145.19,
   "dur": 2.8,
   "speech": "这句话对工程更有用。"
  },
  {
   "scene": "outro",
   "index": 12,
   "start": 1148.54,
   "dur": 3.35,
   "speech": "短延迟上，RNN 便宜又快。"
  },
  {
   "scene": "outro",
   "index": 13,
   "start": 1152.44,
   "dur": 4.48,
   "speech": "长延迟上，没有谁便宜，只有谁掉得慢一点。"
  },
  {
   "scene": "outro",
   "index": 14,
   "start": 1157.46,
   "dur": 2.44,
   "speech": "下一集换一个维度。"
  },
  {
   "scene": "outro",
   "index": 15,
   "start": 1160.45,
   "dur": 3.3,
   "speech": "前面十集，时间都是那条线。"
  },
  {
   "scene": "outro",
   "index": 16,
   "start": 1164.3,
   "dur": 3.73,
   "speech": "可是很多序列不只有时间，还有空间。"
  },
  {
   "scene": "outro",
   "index": 17,
   "start": 1168.59,
   "dur": 3.66,
   "speech": "卷积核能不能定义在图结构上？"
  },
  {
   "scene": "outro",
   "index": 18,
   "start": 1172.8,
   "dur": 4.26,
   "speech": "图卷积，把邻接矩阵变成卷积的骨架。"
  },
  {
   "scene": "outro",
   "index": 19,
   "start": 1177.61,
   "dur": 3.9,
   "speech": "下一集，卷积网络与图卷积网络。"
  },
  {
   "scene": "outro",
   "index": 20,
   "start": 1182.06,
   "dur": 2.8,
   "speech": "感谢观看，下一集见。"
  }
 ]
