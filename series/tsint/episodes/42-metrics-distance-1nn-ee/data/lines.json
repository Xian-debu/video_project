   "index": 0,
   "start": 183.23,
   "dur": 2.53,
   "speech": "先把距离定义清楚。"
  },
  {
   "scene": "definitions",
   "index": 1,
   "start": 185.94,
   "dur": 3.13,
   "speech": "两条等长序列，a 和 b。"
  },
  {
   "scene": "definitions",
   "index": 2,
   "start": 189.26,
   "dur": 4.6,
   "speech": "欧氏距离：逐点差，平方，求和，开方。"
  },
  {
   "scene": "definitions",
   "index": 3,
   "start": 194.04,
   "dur": 3.69,
   "speech": "公式写成根号下 Σ 平方差。"
  },
  {
   "scene": "definitions",
   "index": 4,
   "start": 197.9,
   "dur": 3.33,
   "speech": "它假设第 i 点只跟第 i 点比。"
  },
  {
   "scene": "definitions",
   "index": 5,
   "start": 201.41,
   "dur": 3.49,
   "speech": "时间轴错一格，误差就锁死。"
  },
  {
   "scene": "definitions",
   "index": 6,
   "start": 205.08,
   "dur": 2.97,
   "speech": "DTW 放开这个假设。"
  },
  {
   "scene": "definitions",
   "index": 7,
   "start": 208.23,
   "dur": 3.71,
   "speech": "允许 a 的第 i 点对上 b 的第 j 点。"
  },
  {
   "scene": "definitions",
   "index": 8,
   "start": 212.12,
   "dur": 2.8,
   "speech": "代价矩阵 D 逐格填。"
  },
  {
   "scene": "definitions",
   "index": 9,
   "start": 215.1,
   "dur": 2.61,
   "speech": "第一行第一列先累加。"
  },
  {
   "scene": "definitions",
   "index": 10,
   "start": 217.88,
   "dur": 4.02,
   "speech": "其余每格：局部平方差加三选一。"
  },
  {
   "scene": "definitions",
   "index": 11,
   "start": 222.08,
   "dur": 3.49,
   "speech": "三选一是左边、上边、左上。"
  },
  {
   "scene": "definitions",
   "index": 12,
   "start": 225.76,
   "dur": 3.78,
   "speech": "写出来就是 D 等于 d 加 min。"
  },
  {
   "scene": "definitions",
   "index": 13,
   "start": 229.72,
   "dur": 3.33,
   "speech": "这条递推是 DTW 的全部。"
  },
  {
   "scene": "definitions",
   "index": 14,
   "start": 233.23,
   "dur": 3.57,
   "speech": "终点取右下角，除以 n 加 m。"
  },
  {
   "scene": "definitions",
   "index": 15,
   "start": 236.97,
   "dur": 2.77,
   "speech": "再开方，距离才可比。"
  },
  {
   "scene": "definitions",
   "index": 16,
   "start": 239.93,
   "dur": 3.59,
   "speech": "不除，长序列会被系统性惩罚。"
  },
  {
   "scene": "definitions",
   "index": 17,
   "start": 243.7,
   "dur": 2.53,
   "speech": "带宽是第二个约束。"
  },
