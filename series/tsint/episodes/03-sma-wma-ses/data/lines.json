   "dur": 2.73,
   "speech": "先把三条公式摆出来。"
  },
  {
   "scene": "definitions",
   "index": 1,
   "start": 386.73,
   "dur": 3.37,
   "speech": "式二点一三，简单移动平均。"
  },
  {
   "scene": "definitions",
   "index": 2,
   "start": 390.65,
   "dur": 4.29,
   "speech": "s_t 等于最近 N 个 x 的平均。"
  },
  {
   "scene": "definitions",
   "index": 3,
   "start": 395.49,
   "dur": 4.05,
   "speech": "窗口里的每个点，权重都是 N 分之一。"
  },
  {
   "scene": "definitions",
   "index": 4,
   "start": 400.08,
   "dur": 3.09,
   "speech": "窗口向右滑，一步一个点。"
  },
  {
   "scene": "definitions",
   "index": 5,
   "start": 403.72,
   "dur": 4.45,
   "speech": "输出比输入短 N 减一行，这是右端对齐。"
  },
  {
   "scene": "definitions",
   "index": 6,
   "start": 408.72,
   "dur": 3.33,
   "speech": "式二点一四，加权移动平均。"
  },
  {
